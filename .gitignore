# dependencies
node_modules/

# mutation testing (Stryker) artifacts
# **root 固定にする** = Stryker の出力先は repo root の `reports/` だけ
# (`stryker.conf.json` の既定)。 固定しないと `apps/playground-spa/tests/reports/` の
# 手書き review report まで対象に入り、宣言と実態が食い違う
/reports/
.stryker-tmp/

# build artifacts
dist/
**/dist/
dist-types/
**/dist-types/
.astro/
**/.astro/
*.tsbuildinfo

# search index (regenerated by playground build)
.pagefind/
**/.pagefind/

# test
coverage/
test-results/
playwright-report/
**/test-results/
**/playwright-report/

# log
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# editor
.idea/
.vscode/

# env
.env
.env.local
.env.*.local

# scratchpad / marker / delegate (claude-config 経路)
.context/

# misc
*.swp
*.swo

# ad-hoc screenshot / capture scripts
.shot-*.mjs
.ucap.mjs
**/.shot-*.mjs
**/.ucap.mjs

# tsc build 副産物 (.cdl.ts source と競合)
apps/playground/src/topics/**/*.cdl.d.ts
