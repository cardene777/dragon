{
  // 検査 code を型検査する時だけ使う設定 (#1413)。
  //
  // 親 (`tsconfig.json`) は `dist-types` へ型定義を出すための設定で、`rootDir` を `src` に
  // 縛る。 検査 code は `test/` にあり、さらに `apps/playground-spa` と `test-support` を
  // 読むため、その縛りのままだと読む file すべてが「rootDir の外」 になる。
  //
  // **`rootDir` は出力の配置を決める設定** で、`noEmit` では意味を持たない。
  // repo の根に置いて縛りを外す (消すと親の `src` を継承して同じことが起きる)。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    // `@/` を `vitest.config.ts` の alias と同じ場所に向ける (#1416)。
    //
    // 検査 code はカタログの道具を `@/lib/...` で引く。 vitest は alias を持つので実行は
    // 通るが、型検査側に無いと **その import から先が丸ごと `any` に落ちる**
    // (実測 = `catalog-scope` を引く 3 file が同じ形で落ちていた)。
    //
    // 揃えないと「実行は通るのに型検査だけ落ちる」 状態が残り、検査 code を型で守れない。
    "baseUrl": "../..",
    "paths": {
      "@/*": ["apps/playground-spa/src/*"]
    },
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "tsup.config.ts"]
}
