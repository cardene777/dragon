{
  "name": "@cardenelabs/dragon",
  "version": "0.34.0",
  "description": "Dragon — 動く図を、人は行ごとの記法で、AI は JSON で書く。作り直しの最中で、まだ何も公開しない。",
  "license": "MIT",
  "author": "cardene777",
  "homepage": "https://github.com/cardene777/dragon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/dragon.git",
    "directory": "packages/dragon"
  },
  "bugs": {
    "url": "https://github.com/cardene777/dragon/issues"
  },
  "keywords": [
    "dragon",
    "diagram",
    "animation",
    "text-dsl",
    "mermaid-alternative",
    "svg-animation"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "cd ../.. && vitest run packages/dragon",
    "test:watch": "cd ../.. && vitest packages/dragon",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  }
}
