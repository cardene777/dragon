{
  "name": "@cardenelabs/dragon",
  "version": "0.34.0",
  "description": "Dragon — 動く図を、人は行ごとの記法で、AI は JSON で書く。作り直しの最中で、まだ何も公開しない。",
  "license": "MIT",
  "author": "cardene777",
  "homepage": "https://github.com/cardene777/dragon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/dragon.git",
    "directory": "packages/dragon"
  },
  "bugs": {
    "url": "https://github.com/cardene777/dragon/issues"
  },
  "keywords": [
    "dragon",
    "diagram",
    "animation",
    "text-dsl",
    "mermaid-alternative",
    "svg-animation"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dragon": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fonts": {
      "import": "./dist/fonts.js",
      "require": "./dist/fonts.cjs"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/fonts.js",
    "./dist/fonts.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "cd ../.. && vitest run packages/dragon",
    "test:watch": "cd ../.. && vitest packages/dragon",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "playwright-core": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.3",
    "playwright-core": "1.61.1",
    "react": "^19.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "ajv": "^8.18.0",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.62.0",
    "subset-font": "^2.9.0"
  }
}
