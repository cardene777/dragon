{
  "name": "@cardenelabs/dragon",
  "version": "0.74.0",
  "description": "Animated diagrams that people and AI write in a plain notation. Plays on a page and exports MP4, GIF, HTML, and PNG.",
  "license": "MIT",
  "author": "cardene777",
  "homepage": "https://github.com/cardene777/dragon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/dragon.git",
    "directory": "packages/dragon"
  },
  "bugs": {
    "url": "https://github.com/cardene777/dragon/issues"
  },
  "keywords": [
    "dragon",
    "diagram",
    "animation",
    "text-dsl",
    "mermaid-alternative",
    "svg-animation"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dragon": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./light": {
      "import": {
        "types": "./dist/light/index.d.ts",
        "default": "./dist/light/index.js"
      },
      "require": {
        "types": "./dist/light/index.d.cts",
        "default": "./dist/light/index.cjs"
      }
    },
    "./fonts": {
      "import": "./dist/fonts.js",
      "require": "./dist/fonts.cjs"
    },
    "./export": {
      "import": {
        "types": "./dist/export.d.ts",
        "default": "./dist/export.js"
      },
      "require": {
        "types": "./dist/export.d.cts",
        "default": "./dist/export.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./capture": {
      "import": {
        "types": "./dist/capture.d.ts",
        "default": "./dist/capture.js"
      },
      "require": {
        "types": "./dist/capture.d.cts",
        "default": "./dist/capture.cjs"
      }
    },
    "./frame": {
      "import": {
        "types": "./dist/frame.d.ts",
        "default": "./dist/frame.js"
      },
      "require": {
        "types": "./dist/frame.d.cts",
        "default": "./dist/frame.cjs"
      }
    },
    "./header": {
      "import": {
        "types": "./dist/header.d.ts",
        "default": "./dist/header.js"
      },
      "require": {
        "types": "./dist/header.d.cts",
        "default": "./dist/header.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/blocks/*/gallery",
    "blocks",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/fonts.js",
    "./dist/fonts.cjs",
    "./src/kinds/all.ts",
    "./src/blocks/icon/sets-all.ts",
    "./src/render/pen-all.ts",
    "./src/render/svg.ts"
  ],
  "scripts": {
    "build": "node scripts/build-blocks.mjs && node scripts/build-tabler.mjs && node --import ./scripts/ts-resolve.mjs scripts/build-validator.mjs && tsup && tsup --config tsup.frame.config.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "cd ../.. && vitest run packages/dragon",
    "test:watch": "cd ../.. && vitest packages/dragon",
    "lint": "tsc --noEmit",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:pack"
  },
  "peerDependencies": {
    "playwright-core": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tabler/icons": "3.49.0",
    "ajv": "^8.18.0",
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.3",
    "playwright-core": "1.61.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.62.0",
    "subset-font": "^2.9.0"
  }
}
