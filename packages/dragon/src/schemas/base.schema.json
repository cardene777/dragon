{
  "title": "dragon の図の原本 (版2)",
  "description": "図の宣言を blocks のブロックの名前ごとの欄に置き、段ごとに起きることを steps に置く。座標は持たない。ブロックの欄の形はブロックの置き場が持ち、build の時に scripts/build-validator.mjs がこの骨組みに束ねて diagram.schema.json を書き出す。箱は枝分かれの図と時間軸の図と木の図だけが持たなくてよい。列の図の箱は列になる。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "title",
    "blocks",
    "steps"
  ],
  "properties": {
    "version": {
      "description": "形式の版",
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "description": "図の種類",
      "enum": [
        "sequence",
        "architecture",
        "state",
        "git",
        "time",
        "tree",
        "lineup"
      ]
    },
    "title": {
      "$ref": "#/definitions/text"
    },
    "view": {
      "description": "見せ方。書かなければ字の大きさで選ぶ。fixed は全体を止めて中だけ動かし、follow は寄って動かし全体図で今どこかを示す",
      "enum": [
        "fixed",
        "follow"
      ]
    },
    "blocks": {
      "description": "図の宣言。ブロックの名前ごとの欄に、そのブロックの宣言を置く",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/path"
          }
        },
        "period": {
          "$ref": "#/definitions/period"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "lineup"
          }
        }
      },
      "else": {
        "properties": {
          "blocks": {
            "properties": {
              "box": {
                "items": {
                  "properties": {
                    "order": {
                      "$ref": "#/definitions/absent"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "if": {
    "required": [
      "kind"
    ],
    "properties": {
      "kind": {
        "const": "sequence"
      }
    }
  },
  "then": {
    "properties": {
      "blocks": {
        "required": [
          "box"
        ],
        "properties": {
          "box": {
            "minItems": 1
          },
          "strip": {
            "$ref": "#/definitions/plainStrip"
          },
          "path": {
            "$ref": "#/definitions/absent"
          },
          "branch": {
            "$ref": "#/definitions/absent"
          },
          "scale": {
            "$ref": "#/definitions/absent"
          },
          "period": {
            "$ref": "#/definitions/absent"
          },
          "row": {
            "$ref": "#/definitions/absent"
          },
          "point": {
            "$ref": "#/definitions/absent"
          },
          "zoom": {
            "$ref": "#/definitions/absent"
          },
          "item": {
            "$ref": "#/definitions/absent"
          },
          "role": {
            "$ref": "#/definitions/absent"
          }
        }
      },
      "steps": {
        "$ref": "#/definitions/plainSteps"
      }
    }
  },
  "else": {
    "if": {
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "state"
        }
      }
    },
    "then": {
      "properties": {
        "blocks": {
          "required": [
            "box"
          ],
          "properties": {
            "box": {
              "minItems": 1,
              "items": {
                "properties": {
                  "id": {
                    "description": "始まりと終わりの印の名前は箱の名札に使えない",
                    "not": {
                      "enum": [
                        "start",
                        "finish"
                      ]
                    }
                  }
                }
              }
            },
            "strip": {
              "$ref": "#/definitions/plainStrip"
            },
            "branch": {
              "$ref": "#/definitions/absent"
            },
            "scale": {
              "$ref": "#/definitions/absent"
            },
            "period": {
              "$ref": "#/definitions/absent"
            },
            "row": {
              "$ref": "#/definitions/absent"
            },
            "point": {
              "$ref": "#/definitions/absent"
            },
            "zoom": {
              "$ref": "#/definitions/absent"
            },
            "item": {
              "$ref": "#/definitions/absent"
            },
            "role": {
              "$ref": "#/definitions/absent"
            }
          }
        },
        "steps": {
          "$ref": "#/definitions/plainSteps"
        }
      }
    },
    "else": {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "git"
          }
        }
      },
      "then": {
        "properties": {
          "blocks": {
            "required": [
              "branch"
            ],
            "properties": {
              "strip": {
                "$ref": "#/definitions/plainStrip"
              },
              "path": {
                "$ref": "#/definitions/absent"
              },
              "group": {
                "$ref": "#/definitions/absent"
              },
              "scale": {
                "$ref": "#/definitions/absent"
              },
              "period": {
                "$ref": "#/definitions/absent"
              },
              "row": {
                "$ref": "#/definitions/absent"
              },
              "point": {
                "$ref": "#/definitions/absent"
              },
              "zoom": {
                "$ref": "#/definitions/absent"
              },
              "item": {
                "$ref": "#/definitions/absent"
              },
              "role": {
                "$ref": "#/definitions/absent"
              }
            }
          },
          "steps": {
            "$ref": "#/definitions/gitSteps"
          }
        }
      },
      "else": {
        "if": {
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "time"
            }
          }
        },
        "then": {
          "properties": {
            "blocks": {
              "required": [
                "scale",
                "row"
              ],
              "properties": {
                "path": {
                  "$ref": "#/definitions/absent"
                },
                "branch": {
                  "$ref": "#/definitions/absent"
                },
                "group": {
                  "$ref": "#/definitions/absent"
                },
                "item": {
                  "$ref": "#/definitions/absent"
                },
                "role": {
                  "$ref": "#/definitions/absent"
                }
              }
            },
            "steps": {
              "$ref": "#/definitions/timeSteps"
            }
          }
        },
        "else": {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "tree"
              }
            }
          },
          "then": {
            "properties": {
              "blocks": {
                "properties": {
                  "strip": {
                    "$ref": "#/definitions/plainStrip"
                  },
                  "path": {
                    "$ref": "#/definitions/absent"
                  },
                  "branch": {
                    "$ref": "#/definitions/absent"
                  },
                  "scale": {
                    "$ref": "#/definitions/absent"
                  },
                  "period": {
                    "$ref": "#/definitions/absent"
                  },
                  "row": {
                    "$ref": "#/definitions/absent"
                  },
                  "point": {
                    "$ref": "#/definitions/absent"
                  },
                  "zoom": {
                    "$ref": "#/definitions/absent"
                  },
                  "group": {
                    "$ref": "#/definitions/absent"
                  },
                  "item": {
                    "$ref": "#/definitions/absent"
                  },
                  "role": {
                    "$ref": "#/definitions/absent"
                  }
                }
              },
              "steps": {
                "$ref": "#/definitions/treeSteps"
              }
            }
          },
          "else": {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "lineup"
                }
              }
            },
            "then": {
              "properties": {
                "blocks": {
                  "required": [
                    "box",
                    "item"
                  ],
                  "properties": {
                    "box": {
                      "minItems": 1,
                      "items": {
                        "properties": {
                          "icon": {
                            "$ref": "#/definitions/absent"
                          },
                          "link": {
                            "$ref": "#/definitions/absent"
                          },
                          "region": {
                            "$ref": "#/definitions/absent"
                          }
                        }
                      }
                    },
                    "strip": {
                      "$ref": "#/definitions/plainStrip"
                    },
                    "path": {
                      "$ref": "#/definitions/absent"
                    },
                    "branch": {
                      "$ref": "#/definitions/absent"
                    },
                    "scale": {
                      "$ref": "#/definitions/absent"
                    },
                    "period": {
                      "$ref": "#/definitions/absent"
                    },
                    "row": {
                      "$ref": "#/definitions/absent"
                    },
                    "point": {
                      "$ref": "#/definitions/absent"
                    },
                    "zoom": {
                      "$ref": "#/definitions/absent"
                    },
                    "group": {
                      "$ref": "#/definitions/absent"
                    }
                  }
                },
                "steps": {
                  "$ref": "#/definitions/lineupSteps"
                }
              }
            },
            "else": {
              "properties": {
                "blocks": {
                  "required": [
                    "box"
                  ],
                  "properties": {
                    "box": {
                      "minItems": 1
                    },
                    "strip": {
                      "$ref": "#/definitions/plainStrip"
                    },
                    "path": {
                      "$ref": "#/definitions/absent"
                    },
                    "branch": {
                      "$ref": "#/definitions/absent"
                    },
                    "scale": {
                      "$ref": "#/definitions/absent"
                    },
                    "period": {
                      "$ref": "#/definitions/absent"
                    },
                    "row": {
                      "$ref": "#/definitions/absent"
                    },
                    "point": {
                      "$ref": "#/definitions/absent"
                    },
                    "zoom": {
                      "$ref": "#/definitions/absent"
                    },
                    "item": {
                      "$ref": "#/definitions/absent"
                    },
                    "role": {
                      "$ref": "#/definitions/absent"
                    }
                  }
                },
                "steps": {
                  "$ref": "#/definitions/plainSteps"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "absent": {
      "description": "この図の種類では書けない欄",
      "not": {}
    },
    "plainSteps": {
      "description": "枝分かれの図でも時間軸の図でも木の図でも列の図でもない図の段。枝分かれの図だけの出来事 (commit と branch) と、時間軸の図だけの出来事 (now と mark と span) と欄 (at と into と color) と、木の図だけの出来事 (leaf と node) と、列の図だけの出来事 (line と seal と open と pick と stamp と role) を書けない",
      "items": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "$ref": "#/definitions/timeEvent"
              },
              "allOf": [
                {
                  "not": {
                    "$ref": "#/definitions/treeEvent"
                  }
                },
                {
                  "$ref": "#/definitions/notLineupEvent"
                }
              ],
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "commit",
                      "branch"
                    ]
                  }
                },
                "at": {
                  "$ref": "#/definitions/absent"
                },
                "into": {
                  "$ref": "#/definitions/absent"
                },
                "color": {
                  "$ref": "#/definitions/absent"
                }
              }
            }
          }
        }
      }
    },
    "gitSteps": {
      "description": "枝分かれの図の段。時間軸の図だけの出来事 (now と mark と span) と欄 (at と into と color) と、木の図だけの出来事 (leaf と node) と、列の図だけの出来事 (line と seal と open と pick と stamp と role) を書けない",
      "items": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "$ref": "#/definitions/timeEvent"
              },
              "allOf": [
                {
                  "not": {
                    "$ref": "#/definitions/treeEvent"
                  }
                },
                {
                  "$ref": "#/definitions/notLineupEvent"
                }
              ],
              "properties": {
                "at": {
                  "$ref": "#/definitions/absent"
                },
                "into": {
                  "$ref": "#/definitions/absent"
                },
                "color": {
                  "$ref": "#/definitions/absent"
                }
              }
            }
          }
        }
      }
    },
    "timeSteps": {
      "description": "時間軸の図の段。枝分かれの図だけの出来事 (commit と branch) と、木の図だけの出来事 (leaf と node) と、列の図だけの出来事 (line と seal と open と pick と stamp と role) を書けない",
      "items": {
        "properties": {
          "events": {
            "items": {
              "allOf": [
                {
                  "not": {
                    "$ref": "#/definitions/treeEvent"
                  }
                },
                {
                  "$ref": "#/definitions/notLineupEvent"
                }
              ],
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "commit",
                      "branch"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "treeSteps": {
      "description": "木の図の段。枝分かれの図だけの出来事 (commit と branch) と、時間軸の図だけの出来事 (now と mark と span) と欄 (at と into と color) と、列の図だけの出来事 (line と seal と open と pick と stamp と role) を書けない",
      "items": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "$ref": "#/definitions/timeEvent"
              },
              "allOf": [
                {
                  "$ref": "#/definitions/notLineupEvent"
                }
              ],
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "commit",
                      "branch"
                    ]
                  }
                },
                "at": {
                  "$ref": "#/definitions/absent"
                },
                "into": {
                  "$ref": "#/definitions/absent"
                },
                "color": {
                  "$ref": "#/definitions/absent"
                }
              }
            }
          }
        }
      }
    },
    "lineupSteps": {
      "description": "列の図の段。線と処理と、枝分かれの図だけの出来事 (commit と branch) と、時間軸の図だけの出来事 (now と mark と span) と欄 (color) と、木の図だけの出来事 (leaf と node) を書けない",
      "items": {
        "properties": {
          "events": {
            "items": {
              "not": {
                "$ref": "#/definitions/timeEvent"
              },
              "allOf": [
                {
                  "not": {
                    "$ref": "#/definitions/treeEvent"
                  }
                },
                {
                  "$ref": "#/definitions/notWiredEvent"
                }
              ],
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "commit",
                      "branch"
                    ]
                  }
                },
                "color": {
                  "$ref": "#/definitions/absent"
                }
              }
            }
          }
        }
      }
    },
    "treeEvent": {
      "description": "木の図だけが書ける出来事",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "leaf",
            "node"
          ]
        }
      }
    },
    "notLineupEvent": {
      "description": "列の図だけが書ける出来事を書けない",
      "not": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "line",
              "seal",
              "open",
              "pick",
              "stamp",
              "role"
            ]
          }
        }
      }
    },
    "notWiredEvent": {
      "description": "箱と線の図の出来事を書けない",
      "not": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "edge",
              "action"
            ]
          }
        }
      }
    },
    "timeEvent": {
      "description": "時間軸の図だけが書ける出来事",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "now",
            "mark",
            "span"
          ]
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[^\\s\\[\\]「」=:]+$"
    },
    "event": {
      "description": "段の中で起きること。起きる順に並べる",
      "type": "object",
      "required": [
        "type"
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": []
    },
    "hash": {
      "description": "commit と木の箱の hash。16 進の字で 4 から 40 字",
      "type": "string",
      "pattern": "^[0-9a-f]{4,40}$"
    },
    "unit": {
      "description": "目盛りの位置。0 から数える",
      "type": "integer",
      "minimum": 0
    }
  }
}
