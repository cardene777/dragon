{
  "version": 2,
  "kind": "pipe",
  "title": "Turn USDC into DAI by way of WETH",
  "blocks": {
    "box": [
      {
        "id": "alice",
        "name": "Alice"
      },
      {
        "id": "router",
        "name": "SwapRouter"
      },
      {
        "id": "usdc",
        "name": "USDC"
      },
      {
        "id": "pool1",
        "name": "Pool1"
      },
      {
        "id": "weth",
        "name": "WETH"
      },
      {
        "id": "pool2",
        "name": "Pool2"
      },
      {
        "id": "dai",
        "name": "DAI"
      }
    ],
    "hold": [
      {
        "box": "alice",
        "amount": "1000",
        "token": "USDC"
      },
      {
        "box": "alice",
        "amount": "0",
        "token": "DAI"
      },
      {
        "box": "pool1",
        "amount": "2000",
        "token": "USDC"
      },
      {
        "box": "pool1",
        "amount": "10",
        "token": "WETH"
      },
      {
        "box": "pool2",
        "amount": "5",
        "token": "WETH"
      },
      {
        "box": "pool2",
        "amount": "20000",
        "token": "DAI"
      }
    ]
  },
  "steps": [
    {
      "title": "Alice asks the router to swap",
      "body": "Alice asks the router to turn 100 USDC into DAI. She wants at least 150 DAI.",
      "events": [
        {
          "type": "call",
          "from": "alice",
          "to": "router",
          "label": "swap 100 USDC into DAI"
        }
      ]
    },
    {
      "title": "The router checks the path",
      "body": "The router checks how many tokens are on the path. There are three: USDC, WETH, and DAI.",
      "events": [
        {
          "type": "check",
          "box": "router",
          "left": "3",
          "op": "==",
          "right": "3"
        }
      ]
    },
    {
      "title": "100 USDC moves from Alice to pool 1",
      "body": "The router asks USDC to move Alice's 100 USDC to pool 1.",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "usdc",
          "label": "move 100 USDC"
        },
        {
          "type": "move",
          "box": "usdc",
          "amount": "100",
          "from": "alice",
          "to": "pool1"
        },
        {
          "type": "emit",
          "box": "usdc",
          "name": "Transfer",
          "args": [
            "alice",
            "pool1",
            "100"
          ]
        },
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        }
      ]
    },
    {
      "title": "The router asks pool 1 to swap",
      "body": "The router asks pool 1 to turn the USDC into WETH and send it to pool 2.",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "pool1",
          "label": "swap 100 USDC"
        }
      ]
    },
    {
      "title": "Pool 1 prices the WETH",
      "body": "At its current rate, pool 1 works out how much WETH 100 USDC is worth.",
      "events": [
        {
          "type": "calc",
          "box": "pool1",
          "in": "100 USDC",
          "out": "0.05 WETH"
        }
      ]
    },
    {
      "title": "0.05 WETH moves from pool 1 to pool 2",
      "body": "Pool 1 asks WETH to send 0.05 WETH to pool 2.",
      "events": [
        {
          "type": "call",
          "from": "pool1",
          "to": "weth",
          "label": "send 0.05 WETH"
        },
        {
          "type": "move",
          "box": "weth",
          "amount": "0.05",
          "from": "pool1",
          "to": "pool2"
        },
        {
          "type": "emit",
          "box": "weth",
          "name": "Transfer",
          "args": [
            "pool1",
            "pool2",
            "0.05"
          ]
        },
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        }
      ]
    },
    {
      "title": "Pool 1 reports what it paid",
      "body": "Pool 1 tells the router it paid 0.05 WETH.",
      "events": [
        {
          "type": "return",
          "box": "pool1",
          "value": "0.05 WETH"
        }
      ]
    },
    {
      "title": "The router asks pool 2 to swap",
      "body": "The router asks pool 2 to turn the WETH that arrived into DAI and send it to Alice.",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "pool2",
          "label": "swap 0.05 WETH"
        }
      ]
    },
    {
      "title": "Pool 2 prices the DAI",
      "body": "At its current rate, pool 2 works out how much DAI 0.05 WETH is worth.",
      "events": [
        {
          "type": "calc",
          "box": "pool2",
          "in": "0.05 WETH",
          "out": "160 DAI"
        }
      ]
    },
    {
      "title": "160 DAI meets the minimum",
      "body": "Pool 2 checks that the 160 DAI it pays is at least the 150 DAI Alice asked for.",
      "events": [
        {
          "type": "check",
          "box": "pool2",
          "left": "160 DAI",
          "op": ">=",
          "right": "150 DAI"
        }
      ]
    },
    {
      "title": "160 DAI moves from pool 2 to Alice",
      "body": "Pool 2 asks DAI to send 160 DAI to Alice.",
      "events": [
        {
          "type": "call",
          "from": "pool2",
          "to": "dai",
          "label": "send 160 DAI"
        },
        {
          "type": "move",
          "box": "dai",
          "amount": "160",
          "from": "pool2",
          "to": "alice"
        },
        {
          "type": "emit",
          "box": "dai",
          "name": "Transfer",
          "args": [
            "pool2",
            "alice",
            "160"
          ]
        },
        {
          "type": "return",
          "box": "dai",
          "value": "true"
        }
      ]
    },
    {
      "title": "Pool 2 reports what it paid",
      "body": "Pool 2 tells the router it paid 160 DAI.",
      "events": [
        {
          "type": "return",
          "box": "pool2",
          "value": "160 DAI"
        }
      ]
    },
    {
      "title": "The swap ends",
      "body": "The outermost call returns, and every change from both swaps becomes final.",
      "gist": "The changes of both swaps become final when the outermost call returns",
      "events": [
        {
          "type": "return",
          "box": "router",
          "value": "160 DAI"
        }
      ]
    }
  ]
}
