{
  "version": 2,
  "kind": "pipe",
  "title": "100 USDCをWETHに替えてBobへ送る",
  "blocks": {
    "box": [
      {
        "id": "alice",
        "name": "Alice"
      },
      {
        "id": "router",
        "name": "SwapRouter"
      },
      {
        "id": "usdc",
        "name": "USDC"
      },
      {
        "id": "pool",
        "name": "LiquidityPool"
      },
      {
        "id": "weth",
        "name": "WETH"
      },
      {
        "id": "bob",
        "name": "Bob"
      }
    ],
    "hold": [
      {
        "box": "alice",
        "amount": "1000",
        "token": "USDC"
      },
      {
        "box": "pool",
        "amount": "2000",
        "token": "USDC"
      },
      {
        "box": "pool",
        "amount": "10",
        "token": "WETH"
      },
      {
        "box": "bob",
        "amount": "0",
        "token": "WETH"
      },
      {
        "box": "usdc",
        "name": "allowance[alice][router]",
        "value": "100"
      }
    ]
  },
  "steps": [
    {
      "title": "AliceがRouterに交換を頼む",
      "body": "AliceがRouterに、100 USDCをWETHに替えてBobへ送るよう頼む。受け取る量は最低0.04 WETHにする。",
      "events": [
        {
          "type": "call",
          "from": "alice",
          "to": "router",
          "label": "100 USDCを交換"
        }
      ]
    },
    {
      "title": "Routerが道筋を確かめる",
      "body": "Routerが、交換の道筋にあるトークンの数を確かめる。",
      "events": [
        {
          "type": "check",
          "box": "router",
          "left": "2",
          "op": "==",
          "right": "2"
        }
      ]
    },
    {
      "title": "RouterがUSDCに移させる",
      "body": "RouterがUSDCに、Aliceの100 USDCをPoolへ移させる。",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "usdc",
          "label": "100 USDCを移す"
        }
      ]
    },
    {
      "title": "USDCが許可額を確かめる",
      "body": "USDCが、AliceがRouterに許した額で足りるかを確かめる。",
      "events": [
        {
          "type": "check",
          "box": "usdc",
          "left": "100",
          "op": ">=",
          "right": "100"
        }
      ]
    },
    {
      "title": "100 USDCがAliceからPoolへ移る",
      "body": "USDCがAliceの残高を減らしてPoolに足し、使った分だけ許可額を減らす。",
      "events": [
        {
          "type": "move",
          "box": "usdc",
          "amount": "100",
          "from": "alice",
          "to": "pool"
        },
        {
          "type": "write",
          "box": "usdc",
          "name": "allowance[alice][router]",
          "value": "0"
        },
        {
          "type": "emit",
          "box": "usdc",
          "name": "Transfer",
          "args": [
            "alice",
            "pool",
            "100"
          ]
        }
      ]
    },
    {
      "title": "USDCが移し終えたと返す",
      "body": "USDCがRouterに、移し終えたと返す。変更はまだ暫定のまま。",
      "gist": "移した分はまだ暫定で、取引が終わるまで確定しない",
      "events": [
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        }
      ]
    },
    {
      "title": "RouterがPoolに交換を頼む",
      "body": "RouterがPoolに、受け取ったUSDCをWETHに替えてBobへ送るよう頼む。",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "pool",
          "label": "100 USDCを交換"
        }
      ]
    },
    {
      "title": "Poolが払うWETHを計算する",
      "body": "Poolが今の比率で、100 USDCがWETHでいくらになるかを計算する。",
      "events": [
        {
          "type": "calc",
          "box": "pool",
          "in": "100 USDC",
          "out": "0.05 WETH"
        }
      ]
    },
    {
      "title": "0.05 WETHはAliceの最低額を満たす",
      "body": "払う0.05 WETHが、Aliceの決めた最低0.04 WETH以上かを確かめる。",
      "events": [
        {
          "type": "check",
          "box": "pool",
          "left": "0.05 WETH",
          "op": ">=",
          "right": "0.04 WETH"
        }
      ]
    },
    {
      "title": "PoolがWETHに払わせる",
      "body": "PoolがWETHに、0.05 WETHをBobへ送らせる。",
      "events": [
        {
          "type": "call",
          "from": "pool",
          "to": "weth",
          "label": "0.05 WETHを送る"
        }
      ]
    },
    {
      "title": "0.05 WETHがPoolからBobへ移る",
      "body": "WETHがPoolの残高を減らしてBobに足す。",
      "events": [
        {
          "type": "move",
          "box": "weth",
          "amount": "0.05",
          "from": "pool",
          "to": "bob"
        },
        {
          "type": "emit",
          "box": "weth",
          "name": "Transfer",
          "args": [
            "pool",
            "bob",
            "0.05"
          ]
        }
      ]
    },
    {
      "title": "WETHが送り終えたと返す",
      "body": "WETHがPoolに、送り終えたと返す。",
      "events": [
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        }
      ]
    },
    {
      "title": "Poolが払った量を返す",
      "body": "PoolがRouterに、0.05 WETHを払ったと返す。内側の呼び出しが戻っても、変更は暫定のまま。",
      "gist": "内側の呼び出しが戻っても、変更は暫定のまま",
      "events": [
        {
          "type": "return",
          "box": "pool",
          "value": "0.05 WETH"
        }
      ]
    },
    {
      "title": "交換が終わる",
      "body": "一番外の呼び出しが戻り、ここで全ての変更が確定する。",
      "gist": "一番外の呼び出しが戻った時に、全ての変更が確定する",
      "events": [
        {
          "type": "return",
          "box": "router",
          "value": "0.05 WETH"
        }
      ]
    }
  ]
}
