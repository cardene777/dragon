  "steps": [
    {
      "title": "Alice asks the router to swap",
      "body": "Alice asks the router to turn 100 USDC into WETH and send it to Bob. She wants at least 0.049 WETH.",
      "events": [
        {
          "type": "call",
          "from": "alice",
          "to": "router",
          "label": "swap 100 USDC into WETH"
        }
      ]
    },
    {
      "title": "100 USDC moves from Alice to the aggregator",
      "body": "The router asks USDC to move Alice's 100 USDC to the aggregator.",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "usdc",
          "label": "move 100 USDC"
        },
        {
          "type": "move",
          "box": "usdc",
          "amount": "100",
          "from": "alice",
          "to": "agg"
        },
        {
          "type": "emit",
          "box": "usdc",
          "name": "Transfer",
          "args": [
            "alice",
            "agg",
            "100"
          ]
        },
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        }
      ]
    },
    {
      "title": "The router hands the swap to the aggregator",
      "body": "The router leaves the swap to the aggregator. The steps inside fold into one box that opens when pressed.",
      "gist": "The inner steps fold into one box, and the box opens when you press it",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "agg",
          "label": "swap 100 USDC into WETH",
          "fold": true
        }
      ]
    },
    {
      "title": "The aggregator reads the price and the split",
      "body": "The aggregator reads the price from Oracle and how to split across three pools from Lib.",
      "events": [
        {
          "type": "call",
          "from": "agg",
          "to": "oracle",
          "label": "price",
          "call": "static"
        },
        {
          "type": "return",
          "box": "oracle",
          "value": "3200"
        },
        {
          "type": "call",
          "from": "agg",
          "to": "lib",
          "label": "split",
          "call": "static"
        },
        {
          "type": "return",
          "box": "lib",
          "value": "40/35/25"
        }
      ]
    },
    {
      "title": "Pool 1 swaps 40 USDC",
      "body": "The aggregator sends 40 USDC to pool 1, and pool 1 pays back 0.02 WETH.",
      "events": [
        {
          "type": "call",
          "from": "agg",
          "to": "usdc",
          "label": "send 40 USDC"
        },
        {
          "type": "move",
          "box": "usdc",
          "amount": "40",
          "from": "agg",
          "to": "pool1"
        },
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        },
        {
          "type": "call",
          "from": "agg",
          "to": "pool1",
          "label": "swap 40 USDC"
        },
        {
          "type": "calc",
          "box": "pool1",
          "in": "40 USDC",
          "out": "0.02 WETH"
        },
        {
          "type": "call",
          "from": "pool1",
          "to": "weth",
          "label": "send 0.02 WETH"
        },
        {
          "type": "move",
          "box": "weth",
          "amount": "0.02",
          "from": "pool1",
          "to": "agg"
        },
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        },
        {
          "type": "return",
          "box": "pool1",
          "value": "0.02 WETH"
        }
      ]
    },
    {
      "title": "Pool 2 swaps 35 USDC",
      "body": "The aggregator sends 35 USDC to pool 2, and pool 2 pays back 0.0175 WETH.",
      "events": [
        {
          "type": "call",
          "from": "agg",
          "to": "usdc",
          "label": "send 35 USDC"
        },
        {
          "type": "move",
          "box": "usdc",
          "amount": "35",
          "from": "agg",
          "to": "pool2"
        },
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        },
        {
          "type": "call",
          "from": "agg",
          "to": "pool2",
          "label": "swap 35 USDC"
        },
        {
          "type": "calc",
          "box": "pool2",
          "in": "35 USDC",
          "out": "0.0175 WETH"
        },
        {
          "type": "call",
          "from": "pool2",
          "to": "weth",
          "label": "send 0.0175 WETH"
        },
        {
          "type": "move",
          "box": "weth",
          "amount": "0.0175",
          "from": "pool2",
          "to": "agg"
        },
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        },
        {
          "type": "return",
          "box": "pool2",
          "value": "0.0175 WETH"
        }
      ]
    },
    {
      "title": "Pool 3 swaps 25 USDC",
      "body": "The aggregator sends 25 USDC to pool 3, and pool 3 pays back 0.0125 WETH.",
      "events": [
        {
          "type": "call",
          "from": "agg",
          "to": "usdc",
          "label": "send 25 USDC"
        },
        {
          "type": "move",
          "box": "usdc",
          "amount": "25",
          "from": "agg",
          "to": "pool3"
        },
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        },
        {
          "type": "call",
          "from": "agg",
          "to": "pool3",
          "label": "swap 25 USDC"
        },
        {
          "type": "calc",
          "box": "pool3",
          "in": "25 USDC",
          "out": "0.0125 WETH"
        },
        {
          "type": "call",
          "from": "pool3",
          "to": "weth",
          "label": "send 0.0125 WETH"
        },
        {
          "type": "move",
          "box": "weth",
          "amount": "0.0125",
          "from": "pool3",
          "to": "agg"
        },
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        },
        {
          "type": "return",
          "box": "pool3",
          "value": "0.0125 WETH"
        }
      ]
    },
    {
      "title": "Pool 4 turns the fee into DAI for Fee",
      "body": "The aggregator sends 0.0005 WETH to pool 4, and pool 4 sends 1.6 DAI to Fee as the fee.",
      "events": [
        {
          "type": "call",
          "from": "agg",
          "to": "weth",
          "label": "send 0.0005 WETH"
        },
        {
          "type": "move",
          "box": "weth",
          "amount": "0.0005",
          "from": "agg",
          "to": "pool4"
        },
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        },
        {
          "type": "call",
          "from": "agg",
          "to": "pool4",
          "label": "swap the fee into DAI"
        },
        {
          "type": "calc",
          "box": "pool4",
          "in": "0.0005 WETH",
          "out": "1.6 DAI"
        },
        {
          "type": "call",
          "from": "pool4",
          "to": "dai",
          "label": "send 1.6 DAI to Fee"
        },
        {
          "type": "move",
          "box": "dai",
          "amount": "1.6",
          "from": "pool4",
          "to": "fee"
        },
        {
          "type": "return",
          "box": "dai",
          "value": "true"
        },
        {
          "type": "return",
          "box": "pool4",
          "value": "1.6 DAI"
        }
      ]
    },
    {
      "title": "The rest of the WETH goes to the router",
      "body": "The aggregator sends the remaining 0.0495 WETH to the router.",
      "events": [
        {
          "type": "call",
          "from": "agg",
          "to": "weth",
          "label": "send 0.0495 WETH"
        },
        {
          "type": "move",
          "box": "weth",
          "amount": "0.0495",
          "from": "agg",
          "to": "router"
        },
        {
          "type": "emit",
          "box": "weth",
          "name": "Transfer",
          "args": [
            "agg",
            "router",
            "0.0495"
          ]
        },
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        }
      ]
    },
    {
      "title": "The swapped amount is recorded",
      "body": "The aggregator asks the vault to record how much was swapped.",
      "events": [
        {
          "type": "call",
          "from": "agg",
          "to": "vault",
          "label": "record the amount"
        },
        {
          "type": "write",
          "box": "vault",
          "name": "volume",
          "value": "100"
        },
        {
          "type": "return",
          "box": "vault",
          "value": "true"
        }
      ]
    },
    {
      "title": "The aggregator returns",
      "body": "The aggregator tells the router it sent 0.0495 WETH.",
      "events": [
        {
          "type": "return",
          "box": "agg",
          "value": "0.0495 WETH"
        }
      ]
    },
    {
      "title": "0.0495 WETH meets the minimum",
      "body": "The router checks that the 0.0495 WETH it received is at least 0.049 WETH.",
      "events": [
        {
          "type": "check",
          "box": "router",
          "left": "0.0495 WETH",
          "op": ">=",
          "right": "0.049 WETH"
        }
      ]
    },
    {
      "title": "The router sends the WETH to Bob",
      "body": "The router asks WETH to send 0.0495 WETH to Bob.",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "weth",
          "label": "send 0.0495 WETH to Bob"
        },
        {
          "type": "move",
          "box": "weth",
          "amount": "0.0495",
          "from": "router",
          "to": "bob"
        },
        {
          "type": "emit",
          "box": "weth",
          "name": "Transfer",
          "args": [
            "router",
            "bob",
            "0.0495"
          ]
        },
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        }
      ]
    },
    {
      "title": "The swap ends",
      "body": "The outermost call returns, and every change across the 15 parties becomes final.",
      "gist": "Every change across the 15 parties becomes final when the outermost call returns",
      "events": [
        {
          "type": "return",
          "box": "router",
          "value": "0.0495 WETH"
        }
      ]
    }
  ]
}
