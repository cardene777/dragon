          "text": "0.05 ETH"
        },
        {
          "type": "swap",
          "box": "ビルダーB",
          "text": "0.12 ETH"
        },
        {
          "type": "swap",
          "box": "ビルダーC",
          "text": "0.08 ETH"
        }
      ]
    },
    {
      "title": "リレーが封をして中身を隠す",
      "body": "リレーは中身を預かって隠す。提案者が中身を盗めないようにするため。",
      "events": [
        {
          "type": "role",
          "role": "リレー"
        },
        {
          "type": "seal",
          "box": "ビルダーA"
        },
        {
          "type": "seal",
          "box": "ビルダーB"
        },
        {
          "type": "seal",
          "box": "ビルダーC"
        }
      ]
    },
    {
      "title": "提案者に金額だけを見せる",
      "body": "提案者に届くのは金額だけで、最も高いビルダーBを選ぶ。",
      "events": [
        {
          "type": "role",
          "role": "提案者"
        },
        {
          "type": "pick",
          "box": "ビルダーB"
        }
      ]
    },
    {
      "title": "提案者が中身を見ずに署名する",
      "body": "提案者は中身を見ないまま、ブロックの頭に署名する。",
      "events": [
        {
          "type": "role",
          "role": "提案者"
        },
        {
          "type": "stamp",
          "box": "ビルダーB",
          "text": "署名済み"
        }
      ]
    },
    {
      "title": "封を開けて全文を公開する",
      "body": "署名を受けたリレーが全文を公開する。負けた列の中身は公開されない。",
      "events": [
        {
          "type": "role",
          "role": "リレー"
        },
        {
          "type": "open",
          "box": "ビルダーB"
        }
      ]
    },
    {
      "title": "バリデーターが投票する",
      "body": "バリデーターが実行し直して確かめ、正しければ投票する。あなたの取引はBのブロックの4番目で確定する。",
