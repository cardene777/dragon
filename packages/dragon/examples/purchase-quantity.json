        {
          "type": "edge",
          "from": "buyer",
          "to": "agent",
          "carry": {
            "kind": "envelope"
          }
        },
        {
          "type": "edge",
          "from": "agent",
          "to": "seller",
          "carry": {
            "kind": "envelope"
          }
        },
        {
          "type": "edge",
          "from": "seller",
          "to": "processor",
          "carry": {
            "kind": "envelope"
          }
        }
