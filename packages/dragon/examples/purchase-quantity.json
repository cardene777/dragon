      {
        "kind": "scenario",
        "id": "declined",
        "name": "決済拒否",
        "options": {
          "outcome": "decline"
        },
        "line": 28
      },
      {
        "kind": "scenario",
        "id": "missing",
        "name": "応答不達",
        "options": {
          "outcome": "lost"
        },
        "line": 29
      }
