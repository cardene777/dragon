  "steps": [
    {
      "title": "Transactions wait in line",
      "body": "Transactions in the mempool line up from the highest fee and wait for the builder to put them in a block.",
      "events": [
        {
          "type": "line",
          "part": "Chain",
          "items": [
            "tx4",
            "tx5",
            "tx8"
          ]
        },
        {
          "type": "line",
          "part": "Chain",
          "items": [
            "tx1",
            "tx2",
            "tx3"
          ]
        },
        {
          "type": "line",
          "part": "Mempool",
          "items": [
            "tx6",
            "tx7",
            "tx9",
            "tx10"
          ]
        }
      ]
    },
    {
      "title": "You send one",
      "body": "Your transaction crosses the network to the builder and lines up in the mempool by its fee.",
      "events": [
        {
          "type": "ask",
          "values": [
            "You",
            "Bob",
            "5",
            "12"
          ]
        }
      ]
    },
    {
      "title": "The builder makes a block",
      "body": "The builder puts the three highest fees into block 3 and gives it block 2's hash as prev.",
      "events": [
        {
          "type": "press",
          "press": "Build"
        }
      ]
    },
    {
      "title": "Someone changes a block",
      "body": "Changing the amount of tx2 in block 2 changes its hash, so it no longer matches the prev that block 3 holds.",
      "events": [
        {
          "type": "item",
          "item": "tx2",
