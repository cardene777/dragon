{
  "version": 2,
  "kind": "pipe",
  "title": "落ちた交換を別のPoolでやり直す",
  "blocks": {
    "box": [
      {
        "id": "alice",
        "name": "Alice"
      },
      {
        "id": "router",
        "name": "SwapRouter"
      },
      {
        "id": "usdc",
        "name": "USDC"
      },
      {
        "id": "pool1",
        "name": "Pool1"
      },
      {
        "id": "weth",
        "name": "WETH"
      },
      {
        "id": "pool2",
        "name": "Pool2"
      }
    ],
    "hold": [
      {
        "box": "alice",
        "amount": "1000",
        "token": "USDC"
      },
      {
        "box": "alice",
        "amount": "0",
        "token": "WETH"
      },
      {
        "box": "router",
        "amount": "0",
        "token": "USDC"
      },
      {
        "box": "router",
        "name": "tries",
        "value": "0"
      },
      {
        "box": "pool1",
        "amount": "2000",
        "token": "USDC"
      },
      {
        "box": "pool1",
        "amount": "0.01",
        "token": "WETH"
      },
      {
        "box": "pool2",
        "amount": "2000",
        "token": "USDC"
      },
      {
        "box": "pool2",
        "amount": "10",
        "token": "WETH"
      }
    ]
  },
  "steps": [
    {
      "title": "AliceがRouterに交換を頼む",
      "body": "AliceがRouterに、100 USDCをWETHに替えるよう頼む。",
      "events": [
        {
          "type": "call",
          "from": "alice",
          "to": "router",
          "label": "100 USDCを交換"
        }
      ]
    },
    {
      "title": "RouterがAliceのUSDCを預かる",
      "body": "RouterがUSDCに頼み、Aliceの100 USDCを自分へ移させる。試した回数も1にする。",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "usdc",
          "label": "100 USDCを預かる"
        },
        {
          "type": "move",
          "box": "usdc",
          "amount": "100",
          "from": "alice",
          "to": "router"
        },
        {
          "type": "emit",
          "box": "usdc",
          "name": "Transfer",
          "args": [
            "alice",
            "router",
            "100"
          ]
        },
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        },
        {
          "type": "write",
          "box": "router",
          "name": "tries",
          "value": "1"
        }
      ]
    },
    {
      "title": "RouterがPool1に交換を頼む",
      "body": "RouterがPool1に、USDCをWETHに替えてAliceへ送るよう頼む。",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "pool1",
          "label": "100 USDCを交換"
        }
      ]
    },
    {
      "title": "Pool1がUSDCを受け取る",
      "body": "Pool1がUSDCに頼み、Routerの100 USDCを自分へ移させる。",
      "events": [
        {
          "type": "call",
          "from": "pool1",
          "to": "usdc",
          "label": "100 USDCを受け取る"
        },
        {
          "type": "move",
          "box": "usdc",
          "amount": "100",
          "from": "router",
          "to": "pool1"
        },
        {
          "type": "emit",
          "box": "usdc",
          "name": "Transfer",
          "args": [
            "router",
            "pool1",
            "100"
          ]
        },
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        }
      ]
    },
    {
      "title": "Pool1がWETHに払わせる",
      "body": "Pool1がWETHに、0.05 WETHをAliceへ送らせる。",
      "events": [
        {
          "type": "call",
          "from": "pool1",
          "to": "weth",
          "label": "0.05 WETHを送る"
        }
      ]
    },
    {
      "title": "WETHの送金が残高不足で落ちる",
      "body": "Pool1のWETHは0.01しかない。WETHが落ち、それを受けてPool1も落ちる。",
      "events": [
        {
          "type": "check",
          "box": "weth",
          "left": "0.01 WETH",
          "op": ">=",
          "right": "0.05 WETH"
        },
        {
          "type": "revert",
          "box": "weth",
          "reason": "残高不足"
        },
        {
          "type": "revert",
          "box": "pool1",
          "reason": "送金の失敗"
        }
      ]
    },
    {
      "title": "RouterがPool2で交換し直す",
      "body": "RouterはPool1が落ちたことを受け止め、Pool2に同じ交換を頼む。元に戻ったのはPool1の内側の変更だけ。",
      "gist": "元に戻ったのはPool1の内側の変更だけで、外側の変更は残る",
      "events": [
        {
          "type": "call",
          "from": "router",
          "to": "pool2",
          "label": "100 USDCを交換"
        }
      ]
    },
    {
      "title": "Pool2がUSDCを受け取る",
      "body": "Pool2がUSDCに頼み、Routerの100 USDCを自分へ移させる。",
      "events": [
        {
          "type": "call",
          "from": "pool2",
          "to": "usdc",
          "label": "100 USDCを受け取る"
        },
        {
          "type": "move",
          "box": "usdc",
          "amount": "100",
          "from": "router",
          "to": "pool2"
        },
        {
          "type": "emit",
          "box": "usdc",
          "name": "Transfer",
          "args": [
            "router",
            "pool2",
            "100"
          ]
        },
        {
          "type": "return",
          "box": "usdc",
          "value": "true"
        }
      ]
    },
    {
      "title": "0.05 WETHがPool2からAliceへ移る",
      "body": "Pool2がWETHに頼み、0.05 WETHをAliceへ送らせる。",
      "events": [
        {
          "type": "call",
          "from": "pool2",
          "to": "weth",
          "label": "0.05 WETHを送る"
        },
        {
          "type": "move",
          "box": "weth",
          "amount": "0.05",
          "from": "pool2",
          "to": "alice"
        },
        {
          "type": "emit",
          "box": "weth",
          "name": "Transfer",
          "args": [
            "pool2",
            "alice",
            "0.05"
          ]
        },
        {
          "type": "return",
          "box": "weth",
          "value": "true"
        }
      ]
    },
    {
      "title": "Pool2が払った量を返す",
      "body": "Pool2がRouterに、0.05 WETHを払ったと返す。",
      "events": [
        {
          "type": "return",
          "box": "pool2",
          "value": "0.05 WETH"
        }
      ]
    },
    {
      "title": "交換が終わる",
      "body": "一番外の呼び出しが戻り、残った変更が全て確定する。",
      "gist": "一番外の呼び出しが戻った時に、残った変更が全て確定する",
      "events": [
        {
          "type": "return",
          "box": "router",
          "value": "0.05 WETH"
        }
      ]
    }
  ]
}
