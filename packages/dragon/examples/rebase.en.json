{
  "version": 1,
  "kind": "git",
  "title": "Rebase a work branch and bring it into main",
  "boxes": [
    {
      "id": "worktree",
      "name": "Worktree",
      "sub": "Local files",
      "color": "violet",
      "icon": "doc"
    }
  ],
  "strip": {
    "title": "Refs",
    "fields": [
      "main",
      "feature",
      "HEAD",
      "History"
    ]
  },
  "steps": [
    {
      "title": "On main",
      "body": "main has commits A and B. main points at B, and HEAD points at main. The files you have open are B's.",
      "events": [
        {
          "type": "commit",
          "id": "A",
          "branch": "main",
          "hash": "3fa0c19",
          "note": "First shape"
        },
        {
          "type": "commit",
          "id": "B",
          "branch": "main",
          "hash": "8b04f71",
          "note": "Add the list"
        },
        {
          "type": "strip",
          "field": "main",
          "value": "B 8b04f71"
        },
        {
          "type": "strip",
          "field": "HEAD",
          "value": "main"
        },
        {
          "type": "strip",
          "field": "History",
          "value": "Straight"
        }
      ]
    },
    {
      "title": "Cut a branch",
      "body": "Create the work branch feature from B and switch to it. feature also points at B, and HEAD points at feature. The files are still the same as main.",
      "code": "git switch -c feature",
      "events": [
        {
          "type": "branch",
          "branch": "feature",
          "from": "B"
        },
        {
          "type": "strip",
          "field": "feature",
          "value": "B 8b04f71"
        },
        {
          "type": "strip",
          "field": "HEAD",
          "value": "feature"
        }
      ]
    },
    {
      "title": "Commit work",
      "body": "Add C and D on feature. Each commit moves feature to the new commit, and HEAD follows. main stays at B.",
      "code": "git commit",
      "events": [
        {
          "type": "commit",
          "id": "C",
          "branch": "feature",
          "hash": "c41d0e5",
          "note": "Round prices"
        },
        {
          "type": "commit",
          "id": "D",
          "branch": "feature",
          "hash": "d72b9a3",
          "note": "Add shipping"
        },
        {
          "type": "strip",
          "field": "feature",
          "value": "D d72b9a3"
        }
      ]
    },
    {
      "title": "main moves on",
      "body": "Meanwhile someone else's change E lands on main, and the local main pulls it in and points at E. feature still branches off the old B.",
      "events": [
        {
          "type": "commit",
          "id": "E",
          "branch": "main",
          "hash": "e5f8312",
          "note": "Fix the tax rate"
        },
        {
          "type": "strip",
          "field": "main",
          "value": "E e5f8312"
        },
        {
          "type": "strip",
          "field": "History",
          "value": "Branched"
        }
      ]
    },
    {
      "title": "Start the rebase",
      "body": "Git walks back to the fork point B, sets C and D aside, and moves HEAD to E. HEAD points at E directly, not through a branch (detached). From here it replays one commit at a time.",
      "code": "git rebase main",
      "events": [
        {
          "type": "edge",
          "from": "HEAD",
          "to": "E",
          "label": "git rebase main",
          "carry": {
            "kind": "tag",
            "text": "HEAD"
          }
        },
        {
          "type": "strip",
          "field": "HEAD",
          "value": "E (detached)"
        },
        {
          "type": "strip",
          "field": "History",
          "value": "Replaying"
        }
      ]
    },
    {
      "title": "Stop on a conflict",
      "body": "Replaying C on top of E conflicts, because E changed the same lines. The rebase stops there and waits for a fix.",
      "events": [
        {
          "type": "swap",
          "box": "worktree",
          "text": "Conflict in src/price.ts"
        },
        {
          "type": "strip",
          "field": "History",
          "value": "Stopped on a conflict"
        }
      ]
    },
    {
      "title": "Fix and continue",
      "body": "Fix the conflicting lines and continue, and C' appears with the same change as C. Its parent changed from B to E, so its hash changes too.",
      "code": "git add → git rebase --continue",
      "events": [
        {
          "type": "swap",
          "box": "worktree",
          "text": "Fixed and staged"
        },
        {
          "type": "commit",
          "id": "C'",
          "branch": "main",
          "copy": "C",
          "hash": "a90c6b4",
          "note": "Round prices"
        },
        {
          "type": "strip",
          "field": "HEAD",
          "value": "C' (detached)"
        },
        {
          "type": "strip",
          "field": "History",
          "value": "Replaying"
        }
      ]
    },
    {
      "title": "Replay D",
      "body": "D replays without a conflict and becomes D'. When the replay ends, feature moves to D' and HEAD returns to feature. The old C and D are no longer pointed at by anything.",
      "events": [
        {
          "type": "commit",
          "id": "D'",
          "branch": "main",
          "copy": "D",
          "hash": "f1e7d28",
          "note": "Add shipping"
        },
        {
          "type": "edge",
          "from": "feature",
          "to": "D'",
          "carry": {
            "kind": "tag",
            "text": "feature"
          }
        },
        {
          "type": "strip",
          "field": "feature",
          "value": "D' f1e7d28"
        },
        {
          "type": "strip",
          "field": "HEAD",
          "value": "feature"
        },
        {
          "type": "strip",
          "field": "History",
          "value": "Can fast-forward"
        }
      ]
    },
    {
      "title": "Checks pass",
      "body": "D' now includes the change in E. Run the checks on this shape and make sure they all pass before bringing it in.",
      "events": [
        {
          "type": "swap",
          "box": "worktree",
          "text": "Running checks on D'"
        },
        {
          "type": "swap",
          "box": "worktree",
          "text": "Types, unit, integration pass"
        }
      ]
    },
    {
      "title": "Fast-forward main",
      "body": "Move main up to D'. C' and D' continue in a straight line after main, so no merge commit is needed; only the ref moves.",
      "code": "git switch main → git merge --ff-only feature",
      "events": [
        {
          "type": "edge",
          "from": "main",
          "to": "D'",
          "label": "git merge --ff-only feature",
          "carry": {
            "kind": "tag",
            "text": "main"
          }
        },
        {
          "type": "strip",
          "field": "main",
          "value": "D' f1e7d28"
        },
        {
          "type": "strip",
          "field": "HEAD",
          "value": "main"
        },
        {
          "type": "strip",
          "field": "History",
          "value": "Straight"
        }
      ]
    },
    {
      "title": "A straight history",
      "body": "Following main back from its tip gives one line: D', C', E, B, A. The old C and D stay in the reflog until they expire and are cleaned up.",
      "code": "git log --oneline",
      "events": []
    }
  ],
  "git": {
    "branches": [
      {
        "id": "main",
        "note": "Merge target"
      },
      {
        "id": "feature",
        "note": "Work branch"
      }
    ]
  }
}
