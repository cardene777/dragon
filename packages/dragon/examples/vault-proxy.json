{
  "version": 2,
  "kind": "pipe",
  "title": "Proxyを通してVaultに1 ETHを預ける",
  "blocks": {
    "box": [
      {
        "id": "alice",
        "name": "Alice"
      },
      {
        "id": "proxy",
        "name": "VaultProxy"
      },
      {
        "id": "logic",
        "name": "VaultLogic"
      },
      {
        "id": "oracle",
        "name": "PriceOracle"
      }
    ],
    "hold": [
      {
        "box": "alice",
        "amount": "5",
        "token": "ETH"
      },
      {
        "box": "proxy",
        "amount": "0",
        "token": "ETH"
      },
      {
        "box": "proxy",
        "name": "owner",
        "value": "alice"
      },
      {
        "box": "proxy",
        "name": "deposits[alice]",
        "value": "0"
      },
      {
        "box": "proxy",
        "name": "paused",
        "value": "false"
      }
    ]
  },
  "steps": [
    {
      "title": "AliceがProxyに1 ETHを添えて頼む",
      "body": "AliceがProxyのdepositを呼び、呼び出しに1 ETHを添えて送る。",
      "events": [
        {
          "type": "call",
          "from": "alice",
          "to": "proxy",
          "label": "deposit",
          "value": "1"
        }
      ]
    },
    {
      "title": "ProxyがVaultLogicの処理を借りる",
      "body": "Proxyは処理を持たず、VaultLogicの処理を借りて自分の値の上で動かす。",
      "gist": "Proxyは処理を持たず、借りた処理をProxyの値の上で動かす",
      "events": [
        {
          "type": "call",
          "from": "proxy",
          "to": "logic",
          "label": "deposit",
          "call": "delegate"
        }
      ]
    },
    {
      "title": "止まっていないかを確かめる",
      "body": "借りた処理が、Vaultが止められていないかを確かめる。",
      "events": [
        {
          "type": "check",
          "box": "logic",
          "left": "paused",
          "op": "==",
          "right": "false"
        }
      ]
    },
    {
      "title": "価格を読むだけの呼び出し",
      "body": "借りた処理がPriceOracleに価格を尋ねる。この呼び出しの中では何も書き込めない。",
      "gist": "読むだけの呼び出しの中では、何も書き込めない",
      "events": [
        {
          "type": "call",
          "from": "logic",
          "to": "oracle",
          "label": "price",
          "call": "static"
        }
      ]
    },
    {
      "title": "PriceOracleが価格を返す",
      "body": "PriceOracleが今のETHの価格を返す。",
      "events": [
        {
          "type": "return",
          "box": "oracle",
          "value": "3200"
        }
      ]
    },
    {
      "title": "預けた額をProxyの値に書く",
      "body": "借りた処理が書き込む先は、VaultLogicではなくProxyの値になる。",
      "events": [
        {
          "type": "write",
          "box": "logic",
          "name": "deposits[alice]",
          "value": "1"
        }
      ]
    },
    {
      "title": "借りた処理が終わる",
      "body": "VaultLogicの処理が終わり、Proxyに戻る。",
      "events": [
        {
          "type": "return",
          "box": "logic",
          "value": "true"
        }
      ]
    },
    {
      "title": "Proxyが預けた記録を出す",
      "body": "Proxyが、誰がいくら預けたかをイベントとして出す。",
      "events": [
        {
          "type": "emit",
          "box": "proxy",
          "name": "Deposited",
          "args": [
            "alice",
            "1"
          ]
        }
      ]
    },
    {
      "title": "預け入れが終わる",
      "body": "一番外の呼び出しが戻り、ETHの送金も書き込んだ値も確定する。",
      "gist": "一番外の呼び出しが戻った時に、ETHの送金も書き込んだ値も確定する",
      "events": [
        {
          "type": "return",
          "box": "proxy",
          "value": "true"
        }
      ]
    }
  ]
}
