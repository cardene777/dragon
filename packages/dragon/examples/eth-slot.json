{
  "version": 2,
  "kind": "cycle",
  "title": "Ethereumの12秒のスロット",
  "blocks": {
    "box": [
      {
        "id": "collect",
        "name": "取引を集める",
        "sub": "待ちの場から",
        "color": "blue"
      },
      {
        "id": "propose",
        "name": "ブロックを出す",
        "sub": "提案者が1人",
        "color": "violet"
      },
      {
        "id": "vote",
        "name": "委員が投票する",
        "sub": "約3万人が署名",
        "color": "green"
      },
      {
        "id": "gather",
        "name": "投票をまとめる",
        "sub": "次の提案者へ",
        "color": "amber"
      }
    ],
    "strip": {
      "title": "スロット",
      "fields": [
        "番号",
        "経過"
      ]
    }
  },
  "steps": [
    {
      "title": "取引を集める",
      "body": "提案者が、送られて待っている取引を待ちの場 (mempool) から集める。",
      "events": [
        {
          "type": "strip",
          "field": "番号",
          "value": "#18,402,113"
        },
        {
          "type": "strip",
          "field": "経過",
          "value": "始まりから0秒"
        }
      ]
    },
    {
      "title": "ブロックを出す",
      "body": "提案者が集めた取引でブロックを作り、スロットの始まりにネットワークへ出す。",
      "events": [
        {
          "type": "edge",
          "from": "collect",
          "to": "propose",
          "carry": {
            "kind": "tag",
            "text": "取引"
          }
        }
      ]
    },
    {
      "title": "委員が投票する",
      "body": "このスロットの委員が、届いたブロックを正しい先頭と認めて署名する。",
      "events": [
        {
          "type": "edge",
          "from": "propose",
          "to": "vote",
          "carry": {
            "kind": "tag",
            "text": "ブロック"
          }
        },
        {
          "type": "strip",
          "field": "経過",
          "value": "始まりから4秒"
        }
      ]
    },
    {
      "title": "投票をまとめる",
      "body": "集まった署名を1つにまとめ、次のスロットの提案者へ渡す。",
      "events": [
        {
          "type": "edge",
          "from": "vote",
          "to": "gather",
          "carry": {
            "kind": "tag",
            "text": "投票"
          }
        },
        {
          "type": "strip",
          "field": "経過",
          "value": "始まりから8秒"
        }
      ]
    },
    {
      "title": "次のスロットへ",
      "body": "12秒たつと次のスロットが始まり、次の提案者が取引を集める。",
      "events": [
        {
          "type": "edge",
          "from": "gather",
          "to": "collect",
          "carry": {
            "kind": "tag",
            "text": "次へ"
          }
        },
        {
          "type": "strip",
          "field": "番号",
          "value": "#18,402,114"
        },
        {
          "type": "strip",
          "field": "経過",
          "value": "始まりから0秒"
        }
      ]
    }
  ]
}
