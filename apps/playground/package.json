{
  "name": "dragon-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:fresh": "rm -rf node_modules/.vite .astro && astro dev",
    "build": "astro build && pagefind --site dist --output-path dist/_pagefind",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:e2e": "playwright test tests/e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/react": "^4.3.0",
    "@cardenelabs/anim": "link:../../../cdl/packages/anim",
    "@cardenelabs/cdl": "link:../../../cdl/packages/cdl",
    "@cardenelabs/dragon": "workspace:*",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.10",
    "astro": "^5.10.0",
    "gsap": "^3.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.0"
  }
}
