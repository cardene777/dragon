---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  bodyClass?: string;
  showSearch?: boolean;
  showLangToggle?: boolean;
};

const {
  title = "dragon — Animated Diagram DSL",
  description = "dragon は Mermaid 感覚で書ける Text DSL から animated SVG diagram を生成する OSS。 cdl engine 上で phase / state / tween を動かせる。",
  bodyClass = "v4-body",
  showSearch = true,
  showLangToggle = true,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {/* theme pre-flash 防止 (site 共通 v4-theme key) */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("v4-theme");
          if (t === "dark" || (!t && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <Header showSearch={showSearch} showLangToggle={showLangToggle} />
    <main class="min-h-[calc(100vh-220px)]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
