---
import BaseLayout from "@/layouts/BaseLayout.astro";
import fs from "node:fs";
import path from "node:path";

const contributingPath = path.resolve(process.cwd(), "../../CONTRIBUTING.md");
const raw = fs.existsSync(contributingPath) ? fs.readFileSync(contributingPath, "utf-8") : "# Contributing\n\nNot found.";

function escapeHtml(s: string): string {
  return s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c] ?? c);
}

function renderInline(line: string): string {
  let s = escapeHtml(line);
  s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/`([^`]+)`/g, '<code class="rounded bg-nm-surface px-1.5 py-0.5 text-sm">$1</code>');
  s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-nm-accent underline">$1</a>');
  return s;
}

function renderMd(md: string): string {
  const lines = md.split("\n");
  const out: string[] = [];
  let inCode = false;
  let codeBuf: string[] = [];
  for (const line of lines) {
    if (line.startsWith("```")) {
      if (inCode) {
        out.push(`<pre class="rounded-nm bg-nm-surface p-4 overflow-auto"><code>${escapeHtml(codeBuf.join("\n"))}</code></pre>`);
        codeBuf = [];
        inCode = false;
      } else {
        inCode = true;
      }
      continue;
    }
    if (inCode) {
      codeBuf.push(line);
      continue;
    }
    if (line.startsWith("# ")) {
      out.push(`<h1 class="heading-h1 mb-6">${renderInline(line.slice(2))}</h1>`);
    } else if (line.startsWith("## ")) {
      out.push(`<h2 class="heading-h2 mt-10 mb-3">${renderInline(line.slice(3))}</h2>`);
    } else if (line.startsWith("### ")) {
      out.push(`<h3 class="heading-h3 mt-6 mb-2">${renderInline(line.slice(4))}</h3>`);
    } else if (line.startsWith("- ")) {
      out.push(`<li class="ml-6 list-disc text-nm-text-secondary">${renderInline(line.slice(2))}</li>`);
    } else if (line.trim() === "") {
      out.push("<br/>");
    } else {
      out.push(`<p class="text-nm-text-secondary">${renderInline(line)}</p>`);
    }
  }
  return out.join("\n");
}

const html = renderMd(raw);
---

<BaseLayout
  title="Contribute - dragon"
  description="dragon DSL への contribution gateway。 Issue 報告 / PR 提案 / OSS 開発参加の手順。"
>
  <section class="shell pt-12 pb-8">
    <div class="space-y-4">
      <nav aria-label="パンくず" class="flex items-center gap-1.5 text-xs font-medium text-nm-text-muted">
        <a href="/" class="text-nm-text-secondary hover:text-nm-accent no-underline">トップ</a>
        <span aria-hidden="true">/</span>
        <span class="text-nm-text">Contribute</span>
      </nav>
      <span class="section-eyebrow">Community</span>
    </div>
  </section>

  <section class="shell pb-16 max-w-3xl">
    <article class="contrib-md space-y-1" set:html={html}></article>
    <div class="mt-10 flex gap-4">
      <a href="https://github.com/cardene777/dragon/issues/new" target="_blank" rel="noopener noreferrer" class="rounded-nm bg-nm-accent px-6 py-3 text-white no-underline">Issue を起票</a>
      <a href="https://github.com/cardene777/dragon" target="_blank" rel="noopener noreferrer" class="rounded-nm border border-nm-accent text-nm-accent px-6 py-3 no-underline">GitHub repo</a>
    </div>
  </section>
</BaseLayout>
