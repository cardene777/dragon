---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="dragon — animated diagram DSL"
  description="dragon は Mermaid 感覚で書ける Text DSL から animated SVG diagram を生成する OSS。 sequence / topology / er など 12+ preset、 install 不要、 phase / state / tween で動く図を 1 ファイルで。"
>
<section class="hero">
  <div class="hero-copy">
    <div class="hero-eyebrow">
      <span class="ver">v0.5</span>
      <span>text dsl × svg animation</span>
    </div>
    <h1>
      <span data-ja="書くと、" data-en="Write,">書くと、</span><em data-ja="動く" data-en="it animates">動く</em><span data-ja="。" data-en=".">。</span>
    </h1>
    <p class="lead" data-ja="YAML 風 1 ファイルで actors / flow / animation を書くだけで、 sequence / topology / er / state ほか 12 種 (拡大予定) の図が phase 単位で動き出す。 install 不要、 mermaid 感覚で 1 分後に走り出す。" data-en="Write actors / flow / animation in one YAML-like file, and 12+ presets (sequence / topology / er / state and more) animate phase by phase. No install — start in a minute, mermaid style.">YAML 風 1 ファイルで <code>actors</code> / <code>flow</code> / <code>animation</code> を書くだけで、 sequence / topology / er / state ほか 12 種 (拡大予定) の図が phase 単位で動き出す。 install 不要、 mermaid 感覚で 1 分後に走り出す。</p>
    <div class="hero-cta">
      <a class="btn-primary" href="/editor">open editor →</a>
      <a class="btn-secondary">pnpm add @cardenelabs/dragon</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><span class="num">12+</span>preset</div>
      <div class="stat"><span class="num">3</span>cluster</div>
      <div class="stat"><span class="num">0</span>install</div>
      <div class="stat"><span class="num">MIT</span>license</div>
    </div>
  </div>

  <div class="hero-canvas">
    <div class="canvas-bar">
      <div class="dots">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      </div>
      <span class="file">▲ <b>api-call.dragon</b></span>
      <span class="phase">
        <span class="live-dot"></span> phase 2/4 · API → DB
      </span>
    </div>
    <div class="canvas-body">
      <pre class="canvas-code"><span class="ln">1</span><span class="k">title</span>: <span class="s">"login API"</span>
<span class="ln">2</span><span class="k">type</span>: sequence
<span class="ln">3</span>
<span class="ln">4</span><span class="k">actors</span>:
<span class="ln">5</span>  - User
<span class="ln">6</span>  - API
<span class="ln">7</span>  - DB
<span class="ln">8</span>
<span class="ln">9</span><span class="k">flow</span>:
<span class="ln">10</span>  - <span class="hl-1">User → API: <span class="s">"login"</span></span>
<span class="ln">11</span>  - <span class="hl-2">API → DB: <span class="s">"select"</span></span>
<span class="ln">12</span>  - <span class="hl-3">DB → API: <span class="s">"row"</span></span>
<span class="ln">13</span>  - <span class="hl-4">API → User: <span class="s">"200"</span></span>
<span class="ln">14</span>
<span class="ln">15</span><span class="k">animation</span>:
<span class="ln">16</span>  - step: <span class="s">"call"</span> 1.4s
<span class="ln">17</span>  - step: <span class="s">"query"</span> 1.4s
<span class="ln">18</span>  - step: <span class="s">"return"</span> 1.4s
<span class="ln">19</span>  - step: <span class="s">"ok"</span> 1.4s</pre>

      <div class="canvas-stage">
        <svg viewBox="0 0 600 320">
          <defs>
            <marker id="ar-teal" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#1f4d6e"/>
            </marker>
            <marker id="ar-purple" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#6d28d9"/>
            </marker>
            <marker id="ar-green" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#4ea36a"/>
            </marker>
            <marker id="ar-dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#8a8678"/>
            </marker>
          </defs>
          <!-- lifelines -->
          <line class="lifeline" x1="100" y1="80" x2="100" y2="290"/>
          <line class="lifeline" x1="300" y1="80" x2="300" y2="290"/>
          <line class="lifeline" x1="500" y1="80" x2="500" y2="290"/>

          <!-- actor heads -->
          <rect class="actor-box actor-focus-user" x="60" y="55" width="80" height="36" rx="7"/>
          <text class="actor-label" x="100" y="78" text-anchor="middle">User</text>
          <rect class="actor-box actor-focus-api" x="260" y="55" width="80" height="36" rx="7"/>
          <text class="actor-label" x="300" y="78" text-anchor="middle">API</text>
          <rect class="actor-box actor-focus-db" x="460" y="55" width="80" height="36" rx="7"/>
          <text class="actor-label" x="500" y="78" text-anchor="middle">DB</text>

          <!-- msg 1: User → API -->
          <path class="seq-msg seq-msg-1" d="M 100 130 L 300 130" marker-end="url(#ar-teal)"/>
          <text class="seq-label seq-label-1" x="200" y="122" text-anchor="middle">POST /login</text>

          <!-- msg 2: API → DB -->
          <path class="seq-msg seq-msg-2" d="M 300 175 L 500 175" marker-end="url(#ar-teal)"/>
          <text class="seq-label seq-label-2" x="400" y="167" text-anchor="middle">SELECT user</text>

          <!-- msg 3: DB → API -->
          <path class="seq-msg seq-msg-3" d="M 500 220 L 300 220" marker-end="url(#ar-purple)"/>
          <text class="seq-label seq-label-3" x="400" y="212" text-anchor="middle">row (1)</text>

          <!-- msg 4: API → User -->
          <path class="seq-msg seq-msg-4" d="M 300 265 L 100 265" marker-end="url(#ar-green)"/>
          <text class="seq-label seq-label-4" x="200" y="257" text-anchor="middle">200 OK</text>

          <!-- phase label (上) -->
          <text class="phase-text phase-1" x="300" y="30" fill="#1f4d6e">phase 1 · call · 1.4s</text>
          <text class="phase-text phase-2" x="300" y="30" fill="#1f4d6e">phase 2 · query · 1.4s</text>
          <text class="phase-text phase-3" x="300" y="30" fill="#6d28d9">phase 3 · return · 1.4s</text>
          <text class="phase-text phase-4" x="300" y="30" fill="#4ea36a">phase 4 · ok · 1.4s</text>
        </svg>
      </div>
    </div>
    <div class="canvas-foot">
      <span class="play">▶</span>
      <span>0.0s</span>
      <div class="pb"></div>
      <span>5.6s</span>
      <span>loop</span>
    </div>
  </div>
</section>

<!-- ── featured 3 narrative ── -->
<section class="featured">
  <div class="featured-track">
    <div class="featured-head">
      <h2>
        <span data-ja="3 つの図、 " data-en="3 diagrams, ">3 つの図、 </span><em data-ja="3 つの動き" data-en="3 motions">3 つの動き</em><span data-ja="。" data-en=".">。</span>
      </h2>
      <span class="sub" data-ja="dragon の表現力を 3 例で示す。 残り 9 個 (拡大予定) は catalog で。" data-en="dragon's expressiveness in 3 examples. 9 more (and growing) in the catalog.">dragon の表現力を 3 例で示す。 残り 9 個 (拡大予定) は catalog で。</span>
    </div>

    <!-- 01 sequence -->
    <div class="f-row">
      <div class="idx">01</div>
      <div class="info">
        <h3>sequence <span class="type">type: sequence</span></h3>
        <p>登場人物どうしのやりとりを <em style="font-style:italic;color:var(--brand-deep)">時間軸</em>で並べる。 hero でも live 中の代表 preset。 phase ごとに <code>focus:</code> を切替え、 <code>flow:</code> 順に msg を流す。 API call の順序、 認証 flow、 system 連携の説明に。</p>
        <div class="cluster"><span class="dot-basic"></span>basic / 全業種共通 6 種の代表</div>
      </div>
      <div class="preset-frame">
        <div class="pf-head">▲ sequence-demo.dragon<span class="live"></span></div>
        <div class="pf-stage">
          <svg viewBox="0 0 100 80">
            <line x1="20" y1="14" x2="20" y2="76" stroke="rgba(45,106,143,0.4)" stroke-width="0.6" stroke-dasharray="2 1.5"/>
            <line x1="50" y1="14" x2="50" y2="76" stroke="rgba(45,106,143,0.4)" stroke-width="0.6" stroke-dasharray="2 1.5"/>
            <line x1="80" y1="14" x2="80" y2="76" stroke="rgba(45,106,143,0.4)" stroke-width="0.6" stroke-dasharray="2 1.5"/>
            <rect x="12" y="6" width="16" height="9" rx="1.5" fill="#fffdf7" stroke="#2d6a8f" stroke-width="0.8"/>
            <text x="20" y="12.5" text-anchor="middle" font-size="4.2" fill="#1a1f2a" font-weight="600">Alice</text>
            <rect x="42" y="6" width="16" height="9" rx="1.5" fill="#fffdf7" stroke="#2d6a8f" stroke-width="0.8"/>
            <text x="50" y="12.5" text-anchor="middle" font-size="4.2" fill="#1a1f2a" font-weight="600">API</text>
            <rect x="72" y="6" width="16" height="9" rx="1.5" fill="#fffdf7" stroke="#2d6a8f" stroke-width="0.8"/>
            <text x="80" y="12.5" text-anchor="middle" font-size="4.2" fill="#1a1f2a" font-weight="600">DB</text>
            <path class="seqp-msg seqp-msg-1" d="M 20 30 L 49 30" marker-end="url(#sp-arr-teal)"/>
            <text x="35" y="27" font-size="3.4" font-family="JetBrains Mono" fill="#1a1f2a">request</text>
            <path class="seqp-msg seqp-msg-2" d="M 50 48 L 79 48" marker-end="url(#sp-arr-teal)"/>
            <text x="65" y="45" font-size="3.4" font-family="JetBrains Mono" fill="#1a1f2a">query</text>
            <path class="seqp-msg seqp-msg-3" d="M 80 66 L 21 66" marker-end="url(#sp-arr-green)"/>
            <text x="50" y="63" font-size="3.4" font-family="JetBrains Mono" fill="#4ea36a">200 ok</text>
            <defs>
              <marker id="sp-arr-teal" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="3.5" markerHeight="3.5" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#2d6a8f"/></marker>
              <marker id="sp-arr-green" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="3.5" markerHeight="3.5" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#4ea36a"/></marker>
            </defs>
          </svg>
        </div>
      </div>
    </div>

    <!-- 02 topology -->
    <div class="f-row">
      <div class="idx">02</div>
      <div class="info">
        <h3>topology <span class="type">type: topology</span></h3>
        <p><em style="font-style:italic;color:var(--brand-deep)">空間配置</em>と <em style="font-style:italic;color:var(--brand-deep)">動的 data flow</em> を同時に描く。 LB → Web → cache / DB の system 構成 + 「今 request がどこを通っているか」 を edge animation で。 architecture review、 onboarding 資料、 inspect の補助に。</p>
        <div class="cluster"><span class="dot-basic"></span>basic / system 構成の代表</div>
      </div>
      <div class="preset-frame">
        <div class="pf-head">▲ system-arch.dragon<span class="live"></span></div>
        <div class="pf-stage">
          <svg viewBox="0 0 100 80">
            <!-- LB -->
            <circle class="topo-node topo-node-lb" cx="14" cy="40" r="8" fill="#fffdf7" stroke="#2d6a8f" stroke-width="1.8"/>
            <text x="14" y="42" text-anchor="middle" font-size="3.8" fill="#1a1f2a" font-weight="600">LB</text>
            <text x="14" y="55" text-anchor="middle" font-size="2.8" font-family="JetBrains Mono" fill="#8a8678">cloud</text>
            <!-- Web -->
            <rect class="topo-node topo-node-web" x="40" y="20" width="22" height="14" rx="2" fill="#fffdf7" stroke="#2d6a8f" stroke-width="1.8"/>
            <text x="51" y="29" text-anchor="middle" font-size="3.8" fill="#1a1f2a" font-weight="600">Web</text>
            <text x="51" y="40" text-anchor="middle" font-size="2.8" font-family="JetBrains Mono" fill="#8a8678">service</text>
            <!-- Cache -->
            <rect class="topo-node topo-node-cache" x="40" y="48" width="22" height="14" rx="2" fill="#fffdf7" stroke="#2d6a8f" stroke-width="1.8"/>
            <text x="51" y="57" text-anchor="middle" font-size="3.8" fill="#1a1f2a" font-weight="600">Cache</text>
            <text x="51" y="68" text-anchor="middle" font-size="2.8" font-family="JetBrains Mono" fill="#8a8678">redis</text>
            <!-- DB -->
            <rect class="topo-node topo-node-db" x="76" y="34" width="20" height="14" rx="2" fill="#fffdf7" stroke="#2d6a8f" stroke-width="1.8" stroke-dasharray="1.5 1.5"/>
            <text x="86" y="43" text-anchor="middle" font-size="3.8" fill="#1a1f2a" font-weight="600">DB</text>
            <text x="86" y="54" text-anchor="middle" font-size="2.8" font-family="JetBrains Mono" fill="#8a8678">postgres</text>

            <!-- edges -->
            <path class="topo-edge topo-edge-1" d="M 22 38 L 40 26" marker-end="url(#topo-arr)"/>
            <path class="topo-edge topo-edge-2" d="M 62 27 L 76 39" marker-end="url(#topo-arr)"/>
            <path class="topo-edge topo-edge-3" d="M 62 55 L 76 45" marker-end="url(#topo-arr-purple)"/>
            <path class="topo-edge topo-edge-4" d="M 40 26 L 22 38" marker-end="url(#topo-arr-green)"/>
            <defs>
              <marker id="topo-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="3" markerHeight="3" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#1f4d6e"/></marker>
              <marker id="topo-arr-purple" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="3" markerHeight="3" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#6d28d9"/></marker>
              <marker id="topo-arr-green" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="3" markerHeight="3" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#4ea36a"/></marker>
            </defs>
          </svg>
        </div>
      </div>
    </div>

    <!-- 03 er -->
    <div class="f-row">
      <div class="idx">03</div>
      <div class="info">
        <h3>er <span class="type">type: er</span></h3>
        <p>DB の table と <em style="font-style:italic;color:var(--brand-deep)">関係性</em> を順に reveal。 entity を 1 つずつ生成、 relation 線を後から引いて cardinality (<code>1:N</code> / <code>N:N</code>) を text で表示。 schema review、 migration 説明、 新メンバー onboarding に。</p>
        <div class="cluster"><span class="dot-basic"></span>basic / DB 設計の代表</div>
      </div>
      <div class="preset-frame">
        <div class="pf-head">▲ user-order-er.dragon<span class="live"></span></div>
        <div class="pf-stage">
          <svg viewBox="0 0 100 80">
            <!-- User entity -->
            <g class="er-entity er-entity-1">
              <rect x="8" y="10" width="32" height="28" rx="2" fill="#fffdf7" stroke="#2d6a8f" stroke-width="1.2"/>
              <line x1="8" y1="18" x2="40" y2="18" stroke="#2d6a8f" stroke-width="0.6"/>
              <text x="24" y="16" text-anchor="middle" font-size="4.5" font-weight="700" fill="#1a1f2a">User</text>
              <text x="11" y="24" font-size="3.2" font-family="JetBrains Mono" fill="#5a6270">id   PK</text>
              <text x="11" y="29" font-size="3.2" font-family="JetBrains Mono" fill="#5a6270">email</text>
              <text x="11" y="34" font-size="3.2" font-family="JetBrains Mono" fill="#5a6270">created_at</text>
            </g>
            <!-- Order entity -->
            <g class="er-entity er-entity-2">
              <rect x="60" y="10" width="32" height="28" rx="2" fill="#fffdf7" stroke="#2d6a8f" stroke-width="1.2"/>
              <line x1="60" y1="18" x2="92" y2="18" stroke="#2d6a8f" stroke-width="0.6"/>
              <text x="76" y="16" text-anchor="middle" font-size="4.5" font-weight="700" fill="#1a1f2a">Order</text>
              <text x="63" y="24" font-size="3.2" font-family="JetBrains Mono" fill="#5a6270">id   PK</text>
              <text x="63" y="29" font-size="3.2" font-family="JetBrains Mono" fill="#5a6270">user_id FK</text>
              <text x="63" y="34" font-size="3.2" font-family="JetBrains Mono" fill="#5a6270">total</text>
            </g>
            <!-- Item entity -->
            <g class="er-entity er-entity-3">
              <rect x="34" y="50" width="32" height="24" rx="2" fill="#fffdf7" stroke="#2d6a8f" stroke-width="1.2"/>
              <line x1="34" y1="58" x2="66" y2="58" stroke="#2d6a8f" stroke-width="0.6"/>
              <text x="50" y="56" text-anchor="middle" font-size="4.5" font-weight="700" fill="#1a1f2a">Item</text>
              <text x="37" y="64" font-size="3.2" font-family="JetBrains Mono" fill="#5a6270">id   PK</text>
              <text x="37" y="69" font-size="3.2" font-family="JetBrains Mono" fill="#5a6270">order_id FK</text>
            </g>

            <!-- Relations -->
            <path class="er-rel er-rel-1" d="M 40 24 L 60 24" marker-end="url(#er-arr)"/>
            <text class="er-card er-card-1" x="50" y="22" text-anchor="middle">1:N</text>
            <path class="er-rel er-rel-2" d="M 76 38 L 50 50" marker-end="url(#er-arr)"/>
            <text class="er-card er-card-2" x="68" y="45">1:N</text>
            <defs>
              <marker id="er-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="3" markerHeight="3" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#1f4d6e"/></marker>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── catalog bridge ── -->
<section class="bridge">
  <h3>
    <span data-ja="もちろん " data-en="Of course, ">もちろん </span><em style="font-style:italic;color:var(--brand-deep)" data-ja="他にも" data-en="more">他にも</em><span data-ja="。" data-en=".">。</span>
  </h3>
  <p data-ja="flow / swimlane / state / class / gantt / pie / c4 / mind、 preset は今後さらに増える。 全件は catalog で。" data-en="flow / swimlane / state / class / gantt / pie / c4 / mind — and growing. Browse all in catalog.">flow / swimlane / state / class / gantt / pie / c4 / mind、 preset は今後さらに増える。 全件は catalog で。</p>
  <div class="bridge-chips">
    <span class="chip basic"><span class="ic">↓</span>flow</span>
    <span class="chip basic"><span class="ic">∥</span>swimlane</span>
    <span class="chip basic"><span class="ic">⊙</span>state</span>
    <span class="chip extended"><span class="ic">▤</span>class</span>
    <span class="chip extended"><span class="ic">▬</span>gantt</span>
    <span class="chip extended"><span class="ic">◐</span>pie</span>
    <span class="chip extended"><span class="ic">▣</span>c4</span>
    <span class="chip extended"><span class="ic">✺</span>mind</span>
  </div>
  <a class="btn-primary bridge-cta" href="/catalog">browse catalog →</a>
</section>
</BaseLayout>

<style is:global>
    <title>dragon — animated diagram DSL</title>
    <style is:global>
/* dragon site v3 SSOT (cream + teal、 全 page 統一) */
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --canvas: #f5f1e8;
  --surface: #fffdf7;
  --surface-2: #ede5d2;
  --line: #e0d9c8;
  --line-soft: #ece4d0;
  --ink: #1a1f2a;
  --ink-dim: #5a6270;
  --ink-mute: #8a8678;
  --brand: #2d6a8f;
  --brand-deep: #1f4d6e;
  --brand-glow: #4e9dc4;
  --accent-domain: #c2410c;
  --accent-extended: #6d28d9;
  --radius: 12px;
  --radius-lg: 18px;
  --serif: "Newsreader", "EB Garamond", Georgia, serif;
  --sans: "Inter", -apple-system, "Segoe UI", sans-serif;
  --mono: "JetBrains Mono", ui-monospace, "SF Mono", monospace;
}
html.dark {
  --canvas: #0e1117;
  --surface: #161b22;
  --surface-2: #1f2630;
  --line: #2a3340;
  --line-soft: #1f2630;
  --ink: #f0f3f8;
  --ink-dim: #99a3b3;
  --ink-mute: #6b7785;
  --brand: #5ec4e8;
  --brand-deep: #4e9dc4;
  --brand-glow: #7dc7e8;
}
html, body {
  background: var(--canvas);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "ss01", "cv11";
}
a { color: inherit; text-decoration: none; }
button { font: inherit; cursor: pointer; border: none; background: transparent; }

/* ── nav ── */

/* logo svg dark variant */

/* ── typography ── */
h1, h2, h3 { font-family: var(--serif); }
h1 { font-weight: 600; letter-spacing: -0.03em; }
h2 { font-weight: 600; letter-spacing: -0.02em; }
h3 { font-weight: 500; letter-spacing: -0.015em; }
.eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ink-mute);
}
.mono { font-family: var(--mono); }

/* ── cluster 色 ── */
.c-basic { color: var(--brand); }
.c-domain { color: var(--accent-domain); }
.c-extended { color: var(--accent-extended); }
.dot-basic, .dot-domain, .dot-extended {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  vertical-align: middle;
  margin-right: 6px;
}
.dot-basic { background: var(--brand); }
.dot-domain { background: var(--accent-domain); }
.dot-extended { background: var(--accent-extended); }
body { padding: 0; }

/* ── hero ── */
.hero {
  max-width: 1180px;
  margin: 0 auto;
  padding: 64px 32px 40px;
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 48px;
  align-items: center;
}
.hero-copy { padding-right: 16px; }
.hero-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--brand);
  margin-bottom: 18px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.hero-eyebrow .ver {
  background: rgba(45,106,143,0.1);
  padding: 2px 8px;
  border-radius: 99px;
  color: var(--brand-deep);
}
.hero h1 {
  font-family: var(--serif);
  font-size: 56px;
  line-height: 1.05;
  letter-spacing: -0.035em;
  font-weight: 500;
  margin-bottom: 18px;
}
.hero h1 em {
  font-style: italic;
  font-weight: 400;
  color: var(--brand-deep);
}
.hero p.lead {
  font-size: 16px;
  color: var(--ink-dim);
  line-height: 1.6;
  margin-bottom: 28px;
  max-width: 460px;
}
.hero p.lead code {
  font-family: var(--mono);
  font-size: 13.5px;
  background: var(--surface-2);
  padding: 1px 7px;
  border-radius: 5px;
  color: var(--ink);
}
.hero-cta {
  display: flex;
  gap: 10px;
  margin-bottom: 32px;
}
.btn-primary {
  padding: 13px 24px;
  background: var(--ink);
  color: var(--canvas);
  border-radius: 9px;
  font-size: 14px;
  font-family: var(--mono);
  letter-spacing: -0.02em;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: transform 0.15s, background 0.15s;
}
.btn-primary:hover { transform: translateY(-1px); background: var(--brand-deep); }
.btn-secondary {
  padding: 13px 24px;
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink);
  border-radius: 9px;
  font-size: 14px;
  font-family: var(--mono);
  letter-spacing: -0.02em;
}
.hero-stats {
  display: flex;
  gap: 22px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--ink-mute);
}
.hero-stats .stat .num {
  font-size: 20px;
  color: var(--ink);
  font-family: var(--serif);
  font-weight: 500;
  display: block;
  margin-bottom: -2px;
}

/* ── hero canvas (sequence) ── */
.hero-canvas {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow:
    0 1px 0 rgba(255,255,255,0.6) inset,
    0 30px 60px -30px rgba(26,31,42,0.18),
    0 18px 36px -18px rgba(45,106,143,0.15);
}
.canvas-bar {
  height: 38px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 1px solid var(--line-soft);
  background: var(--surface);
}
.canvas-bar .dots { display: flex; gap: 5px; }
.canvas-bar .dot { width: 9px; height: 9px; border-radius: 50%; }
.canvas-bar .dot.r { background: #f0a09e; }
.canvas-bar .dot.y { background: #f0c97a; }
.canvas-bar .dot.g { background: #a3d6a8; }
.canvas-bar .file {
  font-family: var(--mono);
  font-size: 11.5px;
  color: var(--ink-mute);
  margin-left: 8px;
}
.canvas-bar .file b { color: var(--brand-deep); font-weight: 500; }
.canvas-bar .phase {
  margin-left: auto;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-mute);
  display: flex;
  gap: 6px;
  align-items: center;
}
.canvas-bar .phase .live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #a3d6a8;
  box-shadow: 0 0 8px #a3d6a8;
  animation: pulse 1.8s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.canvas-body {
  display: grid;
  grid-template-columns: 0.78fr 1fr;
  height: 340px;
}
.canvas-code {
  background: #fcf8ee;
  padding: 16px 14px;
  font-family: var(--mono);
  font-size: 11.5px;
  line-height: 1.7;
  color: var(--ink);
  border-right: 1px solid var(--line-soft);
  white-space: pre;
  overflow: auto;
  position: relative;
}
.canvas-code .ln {
  color: var(--ink-mute);
  display: inline-block;
  width: 22px;
  text-align: right;
  margin-right: 10px;
  user-select: none;
  font-size: 10.5px;
}
.canvas-code .k { color: var(--brand-deep); }
.canvas-code .s { color: #6a8a3a; }
.canvas-code .n { color: var(--accent-domain); }
.canvas-code .c { color: var(--ink-mute); font-style: italic; }

/* sequence hero animation (4 steps × 1.4s = 5.6s loop) */
.canvas-code .hl-1 { background: transparent; animation: hl1 5.6s steps(1) infinite; display: inline-block; margin: 0 -4px; padding: 0 4px; border-radius: 3px; }
.canvas-code .hl-2 { background: transparent; animation: hl2 5.6s steps(1) infinite; display: inline-block; margin: 0 -4px; padding: 0 4px; border-radius: 3px; }
.canvas-code .hl-3 { background: transparent; animation: hl3 5.6s steps(1) infinite; display: inline-block; margin: 0 -4px; padding: 0 4px; border-radius: 3px; }
.canvas-code .hl-4 { background: transparent; animation: hl4 5.6s steps(1) infinite; display: inline-block; margin: 0 -4px; padding: 0 4px; border-radius: 3px; }
@keyframes hl1 { 0%, 25% { background: rgba(45,106,143,0.15); } 25.01%, 100% { background: transparent; } }
@keyframes hl2 { 0%, 25% { background: transparent; } 25.01%, 50% { background: rgba(45,106,143,0.15); } 50.01%, 100% { background: transparent; } }
@keyframes hl3 { 0%, 50% { background: transparent; } 50.01%, 75% { background: rgba(167,139,255,0.18); } 75.01%, 100% { background: transparent; } }
@keyframes hl4 { 0%, 75% { background: transparent; } 75.01%, 100% { background: rgba(94,212,140,0.2); } }

.canvas-stage {
  background:
    repeating-linear-gradient(0deg, transparent 0 23px, rgba(26,31,42,0.04) 23px 24px),
    repeating-linear-gradient(90deg, transparent 0 23px, rgba(26,31,42,0.04) 23px 24px),
    #fcf8ee;
  display: grid;
  place-items: center;
  position: relative;
}
.canvas-stage svg { width: 100%; height: 100%; padding: 8px; }

/* sequence actor lifelines + msgs */
.lifeline { stroke: rgba(45,106,143,0.4); stroke-width: 1; stroke-dasharray: 4 3; }
.actor-box { fill: #fffdf7; stroke: var(--brand); stroke-width: 1.5; }
.actor-label { fill: #1a1f2a; font-weight: 600; font-size: 13px; }

.seq-msg {
  stroke-dasharray: 8 5;
  stroke-dashoffset: 0;
  fill: none;
  stroke-width: 2;
  opacity: 0;
}
.seq-msg-1 { animation: msg1 5.6s steps(1) infinite, dash-flow 0.8s linear infinite; }
.seq-msg-2 { animation: msg2 5.6s steps(1) infinite, dash-flow 0.8s linear infinite; }
.seq-msg-3 { animation: msg3 5.6s steps(1) infinite, dash-flow 0.8s linear infinite; }
.seq-msg-4 { animation: msg4 5.6s steps(1) infinite, dash-flow 0.8s linear infinite; }
@keyframes msg1 { 0%, 25% { opacity: 1; stroke: var(--brand-deep); } 25.01%, 100% { opacity: 0.18; stroke: var(--ink-mute); } }
@keyframes msg2 { 0%, 25% { opacity: 0; } 25.01%, 50% { opacity: 1; stroke: var(--brand-deep); } 50.01%, 100% { opacity: 0.18; stroke: var(--ink-mute); } }
@keyframes msg3 { 0%, 50% { opacity: 0; } 50.01%, 75% { opacity: 1; stroke: var(--accent-extended); } 75.01%, 100% { opacity: 0.18; stroke: var(--ink-mute); } }
@keyframes msg4 { 0%, 75% { opacity: 0; } 75.01%, 100% { opacity: 1; stroke: #4ea36a; } }
@keyframes dash-flow { to { stroke-dashoffset: -13; } }

.seq-label { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; fill: #1a1f2a; opacity: 0; }
.seq-label-1 { animation: msg1-l 5.6s steps(1) infinite; }
.seq-label-2 { animation: msg2-l 5.6s steps(1) infinite; }
.seq-label-3 { animation: msg3-l 5.6s steps(1) infinite; }
.seq-label-4 { animation: msg4-l 5.6s steps(1) infinite; }
@keyframes msg1-l { 0%, 25% { opacity: 1; } 25.01%, 100% { opacity: 0.4; } }
@keyframes msg2-l { 0%, 25% { opacity: 0; } 25.01%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0.4; } }
@keyframes msg3-l { 0%, 50% { opacity: 0; } 50.01%, 75% { opacity: 1; } 75.01%, 100% { opacity: 0.4; } }
@keyframes msg4-l { 0%, 75% { opacity: 0; } 75.01%, 100% { opacity: 1; } }

.actor-focus-user { animation: focus-user 5.6s steps(1) infinite; }
.actor-focus-api { animation: focus-api 5.6s steps(1) infinite; }
.actor-focus-db { animation: focus-db 5.6s steps(1) infinite; }
@keyframes focus-user { 0%, 25% { stroke: var(--brand); stroke-width: 3; filter: drop-shadow(0 4px 10px rgba(45,106,143,0.3)); } 25.01%, 75% { stroke: var(--line); stroke-width: 1.5; filter: none; } 75.01%, 100% { stroke: #4ea36a; stroke-width: 3; filter: drop-shadow(0 4px 10px rgba(78,163,106,0.3)); } }
@keyframes focus-api { 0%, 25% { stroke: var(--line); stroke-width: 1.5; filter: none; } 25.01%, 75% { stroke: var(--brand); stroke-width: 3; filter: drop-shadow(0 4px 10px rgba(45,106,143,0.3)); } 75.01%, 100% { stroke: var(--line); stroke-width: 1.5; filter: none; } }
@keyframes focus-db { 0%, 50% { stroke: var(--line); stroke-width: 1.5; filter: none; } 50.01%, 75% { stroke: var(--accent-extended); stroke-width: 3; filter: drop-shadow(0 4px 10px rgba(167,139,255,0.3)); } 75.01%, 100% { stroke: var(--line); stroke-width: 1.5; filter: none; } }

.phase-text {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  text-anchor: middle;
  opacity: 0;
}
.phase-1 { animation: ph1 5.6s steps(1) infinite; }
.phase-2 { animation: ph2 5.6s steps(1) infinite; }
.phase-3 { animation: ph3 5.6s steps(1) infinite; }
.phase-4 { animation: ph4 5.6s steps(1) infinite; }
@keyframes ph1 { 0%, 25% { opacity: 1; } 25.01%, 100% { opacity: 0; } }
@keyframes ph2 { 0%, 25% { opacity: 0; } 25.01%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }
@keyframes ph3 { 0%, 50% { opacity: 0; } 50.01%, 75% { opacity: 1; } 75.01%, 100% { opacity: 0; } }
@keyframes ph4 { 0%, 75% { opacity: 0; } 75.01%, 100% { opacity: 1; } }

.canvas-foot {
  height: 38px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  border-top: 1px solid var(--line-soft);
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-mute);
}
.canvas-foot .play {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--ink);
  color: var(--canvas);
  display: grid;
  place-items: center;
  font-size: 9px;
}
.canvas-foot .pb {
  flex: 1;
  height: 3px;
  background: var(--line);
  border-radius: 99px;
  position: relative;
  overflow: hidden;
}
.canvas-foot .pb::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: var(--brand);
  animation: pb 5.6s linear infinite;
}
@keyframes pb {
  0% { width: 0; }
  100% { width: 100%; }
}

/* ── featured 3 narrative ── */
.featured {
  border-top: 1px solid var(--line);
  margin-top: 56px;
}
.featured-track {
  max-width: 1180px;
  margin: 0 auto;
  padding: 64px 32px 56px;
}
.featured-head {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-bottom: 40px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}
.featured-head h2 {
  font-size: 32px;
  font-weight: 500;
  letter-spacing: -0.025em;
}
.featured-head h2 em { font-style: italic; color: var(--brand-deep); }
.featured-head .sub {
  color: var(--ink-dim);
  font-size: 14px;
  margin-left: auto;
}

.f-row {
  display: grid;
  grid-template-columns: 80px 1fr 1.35fr;
  gap: 36px;
  align-items: center;
  padding: 36px 0;
  border-bottom: 1px solid var(--line-soft);
}
.f-row:last-child { border-bottom: none; }
.f-row .idx {
  font-family: var(--serif);
  font-size: 52px;
  font-weight: 400;
  color: var(--ink-mute);
  font-style: italic;
  line-height: 1;
}
.f-row .info h3 {
  font-size: 26px;
  font-weight: 500;
  margin-bottom: 8px;
  letter-spacing: -0.022em;
  display: flex;
  align-items: center;
  gap: 12px;
}
.f-row .info h3 .type {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-mute);
  font-weight: 400;
  background: var(--surface-2);
  padding: 2px 9px;
  border-radius: 99px;
}
.f-row .info p {
  font-size: 15px;
  color: var(--ink-dim);
  line-height: 1.65;
  margin-bottom: 14px;
}
.f-row .info p code {
  font-family: var(--mono);
  font-size: 13px;
  background: var(--surface-2);
  padding: 1px 6px;
  border-radius: 4px;
  color: var(--ink);
}
.f-row .info .cluster {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-mute);
}

.preset-frame {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 14px;
  box-shadow: 0 1px 0 rgba(255,255,255,0.6) inset, 0 18px 40px -22px rgba(26,31,42,0.16), 0 8px 20px -8px rgba(45,106,143,0.1);
}
.preset-frame .pf-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-mute);
}
.preset-frame .pf-head .live {
  width: 6px;
  height: 6px;
  background: #a3d6a8;
  border-radius: 50%;
  margin-left: auto;
  animation: pulse 1.8s ease-in-out infinite;
}
.preset-frame .pf-stage {
  height: 220px;
  background: #fcf8ee;
  background-image:
    repeating-linear-gradient(0deg, transparent 0 19px, rgba(26,31,42,0.04) 19px 20px),
    repeating-linear-gradient(90deg, transparent 0 19px, rgba(26,31,42,0.04) 19px 20px);
  border-radius: 8px;
  display: grid;
  place-items: center;
  position: relative;
}
.preset-frame .pf-stage svg { width: 92%; height: 92%; }

/* ── #1 sequence preview animation ── */
.seqp-msg { stroke-dasharray: 4 3; stroke-width: 1.2; fill: none; opacity: 0; }
.seqp-msg-1 { stroke: var(--brand); animation: sp1 4.2s steps(1) infinite, dash-flow-s 0.7s linear infinite; }
.seqp-msg-2 { stroke: var(--brand); animation: sp2 4.2s steps(1) infinite, dash-flow-s 0.7s linear infinite; }
.seqp-msg-3 { stroke: #4ea36a; animation: sp3 4.2s steps(1) infinite, dash-flow-s 0.7s linear infinite; }
@keyframes sp1 { 0%, 33% { opacity: 1; } 33.01%, 100% { opacity: 0.25; stroke: var(--ink-mute); } }
@keyframes sp2 { 0%, 33% { opacity: 0; } 33.01%, 66% { opacity: 1; } 66.01%, 100% { opacity: 0.25; stroke: var(--ink-mute); } }
@keyframes sp3 { 0%, 66% { opacity: 0; } 66.01%, 100% { opacity: 1; } }
@keyframes dash-flow-s { to { stroke-dashoffset: -7; } }

/* ── #2 topology preview animation ── */
.topo-edge {
  stroke-dasharray: 4 3;
  stroke-width: 0.9;
  fill: none;
  stroke: var(--brand-deep);
  opacity: 0;
}
.topo-edge-1 { animation: te1 3.6s steps(1) infinite, dash-flow-t 0.6s linear infinite; }
.topo-edge-2 { animation: te2 3.6s steps(1) infinite, dash-flow-t 0.6s linear infinite; }
.topo-edge-3 { animation: te3 3.6s steps(1) infinite, dash-flow-t 0.6s linear infinite; }
.topo-edge-4 { animation: te4 3.6s steps(1) infinite, dash-flow-t 0.6s linear infinite; }
@keyframes te1 { 0%, 25% { opacity: 1; } 25.01%, 100% { opacity: 0.2; stroke: var(--ink-mute); } }
@keyframes te2 { 0%, 25% { opacity: 0; } 25.01%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0.2; stroke: var(--ink-mute); } }
@keyframes te3 { 0%, 50% { opacity: 0; } 50.01%, 75% { opacity: 1; stroke: var(--accent-extended); } 75.01%, 100% { opacity: 0.2; stroke: var(--ink-mute); } }
@keyframes te4 { 0%, 75% { opacity: 0; } 75.01%, 100% { opacity: 1; stroke: #4ea36a; } }
@keyframes dash-flow-t { to { stroke-dashoffset: -7; } }

.topo-node { transition: stroke 0.3s; }
.topo-node-lb { animation: tn-lb 3.6s steps(1) infinite; }
.topo-node-web { animation: tn-web 3.6s steps(1) infinite; }
.topo-node-cache { animation: tn-cache 3.6s steps(1) infinite; }
.topo-node-db { animation: tn-db 3.6s steps(1) infinite; }
@keyframes tn-lb { 0%, 25% { stroke: var(--brand); stroke-width: 1.8; } 25.01%, 100% { stroke: var(--line); stroke-width: 1; } }
@keyframes tn-web { 0%, 25% { stroke: var(--line); stroke-width: 1; } 25.01%, 75% { stroke: var(--brand); stroke-width: 1.8; } 75.01%, 100% { stroke: #4ea36a; stroke-width: 1.8; } }
@keyframes tn-cache { 0%, 50% { stroke: var(--line); stroke-width: 1; } 50.01%, 75% { stroke: var(--accent-extended); stroke-width: 1.8; } 75.01%, 100% { stroke: var(--line); stroke-width: 1; } }
@keyframes tn-db { 0%, 50% { stroke: var(--line); stroke-width: 1; } 50.01%, 75% { stroke: var(--accent-extended); stroke-width: 1.8; } 75.01%, 100% { stroke: var(--line); stroke-width: 1; } }

/* ── #3 er preview animation ── */
.er-entity {
  animation: er-appear 4.5s steps(1) infinite;
  opacity: 0;
}
.er-entity-1 { animation-name: er1; }
.er-entity-2 { animation-name: er2; }
.er-entity-3 { animation-name: er3; }
@keyframes er1 { 0%, 16% { opacity: 0; } 16.01%, 100% { opacity: 1; } }
@keyframes er2 { 0%, 32% { opacity: 0; } 32.01%, 100% { opacity: 1; } }
@keyframes er3 { 0%, 48% { opacity: 0; } 48.01%, 100% { opacity: 1; } }

.er-rel {
  stroke-dasharray: 4 3;
  stroke-width: 0.9;
  fill: none;
  stroke: var(--brand-deep);
  opacity: 0;
}
.er-rel-1 { animation: erl1 4.5s steps(1) infinite, dash-flow-t 0.6s linear infinite; }
.er-rel-2 { animation: erl2 4.5s steps(1) infinite, dash-flow-t 0.6s linear infinite; }
@keyframes erl1 { 0%, 64% { opacity: 0; } 64.01%, 100% { opacity: 1; } }
@keyframes erl2 { 0%, 80% { opacity: 0; } 80.01%, 100% { opacity: 1; } }

.er-card {
  font-family: 'JetBrains Mono', monospace;
  font-size: 3.4px;
  font-weight: 600;
  opacity: 0;
}
.er-card-1 { animation: erc1 4.5s steps(1) infinite; }
.er-card-2 { animation: erc2 4.5s steps(1) infinite; }
@keyframes erc1 { 0%, 72% { opacity: 0; } 72.01%, 100% { opacity: 1; fill: var(--brand-deep); } }
@keyframes erc2 { 0%, 88% { opacity: 0; } 88.01%, 100% { opacity: 1; fill: var(--brand-deep); } }

/* ── catalog bridge ── */
.bridge {
  max-width: 1180px;
  margin: 0 auto;
  padding: 56px 32px 80px;
  text-align: center;
}
.bridge h3 {
  font-family: var(--serif);
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.02em;
  margin-bottom: 10px;
}
.bridge p {
  color: var(--ink-dim);
  font-size: 14.5px;
  margin-bottom: 22px;
  max-width: 560px;
  margin-left: auto;
  margin-right: auto;
}
.bridge-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
  margin: 0 auto 26px;
  max-width: 720px;
}
.chip {
  padding: 6px 13px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 99px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--ink-dim);
  display: inline-flex;
  align-items: center;
  gap: 7px;
  transition: border-color 0.15s, color 0.15s;
}
.chip:hover { border-color: var(--brand); color: var(--ink); }
.chip .ic {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 10px;
