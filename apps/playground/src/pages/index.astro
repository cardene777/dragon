---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlDiagramThumbnail } from "@cardenelabs/cdl";
import { presetSequence, presetTopology, presetEr } from "@/topics/catalog/presets.cdl";
---

<BaseLayout
  title="dragon — animated diagram DSL"
  description="dragonはText DSLからanimated SVG diagramを生成するOSS。書いただけで動く図が手に入る。"
>
<section class="hero">
  <div class="hero-copy">
    <div class="hero-eyebrow">
      <span class="ver">v0.5</span>
      <span>text dsl × svg animation</span>
    </div>
    <h1>
      書くと、<em>動く</em>。
    </h1>
    <p class="lead">YAML風の1ファイルに登場人物と流れを書くだけで、phaseごとに動くSVG図が手に入る。インストール不要、ブラウザで開いて1分で走り出す。</p>
    <div class="hero-cta">
      <a class="btn-primary" href="/editor">エディタを開く →</a>
      <a class="btn-secondary" href="/docs">ドキュメントを読む</a>
    </div>
  </div>
</section>

<section class="hero-demo">
  <div class="canvas">
    <div class="canvas-bar">
      <div class="dots">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      </div>
      <span class="file">▲ <b>api-call.dragon</b></span>
      <span class="phase">
        <span class="live-dot"></span> phase 2 / 4 · API → DB
      </span>
    </div>
    <div class="canvas-body">
      <pre class="canvas-code"><span class="ln">1</span><span class="k">title</span>: <span class="s">"ログインAPI"</span>
<span class="ln">2</span><span class="k">type</span>: sequence
<span class="ln">3</span>
<span class="ln">4</span><span class="k">actors</span>:
<span class="ln">5</span>  - User
<span class="ln">6</span>  - API
<span class="ln">7</span>  - DB
<span class="ln">8</span>
<span class="ln">9</span><span class="k">flow</span>:
<span class="ln">10</span>  - <span class="hl-1">User → API: <span class="s">"login"</span></span>
<span class="ln">11</span>  - <span class="hl-2">API → DB: <span class="s">"select"</span></span>
<span class="ln">12</span>  - <span class="hl-3">DB → API: <span class="s">"row"</span></span>
<span class="ln">13</span>  - <span class="hl-4">API → User: <span class="s">"200"</span></span>
<span class="ln">14</span>
<span class="ln">15</span><span class="k">animation</span>:
<span class="ln">16</span>  - step: <span class="s">"call"</span> 1.4s
<span class="ln">17</span>  - step: <span class="s">"query"</span> 1.4s
<span class="ln">18</span>  - step: <span class="s">"return"</span> 1.4s
<span class="ln">19</span>  - step: <span class="s">"ok"</span> 1.4s</pre>

      <div class="canvas-stage">
        <svg viewBox="0 0 600 380" preserveAspectRatio="xMidYMid meet">
          <defs>
            <marker id="ar-teal" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#1f4d6e"/>
            </marker>
            <marker id="ar-purple" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#6d28d9"/>
            </marker>
            <marker id="ar-green" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#4ea36a"/>
            </marker>
          </defs>
          <line class="lifeline" x1="100" y1="80" x2="100" y2="360"/>
          <line class="lifeline" x1="300" y1="80" x2="300" y2="360"/>
          <line class="lifeline" x1="500" y1="80" x2="500" y2="360"/>

          <rect class="actor-box actor-focus-user" x="60" y="55" width="80" height="40" rx="7"/>
          <text class="actor-label" x="100" y="80" text-anchor="middle">User</text>
          <rect class="actor-box actor-focus-api" x="260" y="55" width="80" height="40" rx="7"/>
          <text class="actor-label" x="300" y="80" text-anchor="middle">API</text>
          <rect class="actor-box actor-focus-db" x="460" y="55" width="80" height="40" rx="7"/>
          <text class="actor-label" x="500" y="80" text-anchor="middle">DB</text>

          <path class="seq-msg seq-msg-1" d="M 100 150 L 300 150" marker-end="url(#ar-teal)"/>
          <text class="seq-label seq-label-1" x="200" y="138" text-anchor="middle">POST /login</text>

          <path class="seq-msg seq-msg-2" d="M 300 200 L 500 200" marker-end="url(#ar-teal)"/>
          <text class="seq-label seq-label-2" x="400" y="188" text-anchor="middle">SELECT user</text>

          <path class="seq-msg seq-msg-3" d="M 500 260 L 300 260" marker-end="url(#ar-purple)"/>
          <text class="seq-label seq-label-3" x="400" y="248" text-anchor="middle">row (1)</text>

          <path class="seq-msg seq-msg-4" d="M 300 320 L 100 320" marker-end="url(#ar-green)"/>
          <text class="seq-label seq-label-4" x="200" y="308" text-anchor="middle">200 OK</text>

          <text class="phase-text phase-1" x="300" y="30" fill="#1f4d6e">phase 1 · call · 1.4s</text>
          <text class="phase-text phase-2" x="300" y="30" fill="#1f4d6e">phase 2 · query · 1.4s</text>
          <text class="phase-text phase-3" x="300" y="30" fill="#6d28d9">phase 3 · return · 1.4s</text>
          <text class="phase-text phase-4" x="300" y="30" fill="#4ea36a">phase 4 · ok · 1.4s</text>
        </svg>
      </div>
    </div>
    <div class="canvas-foot">
      <span class="play">▶</span>
      <span>0.0s</span>
      <div class="pb"></div>
      <span>5.6s</span>
      <span>loop</span>
    </div>
  </div>
</section>

<section class="features">
  <div class="section-head">
    <span class="eyebrow">なぜdragonか</span>
    <h2>書く手間を、動く成果に。</h2>
  </div>
  <div class="feature-grid">
    <div class="feature">
      <div class="feature-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
      </div>
      <h3>YAML風で書ける</h3>
      <p>登場人物と流れを箇条書きで宣言するだけ。図の内部構造を組む必要はない。</p>
    </div>
    <div class="feature">
      <div class="feature-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      </div>
      <h3>phaseごとに動く</h3>
      <p>state / tween / setで数値を補間し、phaseで焦点を切替える。静止画では伝わらない順序が伝わる。</p>
    </div>
    <div class="feature">
      <div class="feature-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M12 3v18"/></svg>
      </div>
      <h3>install不要</h3>
      <p>ブラウザでエディタを開いてYAMLを書けば、その場で動くSVGが手に入る。npm installも設定ファイルもいらない。</p>
    </div>
  </div>
</section>

<section class="quickstart">
  <div class="section-head">
    <span class="eyebrow">3 steps</span>
    <h2>1分で走り出す。</h2>
  </div>
  <div class="steps">
    <div class="step">
      <div class="step-num">1</div>
      <div class="step-body">
        <h3>エディタを開く</h3>
        <p>ブラウザで<code>/editor</code>にアクセス。 install不要。</p>
      </div>
    </div>
    <div class="step">
      <div class="step-num">2</div>
      <div class="step-body">
        <h3>YAMLを書く</h3>
        <p>登場人物と流れを箇条書きで宣言する。<code>type: sequence</code>で図の種類を選ぶ。</p>
        <pre class="step-code"><span class="k">title</span>: <span class="s">"ログインAPI"</span>
<span class="k">type</span>: sequence
<span class="k">actors</span>:
  - User
  - API
<span class="k">flow</span>:
  - User → API: <span class="s">"login"</span></pre>
      </div>
    </div>
    <div class="step">
      <div class="step-num">3</div>
      <div class="step-body">
        <h3>SVGが動き出す</h3>
        <p>右のライブプレビューにphase単位で動くSVGが表示される。 URLで共有もダウンロードもできる。</p>
      </div>
    </div>
  </div>
</section>

<section class="examples">
  <div class="section-head">
    <span class="eyebrow">use case</span>
    <h2>こんな図が書ける。</h2>
  </div>
  <div class="examples-grid">
    <a class="example" href="/docs/cdl/presets/sequence">
      <div class="example-thumb">
        <CdlDiagramThumbnail client:load diagram={presetSequence} hideHeader />
      </div>
      <div class="example-body">
        <span class="example-tag">sequence</span>
        <h3>API呼び出しの流れ</h3>
        <p>登場人物どうしのやりとりを時間軸で並べる。認証 / API連携の説明に。</p>
      </div>
    </a>
    <a class="example" href="/docs/cdl/presets/topology">
      <div class="example-thumb">
        <CdlDiagramThumbnail client:load diagram={presetTopology} hideHeader />
      </div>
      <div class="example-body">
        <span class="example-tag">topology</span>
        <h3>システム構成図</h3>
        <p>コンポーネントの配置と、リクエストがどこを通るかを同時に描く。</p>
      </div>
    </a>
    <a class="example" href="/docs/cdl/presets/er">
      <div class="example-thumb">
        <CdlDiagramThumbnail client:load diagram={presetEr} hideHeader />
      </div>
      <div class="example-body">
        <span class="example-tag">er</span>
        <h3>DBスキーマ</h3>
        <p>entityと関係性を順番に見せる。 schema review / onboardingに。</p>
      </div>
    </a>
  </div>
  <div class="examples-more">
    <a class="btn-secondary" href="/catalog">図のカタログを見る →</a>
  </div>
</section>

<section class="closing-cta">
  <div class="closing-cta-inner">
    <h2>今すぐ、書いて動かす。</h2>
    <p>YAMLを1ファイル書くだけ。 動く図を1分後に手に入れる。</p>
    <div class="closing-cta-buttons">
      <a class="btn-primary" href="/editor">エディタを開く →</a>
      <a class="btn-secondary" href="https://github.com/cardene777/dragon" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
:root {
  --canvas: #f5f1e8;
  --surface: #fffdf7;
  --surface-2: #ede5d2;
  --line: #e0d9c8;
  --line-soft: #ece4d0;
  --ink: #1a1f2a;
  --ink-dim: #5a6270;
  --ink-mute: #8a8678;
  --brand: #2d6a8f;
  --brand-deep: #1f4d6e;
  --brand-glow: #4e9dc4;
  --accent-extended: #6d28d9;
  --radius: 12px;
  --radius-lg: 18px;
  --serif: "Newsreader", "EB Garamond", Georgia, serif;
  --sans: "Inter", -apple-system, "Segoe UI", sans-serif;
  --mono: "JetBrains Mono", ui-monospace, "SF Mono", monospace;
}
html.dark {
  --canvas: #0e1117;
  --surface: #161b22;
  --surface-2: #1f2630;
  --line: #2a3340;
  --line-soft: #1f2630;
  --ink: #f0f3f8;
  --ink-dim: #99a3b3;
  --ink-mute: #6b7785;
  --brand: #5ec4e8;
  --brand-deep: #4e9dc4;
  --brand-glow: #7dc7e8;
}
/* scope 内で完結、 他 page への影響 (nav / footer 等) は BaseLayout SSOT に委ねる */
main {
  background: var(--canvas);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "ss01", "cv11";
}
main a { color: inherit; text-decoration: none; }
main h1, main h2, main h3 { font-family: var(--serif); }
main h1 { font-weight: 600; letter-spacing: -0.03em; }
main h2 { font-weight: 600; letter-spacing: -0.02em; }
main h3 { font-weight: 500; letter-spacing: -0.015em; }
.mono { font-family: var(--mono); }

/* ── hero (タイトル + サブタイトル + CTA、 D2 / Mermaid 流の縦配置) ── */
.hero {
  max-width: 880px;
  margin: 0 auto;
  padding: 96px 32px 32px;
  text-align: center;
}
.hero-copy { display: flex; flex-direction: column; align-items: center; }
.hero-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--brand);
  margin-bottom: 22px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.hero-eyebrow .ver {
  background: rgba(45,106,143,0.1);
  padding: 2px 10px;
  border-radius: 99px;
  color: var(--brand-deep);
}
.hero h1 {
  font-family: var(--serif);
  font-size: 72px;
  line-height: 1.05;
  letter-spacing: -0.035em;
  font-weight: 500;
  margin-bottom: 22px;
}
.hero h1 em {
  font-style: italic;
  font-weight: 400;
  color: var(--brand-deep);
}
.hero p.lead {
  font-size: 17px;
  color: var(--ink-dim);
  line-height: 1.65;
  margin-bottom: 32px;
  max-width: 600px;
}
.hero-cta {
  display: flex;
  gap: 12px;
  justify-content: center;
}

/* ── 共通 button ── */
/* Neumorphism raised primary CTA (CAR-N-6、 scale hover + shadow deepen + active press) */
.btn-primary {
  padding: 14px 26px;
  background: var(--ink);
  color: var(--canvas);
  border-radius: 9px;
  font-size: 14px;
  font-family: var(--mono);
  letter-spacing: -0.02em;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition:
    transform 0.24s cubic-bezier(0.4, 0, 0.2, 1),
    background 0.18s ease,
    color 0.18s ease,
    box-shadow 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 4px 12px -2px rgba(30, 41, 59, 0.25),
    0 1px 0 rgba(255, 255, 255, 0.1) inset;
}
.btn-primary:hover {
  transform: translateY(-2px) scale(1.02);
  background: var(--brand-deep);
  color: var(--canvas);
  box-shadow:
    0 12px 24px -4px rgba(30, 41, 59, 0.35),
    0 1px 0 rgba(255, 255, 255, 0.15) inset;
}
.btn-primary:active {
  transform: translateY(0) scale(1);
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
}
.btn-secondary {
  padding: 14px 26px;
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink);
  border-radius: 9px;
  font-size: 14px;
  font-family: var(--mono);
  letter-spacing: -0.02em;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition:
    transform 0.24s cubic-bezier(0.4, 0, 0.2, 1),
    background 0.18s ease,
    color 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 2px 6px -2px rgba(30, 41, 59, 0.06),
    0 1px 0 rgba(255, 255, 255, 0.7) inset;
}
.btn-secondary:hover {
  transform: translateY(-2px) scale(1.02);
  background: var(--brand-deep);
  color: var(--canvas);
  border-color: var(--brand-deep);
  box-shadow:
    0 8px 16px -4px rgba(45, 106, 143, 0.32),
    0 1px 0 rgba(255, 255, 255, 0.15) inset;
}
.btn-secondary:active {
  transform: translateY(0) scale(1);
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.15);
}

/* ── hero demo (全幅 canvas、 D2 流) ── */
.hero-demo {
  max-width: 1180px;
  margin: 0 auto;
  padding: 16px 32px 64px;
}
.canvas {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow:
    0 1px 0 rgba(255,255,255,0.6) inset,
    0 30px 60px -30px rgba(26,31,42,0.18),
    0 18px 36px -18px rgba(45,106,143,0.15);
}
.canvas-bar {
  height: 40px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 1px solid var(--line-soft);
  background: var(--surface);
}
.canvas-bar .dots { display: flex; gap: 5px; }
.canvas-bar .dot { width: 9px; height: 9px; border-radius: 50%; }
.canvas-bar .dot.r { background: #f0a09e; }
.canvas-bar .dot.y { background: #f0c97a; }
.canvas-bar .dot.g { background: #a3d6a8; }
.canvas-bar .file {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--ink-mute);
  margin-left: 8px;
}
.canvas-bar .file b { color: var(--brand-deep); font-weight: 500; }
.canvas-bar .phase {
  margin-left: auto;
  font-family: var(--mono);
  font-size: 11.5px;
  color: var(--ink-mute);
  display: flex;
  gap: 6px;
  align-items: center;
}
.canvas-bar .phase .live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #a3d6a8;
  box-shadow: 0 0 8px #a3d6a8;
  animation: pulse 1.8s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.canvas-body {
  display: grid;
  grid-template-columns: 0.78fr 1fr;
  height: 480px;
}
@media (max-width: 720px) {
  .canvas-body { grid-template-columns: 1fr; height: auto; }
}
.canvas-code {
  background: #fcf8ee;
  padding: 18px 16px;
  font-family: var(--mono);
  font-size: 12px;
  line-height: 1.75;
  color: var(--ink);
  border-right: 1px solid var(--line-soft);
  white-space: pre;
  overflow: auto;
  position: relative;
}
@media (max-width: 720px) {
  .canvas-code { border-right: none; border-bottom: 1px solid var(--line-soft); }
}
.canvas-code .ln {
  color: var(--ink-mute);
  display: inline-block;
  width: 22px;
  text-align: right;
  margin-right: 10px;
  user-select: none;
  font-size: 11px;
}
.canvas-code .k { color: var(--brand-deep); }
.canvas-code .s { color: #6a8a3a; }

.canvas-code .hl-1, .canvas-code .hl-2, .canvas-code .hl-3, .canvas-code .hl-4 {
  background: transparent;
  display: inline-block;
  margin: 0 -4px;
  padding: 0 4px;
  border-radius: 3px;
}
.canvas-code .hl-1 { animation: hl1 5.6s steps(1) infinite; }
.canvas-code .hl-2 { animation: hl2 5.6s steps(1) infinite; }
.canvas-code .hl-3 { animation: hl3 5.6s steps(1) infinite; }
.canvas-code .hl-4 { animation: hl4 5.6s steps(1) infinite; }
@keyframes hl1 { 0%, 25% { background: rgba(45,106,143,0.15); } 25.01%, 100% { background: transparent; } }
@keyframes hl2 { 0%, 25% { background: transparent; } 25.01%, 50% { background: rgba(45,106,143,0.15); } 50.01%, 100% { background: transparent; } }
@keyframes hl3 { 0%, 50% { background: transparent; } 50.01%, 75% { background: rgba(167,139,255,0.18); } 75.01%, 100% { background: transparent; } }
@keyframes hl4 { 0%, 75% { background: transparent; } 75.01%, 100% { background: rgba(94,212,140,0.2); } }

.canvas-stage {
  background:
    repeating-linear-gradient(0deg, transparent 0 23px, rgba(26,31,42,0.04) 23px 24px),
    repeating-linear-gradient(90deg, transparent 0 23px, rgba(26,31,42,0.04) 23px 24px),
    #fcf8ee;
  display: grid;
  place-items: center;
  position: relative;
  min-height: 480px;
}
.canvas-stage svg { width: 100%; height: 100%; padding: 18px; }

/* sequence actor lifelines + msgs */
.lifeline { stroke: rgba(45,106,143,0.4); stroke-width: 1; stroke-dasharray: 4 3; }
.actor-box { fill: #fffdf7; stroke: var(--brand); stroke-width: 1.5; }
.actor-label { fill: #1a1f2a; font-weight: 600; font-size: 14px; }

.seq-msg {
  stroke-dasharray: 8 5;
  stroke-dashoffset: 0;
  fill: none;
  stroke-width: 2.2;
  opacity: 0;
}
.seq-msg-1 { animation: msg1 5.6s steps(1) infinite, dash-flow 0.8s linear infinite; }
.seq-msg-2 { animation: msg2 5.6s steps(1) infinite, dash-flow 0.8s linear infinite; }
.seq-msg-3 { animation: msg3 5.6s steps(1) infinite, dash-flow 0.8s linear infinite; }
.seq-msg-4 { animation: msg4 5.6s steps(1) infinite, dash-flow 0.8s linear infinite; }
@keyframes msg1 { 0%, 25% { opacity: 1; stroke: var(--brand-deep); } 25.01%, 100% { opacity: 0.18; stroke: var(--ink-mute); } }
@keyframes msg2 { 0%, 25% { opacity: 0; } 25.01%, 50% { opacity: 1; stroke: var(--brand-deep); } 50.01%, 100% { opacity: 0.18; stroke: var(--ink-mute); } }
@keyframes msg3 { 0%, 50% { opacity: 0; } 50.01%, 75% { opacity: 1; stroke: var(--accent-extended); } 75.01%, 100% { opacity: 0.18; stroke: var(--ink-mute); } }
