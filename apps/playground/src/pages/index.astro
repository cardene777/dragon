---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PresetMap } from "@/components/PresetMap";
---

<BaseLayout
  title="dragon — animated diagram DSL"
  description="Mermaid 感覚で書く animated SVG。 12 preset を map で探索、 click で即動かす。"
>
  <PresetMap client:load />
</BaseLayout>

<style is:global>
  body {
    margin: 0;
    overflow: hidden;
  }

  /* ─── map root ─── */
  .map-root {
    position: fixed;
    top: 56px;
    left: 0;
    right: 0;
    bottom: 0;
    background: #fcfcfd;
    overflow: hidden;
    font-feature-settings: "ss01" on, "cv11" on, "calt" on;
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
  }
  .map-root::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 50%, rgba(45, 106, 143, 0.05) 0%, transparent 55%),
      radial-gradient(circle at 20% 80%, rgba(194, 65, 12, 0.025) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(109, 40, 217, 0.025) 0%, transparent 40%),
      repeating-linear-gradient(0deg, transparent 0 39px, rgba(10, 14, 26, 0.04) 39px 40px),
      repeating-linear-gradient(90deg, transparent 0 39px, rgba(10, 14, 26, 0.04) 39px 40px);
    pointer-events: none;
  }
  html.dark .map-root {
    background: #0f1419;
  }
  html.dark .map-root::before {
    background:
      radial-gradient(circle at 50% 50%, rgba(74, 124, 143, 0.08) 0%, transparent 55%),
      repeating-linear-gradient(0deg, transparent 0 39px, rgba(255,255,255,0.04) 39px 40px),
      repeating-linear-gradient(90deg, transparent 0 39px, rgba(255,255,255,0.04) 39px 40px);
  }

  .map-canvas {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: grab;
    user-select: none;
    z-index: 1;
  }
  .map-canvas:active { cursor: grabbing; }
  .map-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-origin: 0 0;
    will-change: transform;
  }

  /* ─── cluster zones ─── */
  .cluster-zone {
    position: absolute;
    border-radius: 28px;
    pointer-events: none;
    z-index: 1;
  }
  .cluster-zone.cluster-basic {
    background: linear-gradient(180deg, rgba(45,106,143,0.05) 0%, transparent 100%);
    border: 1px dashed rgba(45,106,143,0.18);
  }
  .cluster-zone.cluster-domain {
    background: linear-gradient(180deg, rgba(194,65,12,0.05) 0%, transparent 100%);
    border: 1px dashed rgba(194,65,12,0.2);
  }
  .cluster-zone.cluster-extended {
    background: linear-gradient(180deg, rgba(109,40,217,0.05) 0%, transparent 100%);
    border: 1px dashed rgba(109,40,217,0.18);
  }
  .cluster-label {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    pointer-events: none;
    z-index: 3;
  }
  .cluster-label .num {
    background: rgba(255,255,255,0.9);
    padding: 1px 7px;
    border-radius: 4px;
    font-weight: 700;
    border: 1px solid currentColor;
    opacity: 0.75;
  }
  html.dark .cluster-label .num {
    background: rgba(15,20,25,0.9);
  }

  /* ─── edges ─── */
  .edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }
  .edges .edge-path {
    fill: none;
    stroke-width: 0.18;
    opacity: 0.55;
    stroke-dasharray: 0.6 0.6;
  }
  .edges .edge-basic { stroke: #2d6a8f; }
  .edges .edge-domain { stroke: #c2410c; stroke-width: 0.22; }
  .edges .edge-extended { stroke: #6d28d9; }

  /* ─── nodes ─── */
  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 170px;
    background: #fff;
    border-radius: 14px;
    padding: 14px 16px;
    border: 1px solid #e5e8ec;
    box-shadow: 0 1px 3px rgba(10,14,26,0.04), 0 8px 20px -8px rgba(10,14,26,0.1);
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s, border-color 0.2s;
    z-index: 5;
  }
  .node:hover {
    transform: translate(-50%, calc(-50% - 6px));
    box-shadow: 0 1px 3px rgba(10,14,26,0.04), 0 18px 36px -10px rgba(10,14,26,0.18);
  }
  .node-basic:hover { border-color: #2d6a8f; }
  .node-domain {
    background: linear-gradient(135deg, #fffaf2 0%, #fff 65%);
  }
  .node-domain:hover { border-color: #c2410c; }
  .node-extended {
    background: linear-gradient(135deg, #fdfaff 0%, #fff 65%);
  }
  .node-extended:hover { border-color: #6d28d9; }
  .node-selected {
    box-shadow: 0 0 0 2px currentColor, 0 18px 36px -10px rgba(10,14,26,0.25);
  }
  .node-basic.node-selected { color: #2d6a8f; border-color: #2d6a8f; }
  .node-domain.node-selected { color: #c2410c; border-color: #c2410c; }
  .node-extended.node-selected { color: #6d28d9; border-color: #6d28d9; }

  .node-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .node-icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .node-icon svg { width: 18px; height: 18px; }
  .icon-basic { background: #eaf3f7; color: #2d6a8f; }
  .icon-domain { background: #fef0e6; color: #c2410c; }
  .icon-extended { background: #f0e9ff; color: #6d28d9; }

  .node-label {
    font-weight: 700;
    font-size: 14.5px;
    letter-spacing: -0.015em;
    color: #0a0e1a;
  }
  .node-desc {
    font-size: 11.5px;
    color: #6b7785;
    line-height: 1.5;
  }
  .node-tag {
    font-size: 10px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    color: #6b7785;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid #f1f3f5;
    opacity: 0.8;
  }
  html.dark .node {
    background: #1a1f2a;
    border-color: rgba(255,255,255,0.08);
  }
  html.dark .node-label { color: #f5f5f7; }
  html.dark .node-desc, html.dark .node-tag { color: #99a3b3; }

  /* ─── center dragon ─── */
  .node-center {
    width: 200px;
    background: linear-gradient(140deg, #0a0e1a 0%, #1f2937 100%) !important;
    color: #fff !important;
    border-radius: 18px;
    padding: 22px;
    box-shadow:
      0 0 0 1px rgba(45,106,143,0.25),
      0 0 60px -10px rgba(45,106,143,0.35),
      0 24px 50px -16px rgba(10,14,26,0.5);
    text-align: center;
    animation: float 7s ease-in-out infinite;
    z-index: 10;
  }
  @keyframes float {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50% { transform: translate(-50%, -50%) translateY(-8px); }
  }
  .node-center:hover {
    transform: translate(-50%, -50%) translateY(-4px) !important;
  }
  .center-glyph {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #2d6a8f 0%, #1f4d6e 100%);
    border-radius: 14px;
    display: grid;
    place-items: center;
    margin: 0 auto 12px;
    box-shadow: 0 8px 20px -4px rgba(45,106,143,0.6);
  }
  .center-glyph svg { width: 28px; height: 28px; }
  .center-title {
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.025em;
    margin-bottom: 4px;
  }
  .center-meta {
    font-size: 11px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    color: rgba(255,255,255,0.5);
    margin-bottom: 14px;
  }
  .center-btn {
    display: block;
    width: 100%;
    padding: 9px 14px;
    background: linear-gradient(135deg, #2d6a8f 0%, #1f4d6e 100%);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    letter-spacing: -0.005em;
    box-shadow: 0 4px 12px -2px rgba(45,106,143,0.5);
    transition: all 0.15s;
  }
  .center-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -2px rgba(45,106,143,0.7);
  }

  /* ─── search ─── */
  .map-search {
    position: fixed;
    top: 76px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
  }
  .map-search input {
    width: 380px;
    padding: 11px 18px 11px 42px;
    font-size: 13.5px;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(229,232,236,0.8);
    border-radius: 12px;
    outline: none;
    color: #0a0e1a;
    box-shadow: 0 1px 3px rgba(10,14,26,0.04), 0 8px 20px -8px rgba(10,14,26,0.1);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='%236b7785' stroke-width='2' stroke-linecap='round'><circle cx='11' cy='11' r='8'/><path d='m21 21-4.3-4.3'/></svg>");
    background-repeat: no-repeat;
    background-position: 16px center;
  }
  .map-search input::placeholder { color: #6b7785; }
  html.dark .map-search input {
    background: rgba(26,31,42,0.95);
    border-color: rgba(255,255,255,0.08);
    color: #f5f5f7;
  }

  /* ─── stats (left top) ─── */
  .map-stats {
    position: fixed;
    top: 76px;
    left: 24px;
    z-index: 20;
    display: flex;
    gap: 6px;
  }
  .stat-pill {
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border: 1px solid #e5e8ec;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 11px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    color: #6b7785;
    box-shadow: 0 1px 3px rgba(10,14,26,0.04);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .stat-pill .num { font-weight: 700; color: #0a0e1a; font-size: 13px; }
  .stat-pill .dot { width: 6px; height: 6px; border-radius: 50%; }
  .stat-pill.basic .dot { background: #2d6a8f; }
  .stat-pill.domain .dot { background: #c2410c; }
  .stat-pill.extended .dot { background: #6d28d9; }
  html.dark .stat-pill {
    background: rgba(26,31,42,0.95);
    border-color: rgba(255,255,255,0.08);
    color: #99a3b3;
  }
  html.dark .stat-pill .num { color: #f5f5f7; }

  /* ─── hint ─── */
  .map-hint {
    position: fixed;
    top: 76px;
    right: 24px;
    z-index: 20;
    font-size: 11px;
    color: #6b7785;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border: 1px solid #e5e8ec;
    border-radius: 10px;
    padding: 10px 14px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-shadow: 0 1px 3px rgba(10,14,26,0.04);
  }
  .hint-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .map-hint kbd {
    background: #f1f3f5;
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 10px;
    border: 1px solid #e5e8ec;
    min-width: 18px;
    text-align: center;
  }
  html.dark .map-hint {
    background: rgba(26,31,42,0.95);
    color: #99a3b3;
    border-color: rgba(255,255,255,0.08);
  }
  html.dark .map-hint kbd {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.1);
    color: #f5f5f7;
  }

  /* ─── controls ─── */
  .map-controls {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 20;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border: 1px solid #e5e8ec;
    border-radius: 12px;
    padding: 4px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 3px rgba(10,14,26,0.04), 0 4px 12px -2px rgba(10,14,26,0.06);
  }
  .map-controls button {
    width: 36px;
    height: 32px;
    background: transparent;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    color: #0a0e1a;
    cursor: pointer;
    transition: background 0.15s;
  }
  .map-controls button:hover { background: #f1f3f5; }
  .map-zoom-display {
    font-size: 9.5px;
    text-align: center;
    color: #6b7785;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    padding: 4px 0 2px;
  }
  html.dark .map-controls {
    background: rgba(26,31,42,0.95);
    border-color: rgba(255,255,255,0.08);
  }
  html.dark .map-controls button { color: #f5f5f7; }
  html.dark .map-controls button:hover { background: rgba(255,255,255,0.05); }
  html.dark .map-zoom-display { color: #99a3b3; }

  /* ─── minimap (右下から左下に移動して mind node と被らないように) ─── */
  .map-minimap {
    position: fixed;
    bottom: 24px;
    left: 70px;
    z-index: 20;
    width: 160px;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border: 1px solid #e5e8ec;
    border-radius: 12px;
    box-shadow: 0 1px 3px rgba(10,14,26,0.04), 0 4px 12px -2px rgba(10,14,26,0.06);
    overflow: hidden;
  }
  .minimap-head {
    padding: 8px 12px;
    border-bottom: 1px solid #f1f3f5;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #6b7785;
    text-transform: uppercase;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .minimap-head .live-dot {
    width: 6px;
    height: 6px;
    background: #2d6a8f;
    border-radius: 50%;
    box-shadow: 0 0 8px #2d6a8f;
  }
  .map-minimap svg {
    width: 100%;
    height: 110px;
    padding: 8px;
  }
  html.dark .map-minimap {
    background: rgba(26,31,42,0.95);
    border-color: rgba(255,255,255,0.08);
  }
  html.dark .minimap-head { color: #99a3b3; border-color: rgba(255,255,255,0.06); }

  /* ─── modal ─── */
  .map-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10,14,26,0.5);
    backdrop-filter: blur(6px);
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 32px;
    animation: fadein 0.15s ease;
  }
  @keyframes fadein {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .map-modal {
    background: #fff;
    border-radius: 18px;
    padding: 28px 32px;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 30px 60px -10px rgba(10,14,26,0.4);
  }
  html.dark .map-modal { background: #1a1f2a; color: #f5f5f7; }
  .map-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    font-size: 24px;
    color: #6b7785;
    cursor: pointer;
    border-radius: 8px;
  }
  .map-modal-close:hover { background: #f1f3f5; }
  html.dark .map-modal-close:hover { background: rgba(255,255,255,0.05); }
  .map-modal-head {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }
  .map-modal-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .map-modal-icon svg { width: 24px; height: 24px; }
  .map-modal h2 {
    font-size: 26px;
    font-weight: 800;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
  }
  .map-modal-meta {
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 12px;
    color: #6b7785;
  }
  .map-modal-desc {
    font-size: 14px;
    color: #4a525e;
    margin-bottom: 24px;
    line-height: 1.7;
  }
  html.dark .map-modal-desc { color: #99a3b3; }
  .map-modal-preview {
    border: 1px solid #e5e8ec;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 20px;
    background: #f8f9fa;
  }
  html.dark .map-modal-preview {
    background: #0f1419;
    border-color: rgba(255,255,255,0.08);
  }
  .map-modal-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .map-modal-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.15s;
  }
  .map-modal-btn.primary {
    background: linear-gradient(135deg, #2d6a8f 0%, #1f4d6e 100%);
    color: #fff;
    box-shadow: 0 4px 12px -2px rgba(45,106,143,0.4);
  }
  .map-modal-btn.primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -2px rgba(45,106,143,0.6);
  }
  .map-modal-btn.ghost {
    background: transparent;
    color: #0a0e1a;
    border: 1px solid #e5e8ec;
  }
  .map-modal-btn.ghost:hover { background: #f1f3f5; }
  html.dark .map-modal-btn.ghost { color: #f5f5f7; border-color: rgba(255,255,255,0.08); }
  html.dark .map-modal-btn.ghost:hover { background: rgba(255,255,255,0.05); }
</style>
