---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlDiagramThumbnail } from "@cardenelabs/cdl";
import {
  apiCall, jwtAuth, oauthFlow, rateLimit, csrfToken,
  crudCreate, pagination, cacheReadThrough, searchQuery, sortFilter,
  formSubmit, fileUpload, sseStream, websocket, notification,
  backgroundJob, retryBackoff, webhook, polling, scheduledTask,
  auditLog, emailNotification, exportData, importData, healthCheck,
} from "@/topics/catalog/cookbook.cdl";

const groups = [
  {
    title: "A. API / Auth (5 例)",
    desc: "REST GET / JWT / OAuth / Rate limit / CSRF token。 web service の入り口で頻出する 5 例。",
    items: [
      { label: "A-1. REST API GET", d: apiCall },
      { label: "A-2. JWT auth", d: jwtAuth },
      { label: "A-3. OAuth code flow", d: oauthFlow },
      { label: "A-4. Rate limit (429)", d: rateLimit },
      { label: "A-5. CSRF token", d: csrfToken },
    ],
  },
  {
    title: "B. データ操作 (5 例)",
    desc: "CRUD create / cursor pagination / read-through cache / 全文検索 / sort + filter。",
    items: [
      { label: "B-1. CRUD create", d: crudCreate },
      { label: "B-2. Cursor pagination", d: pagination },
      { label: "B-3. Cache read-through", d: cacheReadThrough },
      { label: "B-4. Search full-text", d: searchQuery },
      { label: "B-5. Sort + Filter", d: sortFilter },
    ],
  },
  {
    title: "C. UI / フォーム (5 例)",
    desc: "form submit / file upload / SSE / WebSocket / notification。 frontend と server の interaction。",
    items: [
      { label: "C-1. Form submit", d: formSubmit },
      { label: "C-2. File upload", d: fileUpload },
      { label: "C-3. SSE stream", d: sseStream },
      { label: "C-4. WebSocket", d: websocket },
      { label: "C-5. Notification", d: notification },
    ],
  },
  {
    title: "D. 非同期 / バックグラウンド (5 例)",
    desc: "background job / retry + backoff / webhook / polling / scheduled task。 非同期処理の基本骨格。",
    items: [
      { label: "D-1. Background job", d: backgroundJob },
      { label: "D-2. Retry + backoff", d: retryBackoff },
      { label: "D-3. Webhook", d: webhook },
      { label: "D-4. Long polling", d: polling },
      { label: "D-5. Scheduled task", d: scheduledTask },
    ],
  },
  {
    title: "E. 運用 / 配信 (5 例)",
    desc: "audit log / email / export / import / health check。 運用 / SRE 視点で頻出する 5 例。",
    items: [
      { label: "E-1. Audit log", d: auditLog },
      { label: "E-2. Email notification", d: emailNotification },
      { label: "E-3. Export CSV", d: exportData },
      { label: "E-4. Import CSV", d: importData },
      { label: "E-5. Health check", d: healthCheck },
    ],
  },
];
const cookbookHref = "/docs/cdl/overview/cookbook";
---

<BaseLayout title="Catalog - Cookbook - dragon">
  <section class="shell pt-12 pb-8">
    <div class="space-y-4">
      <nav aria-label="パンくず" class="flex items-center gap-1.5 text-xs font-medium text-nm-text-muted">
        <a href="/" class="text-nm-text-secondary hover:text-nm-accent no-underline">トップ</a>
        <span aria-hidden="true">/</span>
        <a href="/catalog" class="text-nm-text-secondary hover:text-nm-accent no-underline">Catalog</a>
        <span aria-hidden="true">/</span>
        <span class="text-nm-text">Cookbook</span>
      </nav>
      <span class="section-eyebrow">Catalog / Cookbook</span>
      <h1 class="heading-h1">Cookbook</h1>
      <p class="max-w-3xl text-base text-nm-text-secondary leading-relaxed">
        cdl Text DSL v0.5 で書いた一般 web 開発の頻出 25 例 (API/Auth 5 / データ操作 5 / UI 5 / 非同期 5 / 運用 5)。
        各 thumbnail は <a href={cookbookHref} class="text-nm-accent underline">Cookbook ドキュメント</a> の対応 entry が <code>[preview:cookbook/&lt;slug&gt;]</code> で参照しています。
      </p>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="shell pb-10">
        <div class="space-y-2 mb-5">
          <h2 class="heading-h2">{g.title}</h2>
          <p class="text-sm text-nm-text-secondary">{g.desc}</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {g.items.map((item) => (
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-3">
                <div class="text-xl font-bold text-nm-text tracking-tight">{item.label}</div>
                <a href={cookbookHref} class="catalog-doc-link shrink-0" aria-label="Cookbook ドキュメント">
                  <span aria-hidden="true">📖</span>
                  <span>ドキュメント</span>
                </a>
              </div>
              <div class="catalog-thumb-wrap overflow-hidden rounded-nm shadow-nm-raised relative">
                <a href={cookbookHref} class="catalog-thumb-doc-link" aria-label="Cookbook ドキュメント" title="Cookbook を見る">📖</a>
                <div class="catalog-thumb-inner">
                  <CdlDiagramThumbnail client:load diagram={item.d} hideHeader />
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
  <style is:global>
    .catalog-doc-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #c17f3e;
      background: rgba(193, 127, 62, 0.1);
      border: 1px solid rgba(193, 127, 62, 0.3);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s, transform 0.15s;
    }
    .catalog-doc-link:hover {
      background: rgba(193, 127, 62, 0.18);
      transform: translateY(-1px);
    }
    .catalog-thumb-doc-link {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      font-size: 16px;
      background: rgba(232, 221, 208, 0.95);
      border: 1px solid rgba(196, 185, 172, 0.6);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s, transform 0.15s;
      z-index: 5;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    }
    .catalog-thumb-doc-link:hover {
      background: rgba(193, 127, 62, 0.18);
      transform: scale(1.08);
    }
    /* card 囲いサイズ統一 (全 25 例で同じ高さ) */
    .catalog-thumb-wrap {
      aspect-ratio: 16 / 9;
      width: 100%;
      background: var(--color-nm-surface, #f5ede2);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .catalog-thumb-inner {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .catalog-thumb-inner > * {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
  </style>
</BaseLayout>
