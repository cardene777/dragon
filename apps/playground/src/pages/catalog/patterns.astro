---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlDiagramThumbnail } from "@cardenelabs/cdl";
import {
  patternDirect, patternPassthrough,
  patternCallReadWrite, patternEmit, patternHook,
  patternBranch, patternLoop,
  patternFanOut, patternFanIn,
  patternRollback, patternSchedule, patternValidateProcess,
} from "@/topics/catalog/patterns.cdl";

const groups = [
  {
    title: "Edge 経路パターン",
    desc: "直結と経由貫通の挙動差。 cdl は edge path 上に node があれば auto で貫通動作。",
    items: [
      { label: "直結 (隣接 node)", d: patternDirect },
      { label: "経由 node 貫通 (自動判定)", d: patternPassthrough },
    ],
  },
  {
    title: "関数内部処理",
    desc: "call → read → write → emit のような関数実行の典型フロー、 hook callback。",
    items: [
      { label: "call → read → write", d: patternCallReadWrite },
      { label: "emit event", d: patternEmit },
      { label: "Hook callback (受信側問合せ)", d: patternHook },
    ],
  },
  {
    title: "制御フロー",
    desc: "if/else 分岐、 繰り返し処理。 任意の処理 chain に組込んで動作分岐を表現。",
    items: [
      { label: "Branch (条件分岐)", d: patternBranch },
      { label: "Loop (繰り返し処理)", d: patternLoop },
    ],
  },
  {
    title: "並列 / 集約",
    desc: "1 入力を複数 worker に分配 → 結果集約。 job queue / map-reduce 系の基本骨格。",
    items: [
      { label: "Fan-out (1 入力 → 複数 worker)", d: patternFanOut },
      { label: "Fan-in (複数 worker → 集約)", d: patternFanIn },
    ],
  },
  {
    title: "障害 / スケジューリング / 検証",
    desc: "失敗時の rollback、 cron による定期実行、 input validation。 運用で頻出する pattern。",
    items: [
      { label: "Rollback (失敗時巻き戻し)", d: patternRollback },
      { label: "Schedule (定期実行)", d: patternSchedule },
      { label: "Validate → Process (検証後処理)", d: patternValidateProcess },
    ],
  },
];
---

<BaseLayout title="Catalog - Patterns - dragon">
  <section class="shell pt-12 pb-8">
    <div class="space-y-4">
      <nav aria-label="パンくず" class="flex items-center gap-1.5 text-xs font-medium text-nm-text-muted">
        <a href="/" class="text-nm-text-secondary hover:text-nm-accent no-underline">トップ</a>
        <span aria-hidden="true">/</span>
        <a href="/catalog" class="text-nm-text-secondary hover:text-nm-accent no-underline">Catalog</a>
        <span aria-hidden="true">/</span>
        <span class="text-nm-text">Patterns</span>
      </nav>
      <span class="section-eyebrow">Catalog / Patterns</span>
      <h1 class="heading-h1">Patterns</h1>
      <p class="max-w-3xl text-base text-nm-text-secondary leading-relaxed">
        一般的な web 開発で頻出する構成パターン。 ここの diagram は実 topic の小さい sample として参考にできます。
      </p>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="shell pb-10">
        <div class="space-y-2 mb-5">
          <h2 class="heading-h2">{g.title}</h2>
          <p class="text-sm text-nm-text-secondary">{g.desc}</p>
        </div>
        <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
          {g.items.map((item) => (
            <article class="catalog-card">
              <header class="catalog-card-head">
                <div class="catalog-card-title">{item.label}</div>
              </header>
              <div class="catalog-card-body">
                <CdlDiagramThumbnail client:load diagram={item.d} hideHeader />
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
  <style is:global>
    .catalog-doc-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #c17f3e;
      background: rgba(193, 127, 62, 0.1);
      border: 1px solid rgba(193, 127, 62, 0.3);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s, transform 0.15s;
    }
    .catalog-doc-link:hover {
      background: rgba(193, 127, 62, 0.18);
      transform: translateY(-1px);
    }
    .catalog-thumb-doc-link {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      font-size: 16px;
      background: rgba(232, 221, 208, 0.95);
      border: 1px solid rgba(196, 185, 172, 0.6);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s, transform 0.15s;
      z-index: 5;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    }
    .catalog-thumb-doc-link:hover {
      background: rgba(193, 127, 62, 0.18);
      transform: scale(1.08);
    }
  </style>
</BaseLayout>
