---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlDiagramView } from "@cardenelabs/cdl";
import {
  textDslSequence,
  textDslFlow,
  textDslSwimlane,
  textDslStateMachine,
  textDslTopology,
  textDslEr,
} from "@/topics/catalog/text-dsl.cdl";

const SEQ_DSL = `タイトル: API call (DSL)
種類: sequence

登場人物:
  - Client
  - API (function)
  - DB (storage)

流れ:
  1. Client → API: GET /items (情報)
  2. API → DB: SELECT (成功)

アニメーション:
  状態: request_count = 0
  状態: row_count = 0

  ステップ「step1」 1.5 秒:
    強調: Client, API
    遷移: request_count: 0 → 1

  ステップ「step2」 1.5 秒:
    強調: API, DB
    遷移: row_count: 0 → 20`;

const FLOW_DSL = `タイトル: 認証フロー (DSL)
種類: flow

登場人物:
  - 開始 (event)
  - 検証 (function)
  - 完了 (event)

流れ:
  1. 開始 → 検証: 入力
  2. 検証 → 完了: OK (成功)

アニメーション:
  状態: progress = 0
  ステップ「処理中」 1 秒:
    強調: 開始, 検証
    遷移: progress: 0 → 50
  ステップ「完了」 1 秒:
    強調: 検証, 完了
    遷移: progress: 50 → 100`;

const SWIM_DSL = `タイトル: 並列処理 (DSL)
種類: swimlane

登場人物:
  - Service A (service)
  - Service B (service)
  - Service C (service)

流れ:
  1. Service A → Service B: dispatch (情報)
  2. Service B → Service C: forward (成功)

アニメーション:
  ステップ「dispatch」 1.5 秒:
    強調: Service A→Service B
  ステップ「forward」 1.5 秒:
    強調: Service B→Service C`;

const STATE_DSL = `タイトル: 認証 FSM (DSL)
種類: state

登場人物:
  - Idle
  - Loading
  - Done
  - Error

流れ:
  1. Idle → Loading: submit
  2. Loading → Done: success (成功)
  3. Loading → Error: fail (失敗)

アニメーション:
  状態: counter = 0
  ステップ「submit」 1 秒:
    強調: Idle, Idle→Loading
    遷移: counter: 0 → 1
  ステップ「success」 1 秒:
    強調: Loading, Loading→Done
    遷移: counter: 1 → 2`;

const TOPO_DSL = `タイトル: System (DSL)
種類: topology

登場人物:
  - Browser (service)
  - API (service)
  - DB (database)

流れ:
  1. Browser → API: HTTPS
  2. API → DB: SQL

アニメーション:
  ステップ「request」 1 秒:
    強調: Browser, API
  ステップ「query」 1 秒:
    強調: API, DB`;

const ER_DSL = `タイトル: スキーマ (DSL)
種類: er

登場人物:
  - User
  - Order

流れ:
  1. User → Order: places (1:N)

アニメーション:
  ステップ「show」 1 秒:
    強調: User, Order`;

const items = [
  {
    label: "sequence + animation ... API call フロー (DSL v0.3)",
    d: textDslSequence,
    docHref: "/docs/cdl/text-dsl-spec",
    description: "actors 3 人 + 2 phase + tween (request_count / row_count) を箇条書き DSL から compile",
    dsl: SEQ_DSL,
  },
  {
    label: "flow + animation ... 認証フロー (DSL v0.4)",
    d: textDslFlow,
    docHref: "/docs/cdl/text-dsl-spec",
    description: "1 lane に 3 step 縦並び + progress 0→100 tween",
    dsl: FLOW_DSL,
  },
  {
    label: "swimlane + animation ... 並列処理 (DSL v0.4)",
    d: textDslSwimlane,
    docHref: "/docs/cdl/text-dsl-spec",
    description: "3 service を別 lane で配置、 dispatch → forward を順次強調",
    dsl: SWIM_DSL,
  },
  {
    label: "state + animation ... 認証 FSM (DSL v0.4)",
    d: textDslStateMachine,
    docHref: "/docs/cdl/text-dsl-spec",
    description: "Idle/Loading/Done/Error、 初期=Idle、 最終=Error が自動 eyebrow",
    dsl: STATE_DSL,
  },
  {
    label: "topology + animation ... システム構成 (DSL v0.4)",
    d: textDslTopology,
    docHref: "/docs/cdl/text-dsl-spec",
    description: "1 group (contain=true) に Browser/API/DB、 request → query 順次強調",
    dsl: TOPO_DSL,
  },
  {
    label: "er + animation ... ER 図 (DSL v0.4)",
    d: textDslEr,
    docHref: "/docs/cdl/text-dsl-spec",
    description: "User → Order (1:N cardinality 自動)",
    dsl: ER_DSL,
  },
];
---

<BaseLayout title="Catalog - dragon DSL - dragon">
  <section class="shell pt-12 pb-8">
    <div class="space-y-4">
      <nav aria-label="パンくず" class="flex items-center gap-1.5 text-xs font-medium text-nm-text-muted">
        <a href="/" class="text-nm-text-secondary hover:text-nm-accent no-underline">トップ</a>
        <span aria-hidden="true">/</span>
        <a href="/catalog" class="text-nm-text-secondary hover:text-nm-accent no-underline">Catalog</a>
        <span aria-hidden="true">/</span>
        <span class="text-nm-text">dragon DSL</span>
      </nav>
      <span class="section-eyebrow">Catalog / dragon DSL (v0.5)</span>
      <h1 class="heading-h1">dragon DSL Demo</h1>
      <p class="max-w-3xl text-base text-nm-text-secondary leading-relaxed">
        「タイトル / 種類 / 登場人物 / 流れ / アニメーション」 の <strong>5 ブロック箇条書き</strong> で書いた dragon DSL から、
        <strong>動画として再生される animated SVG</strong> が 6 preset すべてで生成されることを実機 visual 確認できる場。
        <br />
        非エンジニア / LLM / 人手 3 軸で書ける、 v0.5 で animation も含めた full 表現に到達。
        parse + compile は @cardenelabs/dragon、 render は @cardenelabs/cdl engine。
      </p>
      <div class="max-w-3xl rounded-lg border border-nm-accent/30 bg-nm-accent/5 px-4 py-3 text-sm text-nm-text-secondary">
        <strong class="text-nm-accent">▶ 動作確認のポイント</strong>
        <ul class="mt-1 list-disc pl-5 space-y-0.5">
          <li>各 demo は <strong>auto-play</strong> ... step1 → step2 → 繰返し、 phase ナビが上に表示</li>
          <li>右上の差分パネルで <strong>state の数値変化</strong> (例 alice残高 100→90) がリアルタイム表示</li>
          <li>active 要素は orange / teal で <strong>強調表示</strong>、 inactive は灰色 muted</li>
          <li>edge ラベル (deposit / send / dispatch / 等) は <strong>常時 visible</strong>、 active phase で flow 矢印</li>
        </ul>
      </div>
      <div class="flex gap-3 text-sm">
        <a href="/docs/cdl/text-dsl-spec" class="catalog-doc-link">
          <span aria-hidden="true">📖</span><span>DSL 仕様書</span>
        </a>
        <a href="/docs/cdl/text-dsl-llm-guide" class="catalog-doc-link">
          <span aria-hidden="true">🤖</span><span>LLM 生成ガイド</span>
        </a>
      </div>
    </div>
  </section>

  <section class="shell pb-24">
    <div class="space-y-8">
      {
        items.map((item) => (
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-3">
              <div>
                <div class="text-xl font-bold text-nm-text tracking-tight">{item.label}</div>
                <p class="text-sm text-nm-text-secondary mt-1">{item.description}</p>
              </div>
              <a
                href={item.docHref}
                class="catalog-doc-link shrink-0"
                aria-label={`${item.label} のドキュメントへ`}
              >
                <span aria-hidden="true">📖</span>
                <span>ドキュメント</span>
              </a>
            </div>
            <div class="catalog-thumb-wrap overflow-hidden rounded-nm shadow-nm-raised relative">
              <a href={item.docHref} class="catalog-thumb-doc-link" aria-label="ドキュメント" title="ドキュメントを見る">📖</a>
              <CdlDiagramView client:load diagram={item.d} />
            </div>
            <details class="catalog-dsl-source">
              <summary>
                <span aria-hidden="true">📝</span>
                <span>この DSL を見る (この箇条書きから上の animation が生成されてる)</span>
              </summary>
              <pre><code>{item.dsl}</code></pre>
            </details>
          </div>
        ))
      }
    </div>
  </section>
  <style is:global>
    .catalog-doc-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #c17f3e;
      background: rgba(193, 127, 62, 0.1);
      border: 1px solid rgba(193, 127, 62, 0.3);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s, transform 0.15s;
    }
    .catalog-doc-link:hover {
      background: rgba(193, 127, 62, 0.18);
      transform: translateY(-1px);
    }
    .catalog-thumb-doc-link {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      font-size: 16px;
      background: rgba(232, 221, 208, 0.95);
      border: 1px solid rgba(196, 185, 172, 0.6);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s, transform 0.15s;
      z-index: 5;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    }
    .catalog-thumb-doc-link:hover {
      background: rgba(193, 127, 62, 0.18);
      transform: scale(1.08);
    }
    .catalog-dsl-source {
      margin-top: 8px;
      border: 1px solid rgba(196, 185, 172, 0.4);
      border-radius: 8px;
      background: rgba(245, 237, 227, 0.4);
      overflow: hidden;
    }
    .catalog-dsl-source > summary {
      cursor: pointer;
      padding: 10px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #6b5e52;
      display: flex;
      align-items: center;
      gap: 8px;
      list-style: none;
      transition: background 0.15s;
    }
    .catalog-dsl-source > summary::-webkit-details-marker { display: none; }
    .catalog-dsl-source > summary:hover {
      background: rgba(193, 127, 62, 0.08);
      color: #c17f3e;
    }
    .catalog-dsl-source[open] > summary {
      background: rgba(193, 127, 62, 0.06);
      color: #c17f3e;
      border-bottom: 1px solid rgba(196, 185, 172, 0.3);
    }
    .catalog-dsl-source > pre {
      margin: 0;
      padding: 14px 18px;
      background: transparent !important;
      font-family: "Fira Code", monospace;
      font-size: 12.5px;
      line-height: 1.6;
      color: #3d3229;
      overflow-x: auto;
    }
  </style>
</BaseLayout>
