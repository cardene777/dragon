---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlDiagramThumbnail } from "@cardenelabs/cdl";
import {
  styleSolid, styleDottedFlow,
  toneAccent, toneTeal, toneSuccess, toneError, toneWarning, toneInfo,
  stateActive, stateInactive,
} from "@/topics/catalog/styles.cdl";

const groups = [
  {
    title: "EdgeStyle 2 種",
    desc: "solid (実線 + 矢頭、 progress 連動で伸びる) と dotted-flow (点線 + 進行点 glow)。",
    items: [
      { label: "solid", d: styleSolid },
      { label: "dotted-flow", d: styleDottedFlow },
    ],
  },
  {
    title: "Tone 全 6 種",
    desc: "active 時の color 比較。 各 tone が edge と関連 node に同時 active 化。",
    items: [
      { label: "accent", d: toneAccent },
      { label: "teal", d: toneTeal },
      { label: "success", d: toneSuccess },
      { label: "error", d: toneError },
      { label: "warning", d: toneWarning },
      { label: "info", d: toneInfo },
    ],
  },
  {
    title: "Active / Inactive 状態",
    desc: "phase で activate されている要素は太く + 色付き、 そうでないものは薄い灰色 dash で静的。",
    items: [
      { label: "active", d: stateActive },
      { label: "inactive", d: stateInactive },
    ],
  },
];
---

<BaseLayout title="Catalog - Styles - dragon">
  <section class="shell pt-12 pb-8">
    <div class="space-y-4">
      <nav aria-label="パンくず" class="flex items-center gap-1.5 text-xs font-medium text-nm-text-muted">
        <a href="/" class="text-nm-text-secondary hover:text-nm-accent no-underline">トップ</a>
        <span aria-hidden="true">/</span>
        <a href="/catalog" class="text-nm-text-secondary hover:text-nm-accent no-underline">Catalog</a>
        <span aria-hidden="true">/</span>
        <span class="text-nm-text">Styles</span>
      </nav>
      <span class="section-eyebrow">Catalog / Styles</span>
      <h1 class="heading-h1">Styles</h1>
      <p class="max-w-3xl text-base text-nm-text-secondary leading-relaxed">
        edge の見た目バリエーション。 EdgeStyle / Tone / Active 状態。
      </p>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="shell pb-10">
        <div class="space-y-2 mb-5">
          <h2 class="heading-h2">{g.title}</h2>
          <p class="text-sm text-nm-text-secondary">{g.desc}</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {g.items.map((item) => (
            <div class="space-y-2">
              <div class="text-xl font-bold text-nm-text tracking-tight">{item.label}</div>
              <div class="overflow-hidden rounded-nm shadow-nm-raised">
                <CdlDiagramThumbnail client:load diagram={item.d} hideHeader />
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
