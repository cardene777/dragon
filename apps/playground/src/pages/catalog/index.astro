---
import BaseLayout from "@/layouts/BaseLayout.astro";

const categories = [
  {
    href: "/catalog/presets",
    label: "presets",
    desc: "図の高位API。sequence / flow / swimlane / topology / er / stateなど、1行宣言でよくある構造を書ける。",
    items: ["sequence", "flow", "swimlane", "topology", "er", "stateMachine"],
    cluster: "basic",
  },
  {
    href: "/catalog/cookbook",
    label: "cookbook",
    desc: "現場で使える完全レシピ。API call / 認証 / CRUD / 非同期 / 運用などをコピペで動かせる。",
    items: ["API / Auth", "データ操作", "UI / フォーム", "非同期", "運用"],
    cluster: "basic",
  },
  {
    href: "/catalog/patterns",
    label: "patterns",
    desc: "汎用の構成パターン集。直結 / 経由 / 分岐 / ループ / Fan-out / Rollbackなど、図の組み立て方の型。",
    items: ["Direct", "Branch", "Loop", "Fan-out", "Rollback", "Schedule"],
    cluster: "basic",
  },
  {
    href: "/catalog/primitives",
    label: "primitives",
    desc: "図の最小パーツ。actor / function / storageなど基本5種 + 人 / インフラ / アプリ系のNodeKindをまとめて。",
    items: ["NodeKind", "Lane", "Stack"],
    cluster: "extended",
  },
  {
    href: "/catalog/text-dsl",
    label: "text-dsl",
    desc: "5ブロックの箇条書きで書けるdragon DSLの動作確認場。sequence / flow / state / topology / erなどをそのまま試せる。",
    items: ["sequence", "flow", "swimlane", "state", "topology", "er"],
    cluster: "extended",
  },
  {
    href: "/catalog/animation",
    label: "animation",
    desc: "phase / state / tween / set / badgeの動作確認。数値補間 / 即時切替 / 連続phase / バッジ切替。",
    items: ["Tween", "Set", "Badge", "Tween + Set"],
    cluster: "extended",
  },
  {
    href: "/catalog/styles",
    label: "styles",
    desc: "edge種類 (solid / dotted-flow) とtone 6種 (accent / teal / success / error / warning / info)、active / inactive状態。",
    items: ["EdgeStyle", "Tone", "Active / Inactive"],
    cluster: "extended",
  },
];
---

<BaseLayout title="catalog · dragon">
  <section class="v4-cat-hero">
    <nav class="v4-crumb" aria-label="パンくず">
      <a href="/">overview</a>
      <span>/</span>
      <span class="cur">catalog</span>
    </nav>
    <span class="v4-eyebrow">primitives · presets · animation · patterns</span>
    <h1>
      すべてのpresetを、<em>動かしながら</em>読む。
    </h1>
    <p class="v4-lead">
      dragon DSLのprimitives / styles / animation / patternsを7カテゴリで整理。各カテゴリに小さい図を並べて、1概念ずつ動作確認できる。engine層は<code>@cardenelabs/cdl</code>が担う。
    </p>
  </section>

  <section class="v4-cat-grid">
    {
      categories.map((c) => (
        <a href={c.href} class={`v4-cat-card v4-cat-${c.cluster}`}>
          <div class="v4-cat-head">
            <span class="v4-cat-tag">{c.cluster}</span>
            <h2>{c.label}</h2>
          </div>
          <p>{c.desc}</p>
          <div class="v4-cat-chips">
            {c.items.map((i) => (
              <span class="v4-cat-chip">{i}</span>
            ))}
          </div>
          <div class="v4-cat-go">
            <span>open</span>
            <span class="arrow">→</span>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  /* Neumorphism catalog hero (CAR-N-6、 Vercel 風 大きめ typography + Stripe 風 spacing 呼吸感) */
  .v4-cat-hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 64px 32px 36px;
  }
  @media (max-width: 720px) {
    .v4-cat-hero {
      padding: 40px 20px 24px;
    }
  }
  .v4-crumb {
    display: flex;
    gap: 8px;
    font-family: var(--v4-mono);
    font-size: 11.5px;
    color: var(--v4-ink-mute);
    margin-bottom: 20px;
    letter-spacing: 0.02em;
  }
  .v4-crumb a {
    color: var(--v4-ink-dim);
    text-decoration: none;
  }
  .v4-crumb a:hover {
    color: var(--v4-brand-deep);
  }
  .v4-crumb .cur {
    color: var(--v4-ink);
  }
  .v4-eyebrow {
    display: inline-block;
    font-family: var(--v4-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--v4-brand);
    background: rgba(45, 106, 143, 0.08);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 20px;
  }
  .v4-cat-hero h1 {
    font-family: var(--v4-serif);
    font-size: 48px;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--v4-ink);
    margin-bottom: 20px;
    line-height: 1.08;
  }
  @media (min-width: 720px) {
    .v4-cat-hero h1 {
      font-size: 56px;
    }
  }
  .v4-cat-hero h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--v4-brand-deep);
  }
  .v4-lead {
    font-size: 16.5px;
    color: var(--v4-ink-dim);
    max-width: 720px;
    line-height: 1.7;
  }
  .v4-lead code {
    font-family: var(--v4-mono);
    font-size: 13px;
    background: var(--v4-surface-2);
    padding: 1px 7px;
    border-radius: 5px;
    color: var(--v4-ink);
  }

  .v4-cat-grid {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 32px 60px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  @media (max-width: 720px) {
    .v4-cat-grid {
      grid-template-columns: 1fr;
      padding: 20px 20px 48px;
      gap: 20px;
    }
  }

  /* Neumorphism raised catalog card (CAR-N-6、 Vercel / Linear / Stripe 相当) */
  .v4-cat-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 28px 22px;
    background: var(--nm-surface, var(--v4-surface));
    border: 1px solid rgba(226, 232, 240, 0.6);
    border-radius: var(--nm-radius-card, 16px);
    text-decoration: none;
    color: var(--v4-ink);
    transition: var(--nm-transition-standard, all 0.24s cubic-bezier(0.4, 0, 0.2, 1));
    box-shadow: var(
      --nm-shadow-raised-soft,
      0 12px 24px -12px rgba(30, 41, 59, 0.12),
      0 4px 8px -4px rgba(45, 106, 143, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.8) inset
    );
    position: relative;
  }
  .v4-cat-card:hover {
    transform: translateY(-4px);
    border-color: rgba(45, 106, 143, 0.28);
    box-shadow: var(
      --nm-shadow-hover,
      0 32px 64px -20px rgba(30, 41, 59, 0.24),
      0 16px 32px -12px rgba(45, 106, 143, 0.18),
      0 1px 0 rgba(255, 255, 255, 0.9) inset
    );
  }
  html.dark .v4-cat-card {
    border-color: rgba(94, 196, 232, 0.14);
  }
  html.dark .v4-cat-card:hover {
    border-color: rgba(94, 196, 232, 0.35);
  }

  .v4-cat-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  /* Linear 風 category tag = uppercase mono + subtle bg pill */
  .v4-cat-tag {
    font-family: var(--v4-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    color: var(--v4-brand-deep);
    background: rgba(45, 106, 143, 0.09);
  }
  .v4-cat-domain .v4-cat-tag {
    color: var(--v4-accent-domain);
    background: rgba(194, 65, 12, 0.1);
  }
  .v4-cat-extended .v4-cat-tag {
    color: var(--v4-accent-extended);
    background: rgba(109, 40, 217, 0.1);
  }
  /* Vercel 風 大型 serif h2 */
  .v4-cat-card h2 {
    font-family: var(--v4-serif);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.024em;
    color: var(--v4-ink);
    line-height: 1.2;
  }
  .v4-cat-card p {
    color: var(--v4-ink-dim);
    font-size: 14px;
    line-height: 1.65;
  }
  .v4-cat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
  }
  /* Stripe 風 subtle chip = 淡い bg + subtle border + mono compact */
  .v4-cat-chip {
    padding: 3.5px 10px;
    background: rgba(252, 248, 238, 0.7);
    border: 1px solid rgba(224, 217, 200, 0.7);
    border-radius: 999px;
    font-family: var(--v4-mono);
    font-size: 10.5px;
    color: var(--v4-ink-dim);
    letter-spacing: 0.01em;
  }
  html.dark .v4-cat-chip {
    background: rgba(31, 38, 48, 0.5);
    border-color: rgba(94, 196, 232, 0.14);
  }
  /* Vercel 風 CTA foot = subtle divider + accent color + arrow slide */
  .v4-cat-go {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    margin-top: 4px;
    border-top: 1px solid rgba(241, 245, 249, 0.8);
    font-family: var(--v4-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--v4-brand-deep);
    letter-spacing: -0.01em;
  }
  html.dark .v4-cat-go {
    border-top-color: rgba(94, 196, 232, 0.14);
  }
  .v4-cat-go .arrow {
    transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
    font-weight: 400;
  }
  .v4-cat-card:hover .arrow {
    transform: translateX(6px);
  }
</style>
