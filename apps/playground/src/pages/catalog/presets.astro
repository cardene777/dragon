---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PresetCard from "@/components/PresetCard.astro";
import {
  presetSwimlane,
  presetFlow,
  presetSequence,
  presetTopology,
  presetEr,
  presetStateMachine,
  presetClassDiagram,
  presetMindMap,
  presetMindMapRadial,
  presetFlowchart,
} from "@/topics/catalog/presets.cdl";

/**
 * Catalog - Presets (CAR-N-8、 Vercel / Linear / Dribbble Neumorphism 相当まで redesign)
 *
 * layout ...
 *   1. hero section (eyebrow + gradient text h1 + subtitle + CTA)
 *   2. stats section (10 presets / 507 tests / 4px precision)
 *   3. preset grid (2 col、 PresetCard component 使用)
 *
 * 旧 layout (title + subtitle + catalog-card grid) を全面 redesign。
 * 各 preset card は PresetCard component (Neumorphism raised + hover 立体感) で描画。
 */

const items = [
  {
    eyebrow: "SWIMLANE / LAYOUT",
    title: "swimlane",
    subtitle: "3 lane 自動配置。 laneId(label) で slug 参照、 lane.x を auto-layout。",
    tags: ["3 lane", "auto layout"],
    diagram: presetSwimlane,
    docHref: "/docs/cdl/presets/swimlane",
  },
  {
    eyebrow: "FLOW / SEQUENCE",
    title: "flow",
    subtitle: "1 lane sequence。 前 step → 次 step 自動 edge、 縦 stack。",
    tags: ["1 lane", "sequential"],
    diagram: presetFlow,
    docHref: "/docs/cdl/presets/flow",
  },
  {
    eyebrow: "SEQUENCE / UML",
    title: "sequence",
    subtitle: "actor 列 × 時系列 row。 UML sequence diagram 風、 return 動作あり。",
    tags: ["actor", "UML"],
    diagram: presetSequence,
    docHref: "/docs/cdl/presets/sequence",
  },
  {
    eyebrow: "TOPOLOGY / DEPLOY",
    title: "topology",
    subtitle: "group + container 配置。 構成図 / deployment diagram 風。",
    tags: ["group", "container"],
    diagram: presetTopology,
    docHref: "/docs/cdl/presets/topology",
  },
  {
    eyebrow: "ER / DB SCHEMA",
    title: "er",
    subtitle: "entity + cardinality。 ER 図 / DB schema 風、 relation 表現。",
    tags: ["entity", "relation"],
    diagram: presetEr,
    docHref: "/docs/cdl/presets/er",
  },
  {
    eyebrow: "STATE / FSM",
    title: "stateMachine",
    subtitle: "state + transition trigger。 FSM / workflow 図風。",
    tags: ["state", "transition"],
    diagram: presetStateMachine,
    docHref: "/docs/cdl/presets/state-machine",
  },
  {
    eyebrow: "CLASS / UML",
    title: "classDiagram",
    subtitle: "class + attribute + relation。 UML クラス図風、 aggregates / extends。",
    tags: ["class", "UML"],
    diagram: presetClassDiagram,
    docHref: "/docs/cdl/presets/class",
  },
  {
    eyebrow: "MIND MAP / IDEA",
    title: "mindMap",
    subtitle: "root + branch 放射。 idea / brain storm 図風。",
    tags: ["mind map", "brain storm"],
    diagram: presetMindMap,
    docHref: "/docs/cdl/presets/mind",
  },
  {
    eyebrow: "MIND MAP / RADIAL",
    title: "mindMapRadial",
    subtitle: "center → 8 方向。 中心軸型 concept map、 対称配置。",
    tags: ["radial", "8-way"],
    diagram: presetMindMapRadial,
    docHref: "/docs/cdl/presets/mindmap-radial",
  },
  {
    eyebrow: "FLOWCHART / DECISION",
    title: "flowchart",
    subtitle: "2 lane 承認フロー。 approval / rejection 分岐、 decision diamond。",
    tags: ["approval", "decision"],
    diagram: presetFlowchart,
    docHref: "/docs/cdl/presets/flowchart",
  },
];
---

<BaseLayout title="Catalog · Presets · dragon">
  <section class="nm-hero">
    <nav aria-label="パンくず" class="nm-crumb">
      <a href="/">overview</a>
      <span aria-hidden="true">/</span>
      <a href="/catalog">catalog</a>
      <span aria-hidden="true">/</span>
      <span class="cur">presets</span>
    </nav>
    <span class="nm-eyebrow">CATALOG / PRESETS · 高位 API</span>
    <h1 class="nm-hero-title">
      Text DSL <span class="nm-gradient-accent">10 presets</span>
    </h1>
    <p class="nm-hero-subtitle">
      swimlane / flow / sequence / topology / er / stateMachine / classDiagram / mindMap / mindMapRadial / flowchart。 それぞれ 1 行宣言で複数 lane / node / edge を組み立てる。 低位 API より簡潔、 手書きより早い。
    </p>
    <div class="nm-hero-actions">
      <a href="/editor" class="nm-hero-btn nm-hero-btn-primary">
        <span>Open editor</span>
        <span class="nm-hero-btn-arrow" aria-hidden="true">→</span>
      </a>
      <a href="/docs/cdl" class="nm-hero-btn nm-hero-btn-secondary">
        <span>Read docs</span>
      </a>
    </div>
    {/* CAR-708 = 6 theme 切替 dropdown。 client script で全 cdl SVG の data-cdl-theme attribute を書き換える経路。 */}
    <div class="nm-theme-picker" role="group" aria-label="theme picker">
      <label for="cdl-theme-select" class="nm-theme-picker-label">Theme</label>
      <select id="cdl-theme-select" class="nm-theme-picker-select" aria-describedby="cdl-theme-picker-desc">
        <option value="blueprint">Blueprint (default、 設計図)</option>
        <option value="neumorphism">Neumorphism (立体、 柔らか影)</option>
        <option value="isometric">Isometric (3D、 top-light + cast)</option>
        <option value="circuit">Circuit (PCB 基板)</option>
        <option value="pinboard">Pinboard (掲示板 sticky)</option>
        <option value="handdrawn">Handdrawn (手描き wobble)</option>
      </select>
      <span id="cdl-theme-picker-desc" class="nm-theme-picker-desc">URL query <code>?theme=circuit</code> でも切替可能</span>
    </div>
  </section>

  <section class="nm-stats" aria-label="dragon preset stats">
    <div class="nm-stat">
      <div class="nm-stat-num">10</div>
      <div class="nm-stat-label">presets</div>
    </div>
    <div class="nm-stat">
      <div class="nm-stat-num">507+</div>
      <div class="nm-stat-label">tests</div>
    </div>
    <div class="nm-stat">
      <div class="nm-stat-num">4px</div>
      <div class="nm-stat-label">label precision</div>
    </div>
    <div class="nm-stat">
      <div class="nm-stat-num">2</div>
      <div class="nm-stat-label">theme (light / dark)</div>
    </div>
  </section>

  <section class="nm-presets-section" aria-label="preset list">
    <div class="nm-section-head">
      <h2 class="nm-section-title">
        Presets <span class="nm-section-count">({items.length})</span>
      </h2>
      <p class="nm-section-desc">
        各 preset は 1 行の関数呼び出しで node / edge / lane を生成、 build() で PhaseDoc を得る。
      </p>
    </div>
    <div class="nm-preset-grid">
      {items.map((item) => (
        <PresetCard
          eyebrow={item.eyebrow}
          title={item.title}
          subtitle={item.subtitle}
          tags={item.tags}
          docHref={item.docHref}
          previewDiagram={item.diagram}
        />
      ))}
    </div>
  </section>

  <script is:inline>
    // CAR-708 = URL query `?theme=<name>` + dropdown で全 cdl SVG の data-cdl-theme を書き換え。
    // cdl SVG root ([data-cdl-theme]) を対象に、 dropdown 選択 + query 反映 + query 更新の 3 経路。
    (function () {
      const VALID = ["blueprint", "neumorphism", "isometric", "circuit", "pinboard", "handdrawn"];
      const select = document.getElementById("cdl-theme-select");
      if (!(select instanceof HTMLSelectElement)) return;

      // Circuit theme = 4 隅 solder pad の gold circle (r=3) を rect[data-cdl-role="node-body"]
      // の 4 corner に inject する。 他 theme 選択時は remove、 冪等操作 (重複 inject しない)。
      // 実装場所は CSS 経路で不可 (SVG 内 rect の 4 corner に円を配置する CSS 表現がない、
      // pattern fill は tile 単位で個別 rect 座標に合わない)。 client-side JS 経路で
      // rect ごとに 4 circle を SVG namespace で挿入し、 data-cdl-role="node-pad" を付与、
      // CSS 側 `[data-cdl-theme="circuit"] [data-cdl-role="node-pad"]` で fill / opacity 適用。
      const PAD_R = 3.5;
      const PAD_INSET = 6; // rect 端からの距離 (world units)
      // MutationObserver 起因の infinite loop 対策 = 冪等 guard。
      // decoratePads() で SVG に circle を追加すると MO が subtree 変更を検知して apply() を
      // 再起動 → decoratePads() 再実行 → 再追加、 の loop で `networkidle` が永遠に来ない
      // 現象を Playwright 30s timeout で観測済 (CAR-Circuit-完璧化 diagnose)。 対策 =
      // (1) 各 svg で「必要な pad 数 = rect × 4」 を計算、 既に一致するなら早 return
      // (2) circuit 以外の theme では既存 pad の存在を check して残っていれば全 remove
      function decoratePads(theme) {
        const svgs = document.querySelectorAll("svg[data-cdl-theme]");
        svgs.forEach((svg) => {
          const existingPads = svg.querySelectorAll('[data-cdl-role="node-pad"]');
          if (theme !== "circuit") {
            if (existingPads.length > 0) {
              existingPads.forEach((n) => n.remove());
            }
            return;
          }
          const rects = svg.querySelectorAll('rect[data-cdl-role="node-body"]');
          const targetCount = rects.length * 4;
          // 既に必要数一致 = idempotent skip (MO 再起動時の loop 回避)
          if (existingPads.length === targetCount) return;
          // 数が違う (初回 mount / rect 増減) 時のみ再構築
          existingPads.forEach((n) => n.remove());
          rects.forEach((rect) => {
            const parent = rect.parentNode;
            if (!parent) return;
            const x = parseFloat(rect.getAttribute("x") ?? "0");
            const y = parseFloat(rect.getAttribute("y") ?? "0");
            const w = parseFloat(rect.getAttribute("width") ?? "0");
            const h = parseFloat(rect.getAttribute("height") ?? "0");
            if (!isFinite(w) || !isFinite(h) || w <= 0 || h <= 0) return;
            const corners = [
              [x + PAD_INSET, y + PAD_INSET],
              [x + w - PAD_INSET, y + PAD_INSET],
              [x + PAD_INSET, y + h - PAD_INSET],
              [x + w - PAD_INSET, y + h - PAD_INSET],
            ];
            corners.forEach(([cx, cy]) => {
              const c = document.createElementNS("http://www.w3.org/2000/svg", "circle");
              c.setAttribute("data-cdl-role", "node-pad");
              c.setAttribute("cx", String(cx));
              c.setAttribute("cy", String(cy));
              c.setAttribute("r", String(PAD_R));
              parent.insertBefore(c, rect.nextSibling);
            });
          });
        });
      }

      function apply(theme) {
        if (!VALID.includes(theme)) theme = "blueprint";
        const roots = document.querySelectorAll("[data-cdl-theme]");
        roots.forEach((el) => el.setAttribute("data-cdl-theme", theme));
        decoratePads(theme);
        if (select.value !== theme) select.value = theme;
      }

      function fromQuery() {
        const q = new URLSearchParams(window.location.search).get("theme");
        return q && VALID.includes(q) ? q : "blueprint";
      }

      // 初期反映 = URL query 優先、 なければ blueprint
      apply(fromQuery());

      // dropdown 選択 → URL query 更新 + apply (history 汚染回避で replaceState)
      select.addEventListener("change", () => {
        const t = select.value;
        const url = new URL(window.location.href);
        if (t === "blueprint") {
          url.searchParams.delete("theme");
        } else {
          url.searchParams.set("theme", t);
        }
        window.history.replaceState({}, "", url.toString());
        apply(t);
      });

      // 動的 mount の cdl SVG (CdlDiagramView は React で hydrate 後に render される) を捕捉して apply
      const mo = new MutationObserver(() => apply(select.value));
      mo.observe(document.body, { subtree: true, childList: true });
    })();
  </script>
</BaseLayout>

<style is:global>
  /* ─── Hero section (CAR-N-8、 Vercel / Linear 相当の大きめ typography + Neumorphism breathing) ─── */
  .nm-hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 80px 32px 40px;
  }
  @media (max-width: 720px) {
    .nm-hero {
      padding: 48px 20px 28px;
    }
  }
  .nm-crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--v4-mono);
    font-size: 11.5px;
    color: var(--v4-ink-mute);
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }
  .nm-crumb a {
    color: var(--v4-ink-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nm-crumb a:hover {
    color: var(--v4-brand);
  }
  .nm-crumb .cur {
    color: var(--v4-ink);
  }
  .nm-eyebrow {
    display: inline-block;
    font-family: var(--v4-mono);
    font-size: var(--nm-fs-eyebrow, 11px);
    letter-spacing: var(--nm-ls-eyebrow, 0.14em);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--v4-brand);
    background: rgba(45, 106, 143, 0.08);
    padding: 5px 13px;
    border-radius: var(--nm-radius-pill, 999px);
    margin-bottom: 24px;
  }
  html.dark .nm-eyebrow {
    color: var(--v4-brand);
    background: rgba(94, 196, 232, 0.12);
  }
  .nm-hero-title {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: var(--nm-fs-h1-mobile, 40px);
    font-weight: 700;
    letter-spacing: var(--nm-ls-h1, -0.03em);
    color: var(--v4-ink);
    line-height: var(--nm-lh-h1, 1.05);
    margin: 0 0 24px 0;
  }
  @media (min-width: 720px) {
    .nm-hero-title {
      font-size: var(--nm-fs-h1, 56px);
    }
  }
  .nm-hero-subtitle {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: 17px;
    line-height: var(--nm-lh-body, 1.65);
    color: var(--v4-ink-dim);
    max-width: 720px;
    margin: 0 0 32px 0;
  }
  .nm-hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .nm-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: var(--nm-radius-btn, 12px);
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: var(--nm-transition-standard);
    cursor: pointer;
  }
  .nm-hero-btn-primary {
    color: #ffffff;
    background: var(--nm-accent-gradient);
    box-shadow:
      6px 6px 12px rgba(163, 177, 198, 0.4),
      -4px -4px 10px rgba(255, 255, 255, 0.7),
      0 1px 0 rgba(255, 255, 255, 0.25) inset;
  }
  .nm-hero-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      10px 10px 20px rgba(163, 177, 198, 0.5),
      -6px -6px 14px rgba(255, 255, 255, 0.8),
      0 1px 0 rgba(255, 255, 255, 0.3) inset;
    color: #ffffff;
  }
  .nm-hero-btn-primary:active {
    transform: translateY(0);
    box-shadow:
      inset 4px 4px 8px rgba(30, 68, 96, 0.35),
      inset -3px -3px 6px rgba(255, 255, 255, 0.15);
  }
  .nm-hero-btn-secondary {
    color: var(--v4-ink);
    background: var(--nm-surface, #f0f3f7);
    box-shadow: var(--nm-shadow-raised-soft);
  }
  .nm-hero-btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: var(--nm-shadow-hover);
    color: var(--v4-brand);
  }
  html.dark .nm-hero-btn-secondary {
    color: var(--v4-ink);
    background: var(--nm-surface, #141a24);
  }
  html.dark .nm-hero-btn-secondary:hover {
    color: var(--v4-brand);
  }
  .nm-hero-btn-arrow {
    transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nm-hero-btn:hover .nm-hero-btn-arrow {
    transform: translateX(4px);
  }

  /* ─── Stats section (CAR-N-8、 大数値 + label で「実績を語る」) ─── */
  .nm-stats {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 32px 48px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 720px) {
    .nm-stats {
      grid-template-columns: repeat(2, 1fr);
      padding: 16px 20px 32px;
      gap: 14px;
    }
  }
  .nm-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 22px 24px;
    background: var(--nm-surface, #f0f3f7);
    border-radius: var(--nm-radius-card, 20px);
    box-shadow: var(--nm-shadow-raised-soft);
    transition: var(--nm-transition-standard);
  }
  .nm-stat:hover {
    transform: translateY(-2px);
    box-shadow: var(--nm-shadow-raised-strong);
  }
  html.dark .nm-stat {
    background: var(--nm-surface, #141a24);
  }
  .nm-stat-num {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--v4-ink);
    line-height: 1;
  }
  .nm-stat-label {
    font-family: var(--v4-mono, "JetBrains Mono", monospace);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--v4-ink-dim);
  }

  /* ─── Presets section (CAR-N-8、 section head + PresetCard grid) ─── */
  .nm-presets-section {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 32px 100px;
  }
  @media (max-width: 720px) {
    .nm-presets-section {
      padding: 16px 20px 60px;
    }
  }
  .nm-section-head {
    margin-bottom: 32px;
  }
  .nm-section-title {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: var(--nm-fs-h2, 32px);
    font-weight: 700;
    letter-spacing: var(--nm-ls-h2, -0.015em);
    color: var(--v4-ink);
    margin: 0 0 8px 0;
    line-height: 1.15;
  }
  .nm-section-count {
    font-family: var(--v4-mono, "JetBrains Mono", monospace);
    font-size: 20px;
    font-weight: 500;
    color: var(--v4-ink-mute);
    letter-spacing: 0;
  }
  .nm-section-desc {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--v4-ink-dim);
    margin: 0;
    max-width: 720px;
  }
  .nm-preset-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  @media (max-width: 900px) {
    .nm-preset-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* ─── Theme picker (CAR-708、 6 theme 切替 dropdown、 hero action 下段) ─── */
  .nm-theme-picker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding: 12px 18px;
    background: var(--nm-surface, #f0f3f7);
    border-radius: var(--nm-radius-btn, 12px);
    box-shadow: var(--nm-shadow-raised-soft);
    flex-wrap: wrap;
    max-width: 640px;
  }
  html.dark .nm-theme-picker {
    background: var(--nm-surface, #141a24);
  }
  .nm-theme-picker-label {
    font-family: var(--v4-mono, "JetBrains Mono", monospace);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--v4-ink-dim);
    font-weight: 600;
  }
  .nm-theme-picker-select {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: 14px;
    padding: 8px 14px;
    border-radius: 8px;
    background: #ffffff;
    color: var(--v4-ink);
    border: 1px solid var(--v4-line, #d5dbe4);
    cursor: pointer;
  }
  html.dark .nm-theme-picker-select {
    background: #1c2334;
    border-color: #2f3a52;
    color: var(--v4-ink);
  }
  .nm-theme-picker-desc {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: 12.5px;
    color: var(--v4-ink-mute);
  }
  .nm-theme-picker-desc code {
    font-family: var(--v4-mono, "JetBrains Mono", monospace);
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(45, 106, 143, 0.08);
    color: var(--v4-brand);
  }
  html.dark .nm-theme-picker-desc code {
    background: rgba(94, 196, 232, 0.12);
  }
</style>
</BaseLayout>
