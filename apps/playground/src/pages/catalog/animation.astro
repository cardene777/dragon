---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlDiagramThumbnail } from "@cardenelabs/cdl";
import { tweenSimple, tweenChain, setSwitch, badgePerPhase, mixedTweenSet } from "@/topics/catalog/animation.cdl";

const items = [
  { label: "Tween: 単 phase 線形補間", d: tweenSimple },
  { label: "Tween: 連続 phase で累積", d: tweenChain },
  { label: "Set: 即時切替 (lerp なし)", d: setSwitch },
  { label: "Badge: phase ごと切替", d: badgePerPhase },
  { label: "Tween + Set 併用", d: mixedTweenSet },
];
---

<BaseLayout title="Catalog - Animation - dragon">
  <section class="shell pt-12 pb-8">
    <div class="space-y-4">
      <nav aria-label="パンくず" class="flex items-center gap-1.5 text-xs font-medium text-nm-text-muted">
        <a href="/" class="text-nm-text-secondary hover:text-nm-accent no-underline">トップ</a>
        <span aria-hidden="true">/</span>
        <a href="/catalog" class="text-nm-text-secondary hover:text-nm-accent no-underline">Catalog</a>
        <span aria-hidden="true">/</span>
        <span class="text-nm-text">Animation</span>
      </nav>
      <span class="section-eyebrow">Catalog / Animation</span>
      <h1 class="heading-h1">Animation</h1>
      <p class="max-w-3xl text-base text-nm-text-secondary leading-relaxed">
        phase 内の動き。 tween (数値線形補間) と set (即時切替)、 badge 切替、 複数 phase 連動。
      </p>
    </div>
  </section>

  <section class="shell pb-24">
    <div class="grid gap-4 md:grid-cols-2">
      {
        items.map((item) => (
          <div class="space-y-2">
            <div class="text-xl font-bold text-nm-text tracking-tight">{item.label}</div>
            <div class="overflow-hidden rounded-nm shadow-nm-raised">
              <CdlDiagramThumbnail client:load diagram={item.d} hideHeader />
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
