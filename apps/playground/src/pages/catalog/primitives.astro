---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlDiagramThumbnail } from "@cardenelabs/cdl";
import {
  kindActor, kindFunction, kindStorage, kindEvent, kindCard,
  laneSingle, laneMulti, laneContain,
  stackPair, stackTriple,
} from "@/topics/catalog/primitives.cdl";
import {
  kPerson, kUserGroup, kAdmin, kDeveloper, kExternalUser,
  kDatabase, kCache, kQueue, kMessageBus, kCloud, kCdn,
  kService, kApi, kFrontend, kBackend, kWebhook, kMicroservice,
  kSigner, kOracle, kMerkleTree, kDecision,
} from "@/topics/catalog/primitives-extra.cdl";

const NODE_DOC = "/docs/cdl/primitives/node";
const LANE_DOC = "/docs/cdl/primitives/lane";

const groups = [
  {
    title: "NodeKind 基本 5 種",
    desc: "各 kind の見た目 (色 / shape / 余白 / rows 構造)。",
    docHref: NODE_DOC,
    items: [
      { label: "actor", d: kindActor },
      { label: "function", d: kindFunction },
      { label: "storage", d: kindStorage },
      { label: "event", d: kindEvent },
      { label: "card", d: kindCard },
    ],
  },
  {
    title: "人系 NodeKind (5)",
    desc: "person / user-group / admin / developer / external-user。",
    docHref: NODE_DOC,
    items: [
      { label: "person", d: kPerson },
      { label: "user-group", d: kUserGroup },
      { label: "admin", d: kAdmin },
      { label: "developer", d: kDeveloper },
      { label: "external-user", d: kExternalUser },
    ],
  },
  {
    title: "インフラ NodeKind (6)",
    desc: "database / cache / queue / message-bus / cloud / cdn。",
    docHref: NODE_DOC,
    items: [
      { label: "database", d: kDatabase },
      { label: "cache", d: kCache },
      { label: "queue", d: kQueue },
      { label: "message-bus", d: kMessageBus },
      { label: "cloud", d: kCloud },
      { label: "cdn", d: kCdn },
    ],
  },
  {
    title: "アプリ系 NodeKind (6)",
    desc: "service / api / frontend / backend / webhook / microservice。",
    docHref: NODE_DOC,
    items: [
      { label: "service", d: kService },
      { label: "api", d: kApi },
      { label: "frontend", d: kFrontend },
      { label: "backend", d: kBackend },
      { label: "webhook", d: kWebhook },
      { label: "microservice", d: kMicroservice },
    ],
  },
  {
    title: "データ / 判定 NodeKind (4)",
    desc: "signer / oracle / merkle-tree / decision。",
    docHref: NODE_DOC,
    items: [
      { label: "signer", d: kSigner },
      { label: "oracle", d: kOracle },
      { label: "merkle-tree", d: kMerkleTree },
      { label: "decision", d: kDecision },
    ],
  },
  {
    title: "Lane バリエーション",
    desc: "lane の本数 / contain (枠囲み) で構造表現を変えられる。",
    docHref: LANE_DOC,
    items: [
      { label: "1 本 (single)", d: laneSingle },
      { label: "3 本 (multi)", d: laneMulti },
      { label: "contain=true (枠囲み)", d: laneContain },
    ],
  },
  {
    title: "Node Stack",
    desc: "同 lane 内で stack 番号で縦並びを制御、 row_gap 自動。",
    docHref: NODE_DOC,
    items: [
      { label: "2 段", d: stackPair },
      { label: "3 段", d: stackTriple },
    ],
  },
];
---

<BaseLayout title="Catalog - Primitives - dragon">
  <section class="shell pt-12 pb-8">
    <div class="space-y-4">
      <nav aria-label="パンくず" class="flex items-center gap-1.5 text-xs font-medium text-nm-text-muted">
        <a href="/" class="text-nm-text-secondary hover:text-nm-accent no-underline">トップ</a>
        <span aria-hidden="true">/</span>
        <a href="/catalog" class="text-nm-text-secondary hover:text-nm-accent no-underline">Catalog</a>
        <span aria-hidden="true">/</span>
        <span class="text-nm-text">Primitives</span>
      </nav>
      <span class="section-eyebrow">Catalog / Primitives</span>
      <h1 class="heading-h1">Primitives</h1>
      <p class="max-w-3xl text-base text-nm-text-secondary leading-relaxed">
        lane / node の基本パーツ + 拡充 NodeKind 29 種 (人 / インフラ / アプリ / blockchain / 暗号)。
      </p>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="shell pb-10">
        <div class="flex items-start justify-between gap-4 mb-5">
          <div class="space-y-2">
            <h2 class="heading-h2">{g.title}</h2>
            <p class="text-sm text-nm-text-secondary">{g.desc}</p>
          </div>
          {g.docHref && (
            <a
              href={g.docHref}
              class="catalog-doc-link shrink-0"
              aria-label="このパーツのドキュメントへ"
            >
              <span aria-hidden="true">📖</span>
              <span>ドキュメント</span>
            </a>
          )}
        </div>
        <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
          {g.items.map((item) => (
            <article class="catalog-card">
              <header class="catalog-card-head">
                <div class="catalog-card-title">{item.label}</div>
                {g.docHref && (
                  <a href={g.docHref} class="catalog-card-link" aria-label={`${item.label} のドキュメントへ`}>
                    <span aria-hidden="true">📖</span>
                    <span>Docs</span>
                  </a>
                )}
              </header>
              <div class="catalog-card-body">
                <CdlDiagramThumbnail client:load diagram={item.d} hideHeader />
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
  <style is:global>
    .catalog-doc-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #c17f3e;
      background: rgba(193, 127, 62, 0.1);
      border: 1px solid rgba(193, 127, 62, 0.3);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s, transform 0.15s;
    }
    .catalog-doc-link:hover {
      background: rgba(193, 127, 62, 0.18);
      transform: translateY(-1px);
    }
    .catalog-thumb-doc-link {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      font-size: 16px;
      background: rgba(232, 221, 208, 0.95);
      border: 1px solid rgba(196, 185, 172, 0.6);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s, transform 0.15s;
      z-index: 5;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    }
    .catalog-thumb-doc-link:hover {
      background: rgba(193, 127, 62, 0.18);
      transform: scale(1.08);
    }
  </style>
</BaseLayout>
