---
/**
 * Visual regression テスト用 hidden page。
 *
 * 用途 ... apps/web/tests/visual/extended.spec.ts から参照される、 拡張 preset
 *   (gantt / class / pie / c4 / mind / code) の SVG render 専用ページ。
 *   text-dsl.cdl.ts に export されている拡張 preset は本 page でのみ視覚 regression される。
 *
 * 公開対象外 ... noindex / nofollow + sitemap 除外 (公開 docs ではなく内部 visual testing 用)。
 *
 * 注意 ... text-dsl 由来の gantt / class / pie / c4 / mind は animation block を持つが
 *   builder の phase が 0 件のままなので、 visual regression 用 wrapper で
 *   ダミー phase 1 件を補い CdlDiagramView を render 可能にする。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlDiagramThumbnail } from "@cardenelabs/cdl";
import type { CdlDiagram } from "@cardenelabs/cdl";
import {
  textDslGantt,
  textDslClass,
  textDslPie,
  textDslC4,
  textDslMind,
  textDslCode,
} from "@/topics/catalog/text-dsl.cdl";

/**
 * Visual test 用に phase 0 件の diagram にダミー phase を補う。
 * 補完 phase は全 node / edge を activate して initial state で render する。
 */
function withDefaultPhase(d: CdlDiagram): CdlDiagram {
  if (d.phases && d.phases.length > 0) return d;
  const nodeIds = d.nodes.map((n) => n.id);
  const edgeIds = d.edges.map((e) => e.id);
  return {
    ...d,
    phases: [
      {
        id: "p1",
        duration: 1500,
        title: d.topic ?? "preview",
        body: "visual regression 用 default phase",
        activate: [...nodeIds, ...edgeIds],
        tweens: [],
        sets: [],
      },
    ],
  };
}

const items = [
  { label: "gantt", d: withDefaultPhase(textDslGantt) },
  { label: "class", d: withDefaultPhase(textDslClass) },
  { label: "pie", d: withDefaultPhase(textDslPie) },
  { label: "c4", d: withDefaultPhase(textDslC4) },
  { label: "mind", d: withDefaultPhase(textDslMind) },
  { label: "code", d: textDslCode },
];
---

<BaseLayout title="Visual Test Extended (internal)" description="Visual regression test page for extended presets">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section class="shell pt-12 pb-24">
    <h1 class="heading-h1">Visual Test (Extended Presets)</h1>
    <p class="text-sm text-nm-text-secondary">
      拡張 preset (gantt / class / pie / c4 / mind / code) の visual regression
      test 専用 page。 通常 catalog では公開していない。
    </p>
    <div class="grid gap-6 mt-6 md:grid-cols-2">
      {
        items.map((item) => (
          <div class="space-y-2">
            <div class="text-xl font-bold text-nm-text tracking-tight">
              {item.label} (id={item.d.id})
            </div>
            <div class="overflow-hidden rounded-nm shadow-nm-raised">
              <CdlDiagramThumbnail client:load diagram={item.d} hideHeader />
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
