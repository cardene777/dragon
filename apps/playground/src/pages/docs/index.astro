---
import "../../styles/global.css";
import "../../styles/docs-site.css";
const title = "@cardenelabs/cdl engine - Docs";
const description = "@cardenelabs/cdl engine 公式ドキュメント。 mermaid 並みに人が描きやすい animated SVG diagram engine (dragon DSL の lower layer)。";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://cdl-playground.vercel.app/docs" />
    {/* OGP */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="cdl engine Docs (dragon)" />
    <meta property="og:url" content="https://cdl-playground.vercel.app/docs" />
    <meta property="og:image" content="https://cdl-playground.vercel.app/ogp/default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cdl-playground.vercel.app/ogp/default.png" />
    {/* dark mode + lang pre-flash 防止 (DocsLayout と統一) */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("docs-theme");
          if (t === "dark" || (!t && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
          var l = localStorage.getItem("docs-lang");
          if (l === "en" || l === "ja") {
            document.documentElement.setAttribute("lang", l);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="docs-body">
    <!-- 同じ DocsNavBar を Hero ページにも (DocsLayout の navbar と統一スタイル) -->
    <header class="docs-navbar">
      <div class="docs-navbar-inner">
        <a href="/docs" class="docs-navbar-brand">
          <span class="docs-navbar-logo">C</span>
          <span class="docs-navbar-title">cdl <span class="docs-navbar-title-sub">engine Docs</span></span>
        </a>
        <nav class="docs-navbar-nav" aria-label="docs navigation">
          <a href="/docs" class="docs-navbar-link active" data-ja="はじめに" data-en="Home">はじめに</a>
          <a href="/docs/cdl/overview/quickstart" class="docs-navbar-link" data-ja="ガイド" data-en="Guide">ガイド</a>
          <a href="/docs/cdl/reference/api" class="docs-navbar-link" data-ja="リファレンス" data-en="Reference">リファレンス</a>
          <a href="/catalog" class="docs-navbar-link" data-ja="Catalog" data-en="Catalog">Catalog</a>
          <a href="/" class="docs-navbar-link docs-navbar-link-external" data-ja="dragon サイト" data-en="dragon Site">dragon サイト</a>
          <a href="https://github.com/cardene777/cdl" class="docs-navbar-link docs-navbar-link-external" target="_blank" rel="noopener">GitHub ↗</a>
        </nav>
        <div style="margin-left: auto;"></div>
        <button class="docs-navbar-lang-toggle" id="docs-lang-toggle" aria-label="言語切替" title="言語切替">
          <span class="docs-lang-ja">JA</span>
          <span class="docs-lang-en">EN</span>
        </button>
        <button class="docs-navbar-theme-toggle" id="docs-theme-toggle" aria-label="dark/light 切替" title="dark/light 切替">
          <span class="docs-theme-icon-light">☀</span>
          <span class="docs-theme-icon-dark">☾</span>
        </button>
      </div>
    </header>
    <script is:inline>
      (() => {
        const toggle = document.getElementById("docs-theme-toggle");
        if (!toggle) return;
        toggle.addEventListener("click", () => {
          const cur = document.documentElement.classList.contains("dark") ? "dark" : "light";
          const next = cur === "dark" ? "light" : "dark";
          if (next === "dark") document.documentElement.classList.add("dark");
          else document.documentElement.classList.remove("dark");
          try { localStorage.setItem("docs-theme", next); } catch (e) {}
        });
      })();
    </script>

    <main class="docs-hero-shell">
      <section class="docs-hero">
        <div class="docs-hero-eyebrow">@cardenelabs/cdl · TypeScript DSL</div>
        <h1 class="docs-hero-title">
          <span data-ja="人が描きやすい" data-en="Human-friendly">人が描きやすい</span><br />
          <span class="docs-hero-title-accent" data-ja="animated diagram" data-en="animated diagrams">animated diagram</span>
          <span data-ja=" を宣言する。" data-en=", declared.">を宣言する。</span>
        </h1>
        <p class="docs-hero-lead" data-ja="cdl は TypeScript で diagram を declare → React + SVG で animated render する OSS library。 mermaid のような simplicity と、 phase / state / tween による dynamic 表現を両立。 書いた declaration が画面に出ているかを engine が自動検証する 「目」 を備えるのが他にない特徴。" data-en="cdl is an OSS library that lets you declare diagrams in TypeScript and render them as animated React + SVG. It combines mermaid-like simplicity with dynamic expressions via phase / state / tween, plus a unique &quot;eye&quot; engine that automatically verifies whether your declaration matches what is actually drawn.">
          cdl は TypeScript で diagram を declare → React + SVG で animated render する OSS library。
          mermaid のような simplicity と、 phase / state / tween による dynamic 表現を両立。
          書いた declaration が画面に出ているかを engine が自動検証する <strong>「目」</strong> を備えるのが他にない特徴。
        </p>
        <div class="docs-hero-cta">
          <a href="/docs/cdl/overview/quickstart" class="docs-hero-cta-primary" data-ja="Quickstart (5 分) →" data-en="Quickstart (5 min) →">Quickstart (5 分) →</a>
          <a href="/docs/cdl/README" class="docs-hero-cta-secondary" data-ja="Introduction を読む" data-en="Read Introduction">Introduction を読む</a>
          <a href="/catalog" class="docs-hero-cta-secondary" data-ja="Catalog で見本を見る" data-en="Browse Catalog">Catalog で見本を見る</a>
        </div>
      </section>

      <section class="docs-hero-features">
        <a href="/docs/cdl/overview/quickstart" class="docs-feature-card">
          <div class="docs-feature-icon">⚡</div>
          <h3 data-ja="5 分で動かす" data-en="Run in 5 min">5 分で動かす</h3>
          <p data-ja="install から最小 diagram → React 表示までの最短経路。" data-en="The shortest path from install to minimal diagram, rendered in React.">install から最小 diagram → React 表示までの最短経路。</p>
        </a>
        <a href="/docs/cdl/overview/cookbook" class="docs-feature-card">
          <div class="docs-feature-icon">📖</div>
          <h3 data-ja="9 実用例" data-en="9 examples">9 実用例</h3>
          <p data-ja="sequence / swimlane / ER / FSM / Permit / Bridge etc." data-en="sequence / swimlane / ER / FSM / Permit / Bridge etc.">sequence / swimlane / ER / FSM / Permit / Bridge etc.</p>
        </a>
        <a href="/docs/cdl/primitives/README" class="docs-feature-card">
          <div class="docs-feature-icon">🧱</div>
          <h3 data-ja="5 基本パーツ" data-en="5 Primitives">5 Primitives</h3>
          <p data-ja="lane / node / edge / state / phase で任意の図を組み立て。" data-en="Build any diagram from lane / node / edge / state / phase.">lane / node / edge / state / phase で任意の図を組み立て。</p>
        </a>
        <a href="/docs/cdl/presets/README" class="docs-feature-card">
          <div class="docs-feature-icon">🎁</div>
          <h3 data-ja="6 高位 API" data-en="6 Presets">6 Presets</h3>
          <p data-ja="swimlane / flow / sequence / topology / er / stateMachine。 mermaid 同等。" data-en="swimlane / flow / sequence / topology / er / stateMachine — on par with mermaid.">swimlane / flow / sequence / topology / er / stateMachine。 mermaid 同等。</p>
        </a>
        <a href="/docs/cdl/overview/mermaid-migration" class="docs-feature-card">
          <div class="docs-feature-icon">🔄</div>
          <h3 data-ja="mermaid 移行" data-en="Mermaid Migration">Mermaid Migration</h3>
          <p data-ja="sequenceDiagram / erDiagram / stateDiagram-v2 の 1:1 対応表。" data-en="1:1 mapping for sequenceDiagram / erDiagram / stateDiagram-v2.">sequenceDiagram / erDiagram / stateDiagram-v2 の 1:1 対応表。</p>
        </a>
        <a href="/docs/cdl/reference/verifier-guide" class="docs-feature-card">
          <div class="docs-feature-icon">👁</div>
          <h3 data-ja="「目」 verifier" data-en="The &quot;Eye&quot; verifier">「目」 Verifier</h3>
          <p data-ja="書いた declaration が画面に出ているかを engine が自動検証 (LLM 不要)。" data-en="The engine auto-verifies whether your declaration matches what is drawn (no LLM needed).">書いた declaration が画面に出ているかを engine が自動検証 (LLM 不要)。</p>
        </a>
      </section>

      <section class="docs-hero-snippet">
        <h2 data-ja="30 秒で雰囲気を掴む" data-en="Get a feel in 30 sec">30 秒で雰囲気を掴む</h2>
        <pre><code>{`import { diagram } from "@cardenelabs/cdl";
import { CdlDiagramView } from "@cardenelabs/cdl/react";

const hello = diagram("hello", { topic: "Hello world" })
  .lane("left",  { x: 0,   width: 320 })
  .lane("right", { x: 460, width: 320 })
  .nodes([
    { id: "a", lane: "left",  stack: 0, kind: "actor",    title: "Alice" },
    { id: "b", lane: "right", stack: 0, kind: "function", title: "greet()" },
  ])
  .edge("a", "b", { label: "hello" })
  .phase("call", { duration: 1500, title: "Call", body: "Alice が greet を呼ぶ。" },
    (p) => p.activate("a", "b", "a-b"))
  .build();

export const App = () => <CdlDiagramView diagram={hello} />;`}</code></pre>
        <a href="/docs/cdl/overview/quickstart" class="docs-hero-cta-primary docs-hero-snippet-cta" data-ja="続き → Quickstart" data-en="Next → Quickstart">
          続き → Quickstart
        </a>
      </section>
    </main>

    {/* lang toggle (main 描画後に init して main 内 data-ja element も拾う) */}
    <script is:inline>
      (() => {
        const rewriteCtaUrls = (lang) => {
          // Hero CTA の /docs/cdl/ ↔ /docs/en/cdl/ を切替
          document.querySelectorAll("a[href]").forEach((a) => {
            const h = a.getAttribute("href");
            if (!h) return;
            if (lang === "en" && h.startsWith("/docs/cdl/")) {
              a.setAttribute("href", h.replace("/docs/cdl/", "/docs/en/cdl/"));
            } else if (lang === "ja" && h.startsWith("/docs/en/cdl/")) {
              a.setAttribute("href", h.replace("/docs/en/cdl/", "/docs/cdl/"));
            }
          });
        };
        const applyLang = (lang) => {
          document.documentElement.setAttribute("lang", lang);
          document.querySelectorAll("[data-ja][data-en]").forEach((el) => {
            const v = el.getAttribute(lang === "en" ? "data-en" : "data-ja");
            if (v !== null) el.textContent = v;
          });
          rewriteCtaUrls(lang);
          try { localStorage.setItem("docs-lang", lang); } catch (e) {}
        };
        const initial = document.documentElement.getAttribute("lang") === "en" ? "en" : "ja";
        if (initial === "en") applyLang("en");
        const toggle = document.getElementById("docs-lang-toggle");
        if (!toggle) return;
        toggle.addEventListener("click", () => {
          const cur = document.documentElement.getAttribute("lang") === "en" ? "en" : "ja";
          applyLang(cur === "en" ? "ja" : "en");
        });
      })();
    </script>

    {/* Hero snippet にも copy ボタンを追加 (DocsLayout の機能と統一) */}
    <script is:inline>
      (() => {
        const pres = document.querySelectorAll(".docs-hero-snippet pre");
        pres.forEach((pre) => {
          if (pre.querySelector(".docs-code-copy")) return;
          const btn = document.createElement("button");
          btn.className = "docs-code-copy";
          btn.type = "button";
          btn.setAttribute("aria-label", "コードを copy");
          btn.innerHTML = '<span class="docs-code-copy-default">copy</span><span class="docs-code-copy-done">copied</span>';
          btn.addEventListener("click", async () => {
            const code = pre.querySelector("code");
            const text = code ? code.textContent : pre.textContent;
            try {
              await navigator.clipboard.writeText(text);
              btn.classList.add("done");
              setTimeout(() => btn.classList.remove("done"), 1500);
            } catch (e) {}
          });
          pre.style.position = "relative";
          pre.appendChild(btn);
        });
      })();
    </script>
  </body>
</html>
