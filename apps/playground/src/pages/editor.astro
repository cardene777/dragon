---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlEditor } from "@/components/CdlEditor";
---

<BaseLayout
  title="dragon Visual Editor"
  description="dragon DSL v0.5 を split view で書きながら live preview する Visual Editor。 cdl engine が animated SVG として render し、 ブラウザだけで動き、 SVG ダウンロード + 共有 URL に対応。"
>
  <CdlEditor client:load />
</BaseLayout>

<style is:global>
  /* editor の page wrapper ... main の余白を消して画面いっぱい使う */
  body:has(.v4-editor) main {
    padding: 0 !important;
    min-height: calc(100vh - 60px) !important;
  }
  body:has(.v4-editor) .v4-foot { display: none; }

  .v4-editor {
    display: grid;
    grid-template-columns: 260px 1fr 1fr;
    height: calc(100vh - 60px);
    background: var(--v4-canvas);
    font-family: var(--v4-sans);
  }

  /* ── sidebar (new file 主体 + sample collapsible) ── */
  .v4-editor-side {
    background: var(--v4-surface);
    border-right: 1px solid var(--v4-line);
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 16px 12px;
    gap: 12px;
  }
  .v4-editor-side-new {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 14px;
    background: var(--v4-ink);
    color: var(--v4-canvas);
    border-radius: 9px;
    font-family: var(--v4-mono);
    font-size: 13px;
    cursor: pointer;
    border: none;
    transition: background 0.15s, transform 0.15s;
    text-align: left;
  }
  .v4-editor-side-new:hover {
    background: var(--v4-brand-deep);
    transform: translateY(-1px);
  }
  .v4-editor-side-new-plus {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    font-size: 14px;
    font-weight: 400;
  }

  .v4-editor-side-samples {
    border-top: 1px solid var(--v4-line);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .v4-editor-side-samples-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .v4-editor-side-samples-summary::-webkit-details-marker {
    display: none;
  }
  .v4-editor-side-samples-summary:hover {
    background: rgba(26, 31, 42, 0.04);
  }
  .v4-editor-side-samples-label {
    font-family: var(--v4-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--v4-ink-mute);
    font-weight: 600;
  }
  .v4-editor-side-samples-count {
    margin-left: auto;
    font-family: var(--v4-mono);
    font-size: 11px;
    color: var(--v4-ink-mute);
  }
  .v4-editor-side-samples-caret {
    font-family: var(--v4-mono);
    color: var(--v4-ink-mute);
    transition: transform 0.2s;
    font-size: 14px;
  }
  .v4-editor-side-samples[open] .v4-editor-side-samples-caret {
    transform: rotate(90deg);
  }
  .v4-editor-side-samples-body {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
    padding-top: 8px;
  }

  .v4-editor-search {
    margin-bottom: 10px;
    padding: 7px 11px;
    font-family: var(--v4-mono);
    font-size: 12px;
    background: #fcf8ee;
    border: 1px solid var(--v4-line);
    border-radius: 7px;
    color: var(--v4-ink);
    outline: none;
    transition: border-color 0.15s;
  }
  .v4-editor-search:focus {
    border-color: var(--v4-brand);
  }
  .v4-editor-search::placeholder {
    color: var(--v4-ink-mute);
  }
  .v4-editor-side-list {
    flex: 1;
    overflow-y: auto;
    padding-bottom: 8px;
  }
  .v4-editor-side-group {
    margin-bottom: 14px;
  }
  .v4-editor-side-group-title {
    font-family: var(--v4-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--v4-ink-mute);
    padding: 8px 8px 4px;
  }
  .v4-editor-side-item {
    display: block;
    width: 100%;
    text-align: left;
    padding: 7px 10px;
    border: none;
    background: transparent;
    color: var(--v4-ink-dim);
    font-family: var(--v4-sans);
    font-size: 13px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    margin-bottom: 1px;
  }
  .v4-editor-side-item:hover {
    background: rgba(26, 31, 42, 0.05);
    color: var(--v4-ink);
  }
  .v4-editor-side-item.active {
    background: rgba(45, 106, 143, 0.1);
    color: var(--v4-brand-deep);
    font-weight: 500;
  }

  /* ── 中央 + 右共通 bar ── */
  .v4-editor-bar {
    height: 40px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid var(--v4-line);
    background: var(--v4-surface);
  }
  .v4-editor-bar-file {
    font-family: var(--v4-mono);
    font-size: 11.5px;
    color: var(--v4-ink-mute);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .v4-editor-bar-gap { flex: 1; }
  .v4-editor-bar-btn {
    padding: 5px 11px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: var(--v4-ink-dim);
    font-family: var(--v4-mono);
    font-size: 11.5px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .v4-editor-bar-btn:hover {
    background: rgba(26, 31, 42, 0.05);
    color: var(--v4-ink);
  }
  .v4-editor-bar-btn-primary {
    background: var(--v4-ink);
    color: var(--v4-canvas);
  }
  .v4-editor-bar-btn-primary:hover {
    background: var(--v4-brand-deep);
    color: var(--v4-canvas);
  }
  .v4-editor-bar-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .v4-editor-bar-zoom {
    font-family: var(--v4-mono);
    font-size: 11px;
    color: var(--v4-ink-mute);
    padding-left: 10px;
    margin-left: 4px;
    border-left: 1px solid var(--v4-line);
    min-width: 44px;
    text-align: right;
  }
  .v4-editor-live {
    width: 6px;
    height: 6px;
    background: #a3d6a8;
    border-radius: 50%;
    box-shadow: 0 0 8px #a3d6a8;
    animation: live-pulse 1.8s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* ── 中央 code ── */
  .v4-editor-code {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--v4-line);
    background: #fcf8ee;
    min-width: 0;
  }
  .v4-editor-code-body {
    flex: 1;
    overflow: hidden;
    min-height: 0;
  }
  .v4-editor-code-body .cm-editor {
    height: 100%;
  }
  .v4-editor-error {
    padding: 12px 18px;
    background: rgba(193, 90, 74, 0.06);
    border-top: 1px solid rgba(193, 90, 74, 0.3);
    font-family: var(--v4-mono);
    font-size: 12px;
    color: #8b2828;
    white-space: pre-wrap;
    max-height: 130px;
    overflow-y: auto;
  }

  /* ── 右 preview ── */
  .v4-editor-preview {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .v4-editor-stage {
    flex: 1;
    overflow: hidden;
    position: relative;
    background: var(--v4-surface);
    background-image:
      repeating-linear-gradient(0deg, transparent 0 23px, rgba(26, 31, 42, 0.04) 23px 24px),
      repeating-linear-gradient(90deg, transparent 0 23px, rgba(26, 31, 42, 0.04) 23px 24px);
    cursor: grab;
    user-select: none;
  }
  .v4-editor-stage:active {
    cursor: grabbing;
  }
  .v4-editor-pan {
    will-change: transform;
    display: inline-block;
  }
  .v4-editor-svg-wrap {
    display: inline-block;
  }
  .v4-editor-svg-wrap svg {
    display: block;
    pointer-events: none;
  }
  .v4-editor-empty {
    color: var(--v4-ink-mute);
    font-family: var(--v4-mono);
    font-size: 13.5px;
    padding: 40px;
  }
</style>
