---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CdlEditor } from "@/components/CdlEditor";
---

<BaseLayout
  title="dragon Visual Editor"
  description="dragon DSL v0.5 を split view で書きながら live preview する Visual Editor。 cdl engine が animated SVG として render し、 ブラウザだけで動き、 SVG ダウンロード + 共有 URL に対応。"
>
  <main class="editor-main">
    <header class="editor-header">
      <span class="editor-eyebrow">visual editor · v1.0</span>
      <h1 class="editor-title">書きながら、 <em>動かす</em>。</h1>
      <p class="editor-summary">
        左に dragon DSL v0.5 を入力すると、 300 ms 後に右側で animated SVG として描画される。
        sample を選んで構造を真似する、 URL で share、 SVG として download、 すべて browser だけで完結。
        parse は dragon、 render は cdl engine が担う。
      </p>
    </header>
    <CdlEditor client:load />
  </main>
</BaseLayout>

<style>
  .editor-main {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 28px 28px 40px;
  }
  .editor-header {
    margin-bottom: 22px;
  }
  .editor-eyebrow {
    display: inline-block;
    font-family: var(--v4-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--v4-brand);
    margin-bottom: 12px;
  }
  .editor-title {
    font-family: var(--v4-serif);
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--v4-ink);
    margin: 0 0 10px;
  }
  .editor-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--v4-brand-deep);
  }
  .editor-summary {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--v4-ink-dim);
    max-width: 720px;
    margin: 0;
  }

  /* === Editor === */
  :global(.cdl-editor) {
    border: 1px solid var(--v4-line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--v4-surface);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 18px 40px -22px rgba(26, 31, 42, 0.12);
  }
  :global(.cdl-editor-toolbar) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: #fcf8ee;
    border-bottom: 1px solid var(--v4-line-soft);
    flex-wrap: wrap;
  }
  :global(.cdl-editor-samples) {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }
  :global(.cdl-editor-sample-scroll) {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    flex: 1;
    min-width: 0;
    padding-bottom: 2px;
    scrollbar-width: thin;
  }
  :global(.cdl-editor-sample-scroll::-webkit-scrollbar) {
    height: 6px;
  }
  :global(.cdl-editor-sample-scroll::-webkit-scrollbar-thumb) {
    background: var(--v4-line);
    border-radius: 3px;
  }
  :global(.cdl-editor-toolbar-label) {
    font-family: var(--v4-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--v4-ink-mute);
    margin-right: 4px;
    flex-shrink: 0;
  }
  :global(.cdl-editor-sample-btn) {
    font-family: var(--v4-mono);
    font-size: 11.5px;
    padding: 5px 11px;
    border-radius: 7px;
    background: var(--v4-surface);
    border: 1px solid var(--v4-line);
    color: var(--v4-ink-dim);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  :global(.cdl-editor-sample-btn:hover) {
    background: rgba(45, 106, 143, 0.08);
    color: var(--v4-brand-deep);
    border-color: var(--v4-brand);
  }
  :global(.cdl-editor-actions) {
    display: flex;
    gap: 6px;
  }
  :global(.cdl-editor-action-btn) {
    font-family: var(--v4-mono);
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 7px;
    background: var(--v4-ink);
    border: none;
    color: var(--v4-canvas);
    cursor: pointer;
    transition: background 0.15s, transform 0.15s;
    letter-spacing: -0.02em;
  }
  :global(.cdl-editor-action-btn:hover) {
    background: var(--v4-brand-deep);
    transform: translateY(-1px);
  }
  :global(.cdl-editor-action-btn:disabled) {
    background: var(--v4-line);
    color: var(--v4-ink-mute);
    cursor: not-allowed;
    transform: none;
  }
  :global(.cdl-editor-split) {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    min-height: 600px;
  }
  @media (max-width: 768px) {
    :global(.cdl-editor-split) {
      grid-template-columns: 1fr;
    }
  }
  :global(.cdl-editor-input-pane) {
    border-right: 1px solid var(--v4-line-soft);
  }
  :global(.cdl-editor-textarea) {
    width: 100%;
    height: 100%;
    min-height: 600px;
    padding: 18px 20px;
    font-family: var(--v4-mono);
    font-size: 13px;
    line-height: 1.7;
    background: #fcf8ee;
    border: none;
    color: var(--v4-ink);
    resize: none;
    outline: none;
  }
  :global(.cdl-editor-preview-pane) {
    display: flex;
    flex-direction: column;
    background: #fcf8ee;
    padding: 14px;
    overflow: hidden;
    min-height: 600px;
  }
  :global(.cdl-editor-error) {
    background: rgba(193, 60, 60, 0.08);
    border: 1px solid rgba(193, 60, 60, 0.3);
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 12px;
    color: #8b2828;
    margin-bottom: 12px;
    white-space: pre-wrap;
    font-family: var(--v4-mono);
    flex-shrink: 0;
  }
  :global(.cdl-editor-preview-wrap) {
    position: relative;
    flex: 1;
    overflow: hidden;
    user-select: none;
    cursor: grab;
    background: var(--v4-surface);
    background-image:
      repeating-linear-gradient(0deg, transparent 0 23px, rgba(26, 31, 42, 0.04) 23px 24px),
      repeating-linear-gradient(90deg, transparent 0 23px, rgba(26, 31, 42, 0.04) 23px 24px);
    border-radius: 8px;
    border: 1px solid var(--v4-line-soft);
    min-height: 500px;
  }
  :global(.cdl-editor-preview-wrap:active) {
    cursor: grabbing;
  }
  :global(.cdl-editor-pan-zoom) {
    transform-origin: 0 0;
    will-change: transform;
    display: inline-block;
  }
  :global(.cdl-editor-preview) {
    display: inline-block;
  }
  :global(.cdl-editor-preview svg) {
    display: block;
    pointer-events: none;
  }
  :global(.cdl-editor-zoom-toolbar) {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    gap: 2px;
    align-items: center;
    background: rgba(255, 253, 247, 0.95);
    backdrop-filter: blur(8px);
    border: 1px solid var(--v4-line);
    border-radius: 8px;
    padding: 4px;
    box-shadow: 0 4px 12px -2px rgba(26, 31, 42, 0.08);
    z-index: 10;
  }
  :global(.cdl-editor-zoom-toolbar button) {
    padding: 4px 10px;
    font-family: var(--v4-mono);
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--v4-ink);
    border-radius: 5px;
    min-width: 28px;
    transition: background 0.15s;
  }
  :global(.cdl-editor-zoom-toolbar button:hover) {
    background: rgba(45, 106, 143, 0.1);
  }
  :global(.cdl-editor-zoom-display) {
    font-family: var(--v4-mono);
    font-size: 11px;
    color: var(--v4-ink-mute);
    padding: 0 8px;
    border-left: 1px solid var(--v4-line);
    min-width: 44px;
    text-align: right;
  }
  :global(.cdl-editor-empty) {
    color: var(--v4-ink-mute);
    font-size: 13.5px;
    font-family: var(--v4-mono);
  }
</style>
