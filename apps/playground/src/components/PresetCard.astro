---
/**
 * PresetCard (CAR-N-8、 catalog / presets の 1 preset を Neumorphism raised card で表示)
 *
 * layout
 *   ┌────────────────────────────────────────┐
 *   │  eyebrow (mono uppercase 11px)         │
 *   │  title (17px semibold letter-spacing)  │
 *   │  subtitle (14px muted)                 │
 *   │  ─────────────────────────             │
 *   │  [ preview SVG area (min-height 240) ] │
 *   │  ─────────────────────────             │
 *   │  [ tag1 ] [ tag2 ]        Docs →       │
 *   └────────────────────────────────────────┘
 *
 * hover = translateY(-6px) + shadow deepen、 transition 0.28s cubic-bezier
 * a11y = article + role linking、 keyboard focus-visible outline (neumorphism.css SSOT)
 *
 * props
 *   - eyebrow (mono uppercase、 例 "PRESET / LAYOUT")
 *   - title (17px semibold、 例 "swimlane")
 *   - subtitle (14px muted、 1-2 行、 例 "3 lane 自動配置 + slug 自動")
 *   - tags (max 3、 例 ["3 lane", "auto layout"])
 *   - docHref (Docs link)
 *   - previewDiagram (CdlDiagramThumbnail に渡す diagram)
 */
import { CdlDiagramThumbnail } from "@cardenelabs/cdl";

type Props = {
  eyebrow: string;
  title: string;
  subtitle?: string;
  tags?: string[];
  docHref: string;
  previewDiagram: unknown;
};

const { eyebrow, title, subtitle, tags = [], docHref, previewDiagram } = Astro.props;
---

<article class="nm-preset-card">
  <header class="nm-preset-card-head">
    <span class="nm-preset-eyebrow">{eyebrow}</span>
    <h3 class="nm-preset-title">{title}</h3>
    {subtitle && <p class="nm-preset-subtitle">{subtitle}</p>}
  </header>

  <div class="nm-preset-preview">
    <CdlDiagramThumbnail client:load diagram={previewDiagram as never} hideHeader />
  </div>

  <footer class="nm-preset-card-foot">
    <div class="nm-preset-tags">
      {tags.map((t) => <span class="nm-preset-tag">{t}</span>)}
    </div>
    <a href={docHref} class="nm-preset-docs" aria-label={`${title} のドキュメントへ`}>
      <span>Docs</span>
      <span class="nm-preset-docs-arrow" aria-hidden="true">→</span>
    </a>
  </footer>
</article>

<style is:global>
  /*
   * PresetCard (CAR-N-8、 Dribbble Neumorphism raised + Vercel / Linear typography scale) ────
   * card = Neumorphism raised 2 段 shadow、 hover で translateY(-6px) + shadow deepen
   * preview area = subtle inset recess で「窓」 感、 SVG が奥に凹んだ印象
   * tags = compact pill、 mono uppercase 10.5px
   * Docs link = brand accent + arrow slide on hover (Vercel 風)
   */
  .nm-preset-card {
    display: flex;
    flex-direction: column;
    background: var(--nm-surface, #f0f3f7);
    border-radius: var(--nm-radius-card, 20px);
    padding: 28px 26px 22px;
    box-shadow: var(--nm-shadow-raised-soft);
    transition: var(--nm-transition-standard);
    position: relative;
    overflow: hidden;
  }
  .nm-preset-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--nm-shadow-hover);
  }

  .nm-preset-card-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
  }
  .nm-preset-eyebrow {
    font-family: var(--v4-mono, "JetBrains Mono", monospace);
    font-size: var(--nm-fs-eyebrow, 11px);
    letter-spacing: var(--nm-ls-eyebrow, 0.14em);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--v4-brand, #2d6a8f);
  }
  .nm-preset-title {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: var(--nm-fs-title, 17px);
    font-weight: 700;
    letter-spacing: var(--nm-ls-title, -0.01em);
    color: var(--v4-ink, #1a1f2a);
    line-height: 1.3;
    margin: 0;
  }
  .nm-preset-subtitle {
    font-family: var(--v4-sans, "Inter", sans-serif);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--v4-ink-dim, #5a6270);
    margin: 0;
  }

  /* preview area (Neumorphism inset recess で「凹み」 演出、 SVG が窓の奥に見える印象) */
  .nm-preset-preview {
    width: 100%;
    min-height: 240px;
    max-height: 400px;
    background: var(--nm-bg-base, #e8ecf1);
    border-radius: 14px;
    padding: 20px;
    box-shadow: var(--nm-shadow-inset-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .nm-preset-preview > button {
    width: 100%;
    height: 100%;
    max-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nm-preset-preview > button > div {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nm-preset-preview svg {
    width: 100% !important;
    height: auto !important;
    max-width: 100%;
    max-height: 360px;
    object-fit: contain;
    background: transparent !important;
  }

  .nm-preset-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
  }
  .nm-preset-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }
  .nm-preset-tag {
    padding: 3px 10px;
    font-family: var(--v4-mono, "JetBrains Mono", monospace);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    font-weight: 500;
    color: var(--v4-ink-dim, #5a6270);
    background: rgba(163, 177, 198, 0.15);
    border-radius: var(--nm-radius-pill, 999px);
  }
  .nm-preset-docs {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--v4-mono, "JetBrains Mono", monospace);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--v4-brand, #2d6a8f);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 8px;
    flex-shrink: 0;
    transition: color 0.15s, background 0.15s;
  }
  .nm-preset-docs:hover {
    color: var(--v4-brand-deep, #1f4d6e);
    background: rgba(45, 106, 143, 0.08);
  }
  .nm-preset-docs-arrow {
    transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nm-preset-docs:hover .nm-preset-docs-arrow {
    transform: translateX(4px);
  }

  html.dark .nm-preset-card {
    background: var(--nm-surface, #141a24);
  }
  html.dark .nm-preset-title {
    color: var(--v4-ink, #f0f3f8);
  }
  html.dark .nm-preset-subtitle {
    color: var(--v4-ink-dim, #99a3b3);
  }
  html.dark .nm-preset-eyebrow {
    color: var(--v4-brand, #5ec4e8);
  }
  html.dark .nm-preset-preview {
    background: var(--nm-bg-base, #0a0e14);
  }
  html.dark .nm-preset-tag {
    color: var(--v4-ink-dim, #99a3b3);
    background: rgba(94, 196, 232, 0.1);
  }
  html.dark .nm-preset-docs {
    color: var(--v4-brand, #5ec4e8);
  }
  html.dark .nm-preset-docs:hover {
    color: var(--v4-brand-glow, #7dc7e8);
    background: rgba(94, 196, 232, 0.12);
  }
</style>
