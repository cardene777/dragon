---
/**
 * Share dialog component — Twitter / LinkedIn / copy link で URL 共有。
 * Header の share ボタン (data-share-trigger) クリックで modal 表示、 client-side で起動。
 */
---

<div id="share-dialog" class="share-dialog-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="share-dialog-title">
  <div class="share-dialog">
    <button class="share-dialog-close" data-share-close aria-label="close">×</button>
    <h2 id="share-dialog-title" class="share-dialog-heading">この page を共有</h2>
    <div class="share-url-row">
      <input id="share-url" type="text" readonly class="share-url-input" />
      <button id="share-copy" class="share-copy-btn" type="button">copy</button>
    </div>
    <div class="share-buttons">
      <a id="share-twitter" target="_blank" rel="noopener noreferrer" class="share-btn share-btn-twitter">
        <span aria-hidden="true">𝕏</span> Post to X
      </a>
      <a id="share-linkedin" target="_blank" rel="noopener noreferrer" class="share-btn share-btn-linkedin">
        <span aria-hidden="true">in</span> LinkedIn
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const dialog = document.getElementById("share-dialog");
    if (!dialog) return;
    const urlInput = document.getElementById("share-url");
    const copyBtn = document.getElementById("share-copy");
    const tw = document.getElementById("share-twitter");
    const li = document.getElementById("share-linkedin");

    function open() {
      const url = window.location.href;
      const title = document.title;
      urlInput.value = url;
      tw.href = "https://twitter.com/intent/tweet?text=" + encodeURIComponent(title) + "&url=" + encodeURIComponent(url);
      li.href = "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(url);
      dialog.classList.remove("hidden");
    }
    function close() { dialog.classList.add("hidden"); }

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (target.closest("[data-share-trigger]")) {
        e.preventDefault();
        open();
      } else if (target.closest("[data-share-close]") || target === dialog) {
        close();
      }
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });

    copyBtn.addEventListener("click", () => {
      urlInput.select();
      try {
        navigator.clipboard.writeText(urlInput.value).then(() => {
          copyBtn.textContent = "copied!";
          setTimeout(() => { copyBtn.textContent = "copy"; }, 1500);
        });
      } catch (err) {
        document.execCommand("copy");
        copyBtn.textContent = "copied!";
        setTimeout(() => { copyBtn.textContent = "copy"; }, 1500);
      }
    });
  })();
</script>

<style is:global>
  .share-dialog-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(26, 31, 42, 0.7);
    display: grid;
    place-items: center;
    z-index: 1000;
  }
  .share-dialog-backdrop.hidden { display: none; }
  .share-dialog {
    background: var(--color-nm-surface, #f5ede2);
    border-radius: 16px;
    padding: 32px 28px 28px;
    width: min(440px, 92vw);
    box-shadow: 0 8px 32px rgba(0,0,0,0.25);
    position: relative;
  }
  .share-dialog-close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: 0;
    font-size: 24px;
    cursor: pointer;
    color: var(--color-nm-text, #1a1f2a);
  }
  .share-dialog-heading {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--color-nm-text, #1a1f2a);
  }
  .share-url-row {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .share-url-input {
    flex: 1;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid rgba(45,106,143,0.3);
    background: rgba(255,255,255,0.6);
    font-size: 13px;
    font-family: "JetBrains Mono", monospace;
    color: var(--color-nm-text, #1a1f2a);
  }
  .share-copy-btn {
    padding: 10px 16px;
    border-radius: 8px;
    background: #2d6a8f;
    color: #fff;
    border: 0;
    font-weight: 600;
    cursor: pointer;
  }
  .share-buttons {
    display: flex;
    gap: 8px;
  }
  .share-btn {
    flex: 1;
    padding: 12px 0;
    border-radius: 8px;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }
  .share-btn-twitter {
    background: #000;
    color: #fff;
  }
  .share-btn-linkedin {
    background: #0a66c2;
    color: #fff;
  }
</style>
