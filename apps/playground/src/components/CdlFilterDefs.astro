---
/**
 * Global SVG defs (CAR-N-7 / CAR-649 base、 CAR-N-8 で filter parameter 強化、
 * CAR-708 で 6 theme SVG defs に拡張) —
 * cdl SVG に `data-cdl-theme` + `data-cdl-role` 2 段 selector 経由で 6 theme の style を適用するための shared SVG defs。
 *
 * cdl scope が geometry only になった (CAR-643) 影響で、 dragon 側で自分の style
 * を SSOT 化する必要がある。 本 component を BaseLayout / DocsLayout の body 直下に
 * 1 度だけ mount する経路で全 page 共通の defs を提供する。 selector 経路は
 * apps/playground/src/styles/cdl-theme.css SSOT。
 *
 * defs 一覧 (theme 名 prefix):
 *   - Neumorphism: `dragon-nm-raised` / `dragon-nm-raised-sm` (+ *-dark) — CAR-748 Round 11 意図の dual shadow
 *                  `dragon-nm-raised-soft` / `dragon-nm-inset-soft` (+ *-dark) — legacy filter (backward compat)
 *   - Isometric:   `dragon-iso-cast-shadow` filter + `dragon-iso-top-gradient` / `dragon-iso-right-shadow-gradient` / `dragon-iso-left-shadow-gradient` linearGradient
 *   - Circuit:     `dragon-cir-trace-glow` filter + `dragon-cir-board-pattern` pattern (PCB green + solder pad gold)
 *   - Pinboard:    `dragon-pin-shadow` filter (Round 11 意図 subtle sticky shadow、 blur 1.4 offset 1/2 opacity 0.32) +
 *                  `dragon-pin-sticky-shadow` filter (legacy、 backward compat) +
 *                  `dragon-pin-board-pattern` pattern (kraft board)
 *   - Blueprint:   `dragon-bp-graticule` pattern (fine grid) + `dragon-bp-arrow-ortho` marker
 *   - Handdrawn:   `dragon-hd-wobble` turbulence displacement filter
 *
 * a11y = SVG は `aria-hidden` + 0 サイズ + pointer-events none で完全に不可視 + 支援技術 pass-through。
 */
---

<svg width="0" height="0" style="position:absolute; pointer-events:none" aria-hidden="true">
  <defs>
    {/* ═════════════════ Neumorphism (CAR-N-7 / CAR-N-8 / CAR-735 / CAR-748 SSOT、 raised + inset × light/dark) ═════════════════ */}
    {/*
      CAR-748 = Round 11 意図の dual shadow を厳密再現。 Circuit pattern 流用時の
      cdl-theme.css は `url(#dragon-nm-raised)` を参照するため、 新 filter を alias 追加する:
        - dragon-nm-raised    ... node-body 用の dual shadow (stdDeviation=3, offset ±4)
                                 opacity=0.55 (dark shadow) / 0.95 (light shadow) で
                                 Round 11 図の柔らかさ (soft bumps) を実現
        - dragon-nm-raised-sm ... edge-label pill 背景用の小型 dual shadow
                                 (stdDeviation=1.5, offset ±2、 濃度は same ratio)
      既存 dragon-nm-raised-soft / dragon-nm-inset-soft は他 spec の backward compat のため残す。
    */}
    <filter id="dragon-nm-raised" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feOffset in="blur" dx="4" dy="4" result="darkShadow" />
      <feFlood flood-color="rgba(163, 177, 198, 0.55)" result="darkColor" />
      <feComposite in="darkColor" in2="darkShadow" operator="in" result="darkShadowColored" />
      <feOffset in="blur" dx="-4" dy="-4" result="lightShadow" />
      <feFlood flood-color="rgba(255, 255, 255, 0.95)" result="lightColor" />
      <feComposite in="lightColor" in2="lightShadow" operator="in" result="lightShadowColored" />
      <feMerge>
        <feMergeNode in="darkShadowColored" />
        <feMergeNode in="lightShadowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="dragon-nm-raised-sm" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="1.5" result="blur" />
      <feOffset in="blur" dx="2" dy="2" result="darkShadow" />
      <feFlood flood-color="rgba(163, 177, 198, 0.55)" result="darkColor" />
      <feComposite in="darkColor" in2="darkShadow" operator="in" result="darkShadowColored" />
      <feOffset in="blur" dx="-2" dy="-2" result="lightShadow" />
      <feFlood flood-color="rgba(255, 255, 255, 0.95)" result="lightColor" />
      <feComposite in="lightColor" in2="lightShadow" operator="in" result="lightShadowColored" />
      <feMerge>
        <feMergeNode in="darkShadowColored" />
        <feMergeNode in="lightShadowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="dragon-nm-raised-dark" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feOffset in="blur" dx="4" dy="4" result="darkShadow" />
      <feFlood flood-color="rgba(0, 0, 0, 0.9)" result="darkColor" />
      <feComposite in="darkColor" in2="darkShadow" operator="in" result="darkShadowColored" />
      <feOffset in="blur" dx="-4" dy="-4" result="lightShadow" />
      <feFlood flood-color="rgba(255, 255, 255, 0.18)" result="lightColor" />
      <feComposite in="lightColor" in2="lightShadow" operator="in" result="lightShadowColored" />
      <feMerge>
        <feMergeNode in="darkShadowColored" />
        <feMergeNode in="lightShadowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="dragon-nm-raised-sm-dark" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="1.5" result="blur" />
      <feOffset in="blur" dx="2" dy="2" result="darkShadow" />
      <feFlood flood-color="rgba(0, 0, 0, 0.9)" result="darkColor" />
      <feComposite in="darkColor" in2="darkShadow" operator="in" result="darkShadowColored" />
      <feOffset in="blur" dx="-2" dy="-2" result="lightShadow" />
      <feFlood flood-color="rgba(255, 255, 255, 0.18)" result="lightColor" />
      <feComposite in="lightColor" in2="lightShadow" operator="in" result="lightShadowColored" />
      <feMerge>
        <feMergeNode in="darkShadowColored" />
        <feMergeNode in="lightShadowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    {/*
      Legacy filters (dragon-nm-raised-soft / dragon-nm-inset-soft) — CAR-735 で強化した既存 filter を
      backward compat のため残す。 CAR-748 以降の Neumorphism CSS は dragon-nm-raised / -sm を参照するが、
      car-735-theme-quality.spec.ts など既存 spec は dragon-nm-raised-soft を assert しているため、 削除しない。
    */}
    <filter id="dragon-nm-raised-soft" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="5" result="blur" />
      <feOffset in="blur" dx="6" dy="6" result="darkShadow" />
      <feFlood flood-color="rgba(163, 177, 198, 0.75)" result="darkColor" />
      <feComposite in="darkColor" in2="darkShadow" operator="in" result="darkShadowColored" />
      <feOffset in="blur" dx="-6" dy="-6" result="lightShadow" />
      <feFlood flood-color="rgba(255, 255, 255, 1.0)" result="lightColor" />
      <feComposite in="lightColor" in2="lightShadow" operator="in" result="lightShadowColored" />
      <feMerge>
        <feMergeNode in="darkShadowColored" />
        <feMergeNode in="lightShadowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="dragon-nm-inset-soft" x="-15%" y="-15%" width="130%" height="130%">
      <feGaussianBlur stdDeviation="1.2" />
      <feOffset dx="3" dy="3" result="offset-dark" />
      <feComposite in="SourceAlpha" in2="offset-dark" operator="out" result="composite-dark" />
      <feFlood flood-color="rgba(163, 177, 198, 0.5)" />
      <feComposite in2="composite-dark" operator="in" />
      <feComposite in="SourceGraphic" />
    </filter>

    <filter id="dragon-nm-raised-soft-dark" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="5" result="blur" />
      <feOffset in="blur" dx="6" dy="6" result="darkShadow" />
      <feFlood flood-color="rgba(0, 0, 0, 0.9)" result="darkColor" />
      <feComposite in="darkColor" in2="darkShadow" operator="in" result="darkShadowColored" />
      <feOffset in="blur" dx="-6" dy="-6" result="lightShadow" />
      <feFlood flood-color="rgba(255, 255, 255, 0.18)" result="lightColor" />
      <feComposite in="lightColor" in2="lightShadow" operator="in" result="lightShadowColored" />
      <feMerge>
        <feMergeNode in="darkShadowColored" />
        <feMergeNode in="lightShadowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="dragon-nm-inset-soft-dark" x="-15%" y="-15%" width="130%" height="130%">
      <feGaussianBlur stdDeviation="1.2" />
      <feOffset dx="3" dy="3" result="offset-dark" />
      <feComposite in="SourceAlpha" in2="offset-dark" operator="out" result="composite-dark" />
      <feFlood flood-color="rgba(0, 0, 0, 0.7)" />
      <feComposite in2="composite-dark" operator="in" />
      <feComposite in="SourceGraphic" />
    </filter>

    {/* ═════════════════ Isometric (CAR-781 = Round 11 意図まで到達、 Circuit pattern (CAR-741) 流用) ═════════════════ */}
    {/*
      CAR-781 = Round 11 意図の pseudo-3D (妥協案 = 完全 3D projection でなく 2D + gradient +
      strong drop shadow で立体感演出)。 top-light gradient を bone #f7f4e8 → tan #e0dbc4 に
      再定義し、 top face の柔らかい光の当たり方 (30° axonometric cube の top face 相当) を表現する。

      追加 filter:
        - dragon-iso-drop-shadow    ... node-body 用の rich drop shadow (blur 3 + offset 4/4 +
                                        opacity 0.25) で cast light の奥行き感を作る。
        - dragon-iso-drop-shadow-sm ... edge-label pill 用の subtle drop shadow (blur 1.5 +
                                        offset 2/2 + opacity 0.2)。
      backward compat のため既存 dragon-iso-cast-shadow / -dark、 dragon-iso-top-gradient-dark
      を残置 (他 spec の assertion 参照あり)。 但し dragon-iso-top-gradient は bone → tan に
      色調を変更するため既存 CAR-735 の url 参照 test は id 名一致で pass する。
    */}
    <linearGradient id="dragon-iso-top-gradient" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7f4e8" />
      <stop offset="1" stop-color="#e0dbc4" />
    </linearGradient>

    <linearGradient id="dragon-iso-top-gradient-dark" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4c5878" />
      <stop offset="0.35" stop-color="#2f3854" />
      <stop offset="1" stop-color="#151b30" />
    </linearGradient>

    <filter id="dragon-iso-drop-shadow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="3" />
      <feOffset dx="4" dy="4" result="offset" />
      <feFlood flood-color="rgba(44, 40, 32, 0.25)" />
      <feComposite in2="offset" operator="in" result="colored" />
      <feMerge>
        <feMergeNode in="colored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="dragon-iso-drop-shadow-sm" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="1.5" />
      <feOffset dx="2" dy="2" result="offset" />
      <feFlood flood-color="rgba(44, 40, 32, 0.2)" />
      <feComposite in2="offset" operator="in" result="colored" />
      <feMerge>
        <feMergeNode in="colored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    {/*
      Legacy dragon-iso-cast-shadow / -dark = CAR-735 で新規追加した cast shadow filter。
      cdl-6-theme-switch.spec.ts:169 が defs 存在 assertion を持つため、 backward compat の
      ため残置する。 Round 11 意図の Isometric CSS は dragon-iso-drop-shadow を参照するが、
      legacy filter def は削除しない。
    */}
    <filter id="dragon-iso-cast-shadow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="8" />
      <feOffset dx="10" dy="14" result="offset" />
      <feFlood flood-color="rgba(48, 62, 96, 0.55)" />
      <feComposite in2="offset" operator="in" />
      <feComposite in="SourceGraphic" />
    </filter>

    <filter id="dragon-iso-cast-shadow-dark" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="8" />
      <feOffset dx="10" dy="14" result="offset" />
      <feFlood flood-color="rgba(0, 0, 0, 0.75)" />
      <feComposite in2="offset" operator="in" />
      <feComposite in="SourceGraphic" />
    </filter>

    {/* ═════════════════ Circuit (PCB 基板 metaphor、 solder pad gold + trace mint + PCB green board) ═════════════════ */}
    <pattern id="dragon-cir-board-pattern" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
      <rect x="0" y="0" width="24" height="24" fill="#0a1a12" />
      <circle cx="4" cy="4" r="0.6" fill="#1a2f22" />
      <circle cx="20" cy="20" r="0.6" fill="#1a2f22" />
    </pattern>

    <filter id="dragon-cir-trace-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="glow" />
      <feFlood flood-color="rgba(72, 224, 176, 0.55)" />
      <feComposite in2="glow" operator="in" result="glowColored" />
      <feMerge>
        <feMergeNode in="glowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    {/* ═════════════════ Pinboard (掲示板 metaphor、 sticky note + kraft board) ═════════════════ */}
    <pattern id="dragon-pin-board-pattern" x="0" y="0" width="36" height="36" patternUnits="userSpaceOnUse">
      <rect x="0" y="0" width="36" height="36" fill="#c8a475" />
      <circle cx="12" cy="12" r="0.5" fill="rgba(90, 60, 30, 0.35)" />
      <circle cx="28" cy="24" r="0.5" fill="rgba(90, 60, 30, 0.35)" />
      <circle cx="20" cy="30" r="0.4" fill="rgba(90, 60, 30, 0.28)" />
    </pattern>

    <filter id="dragon-pin-sticky-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2.5" />
      <feOffset dx="3" dy="5" result="offset" />
      <feFlood flood-color="rgba(60, 40, 20, 0.4)" />
      <feComposite in2="offset" operator="in" />
      <feComposite in="SourceGraphic" />
    </filter>

    {/*
      CAR-Pinboard = Round 11 意図の subtle sticky shadow。
      blur=1.4 / offset=1,2 / opacity=0.32 で「シート紙が板に軽く貼られた」 印象を再現。
      dragon-pin-sticky-shadow (legacy blur 2.5 offset 3/5 opacity 0.4) は他 spec の
      backward compat のため残す。 Pinboard 新 CSS は本 filter を参照する。
    */}
    <filter id="dragon-pin-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.4" />
      <feOffset dx="1" dy="2" result="offset" />
      <feFlood flood-color="rgba(60, 40, 20, 0.32)" />
      <feComposite in2="offset" operator="in" />
      <feComposite in="SourceGraphic" />
    </filter>

    {/* ═════════════════ Blueprint (設計図 metaphor、 graticule pattern + ortho arrow marker) ═════════════════ */}
    <pattern id="dragon-bp-graticule" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M 24 0 L 0 0 0 24" fill="none" stroke="rgba(30, 66, 108, 0.14)" stroke-width="0.6" />
    </pattern>

    <pattern id="dragon-bp-graticule-dark" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M 24 0 L 0 0 0 24" fill="none" stroke="rgba(120, 180, 220, 0.18)" stroke-width="0.6" />
    </pattern>

    <marker id="dragon-bp-arrow-ortho" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="12" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 M 0 5 L 8 5" fill="none" stroke="#1e426c" stroke-width="1.2" />
    </marker>

    {/* ═════════════════ Handdrawn (手描き metaphor、 turbulence displacement + kraft palette、 CAR-735 強化) ═════════════════ */}
    {/*
      CAR-735 = wobble scale を 2.5 → 4.0 に増強、 baseFrequency も 0.02 → 0.025 で細かい波形に。
      Excalidraw / rough.js 相当の「シャープな手描き線」 に近づける。
    */}
    <filter id="dragon-hd-wobble" x="-15%" y="-15%" width="130%" height="130%">
      <feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="2" seed="7" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="4.0" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>
