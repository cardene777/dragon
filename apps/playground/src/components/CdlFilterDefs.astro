---
/**
 * Global SVG defs (CAR-N-7 / CAR-649 base、 CAR-N-8 で filter parameter 強化) —
 * cdl SVG に data-cdl-role selector 経由で Neumorphism raised / inset filter を適用するための shared filter 定義。
 *
 * cdl scope が geometry only になった (CAR-643) 影響で、 dragon 側で自分の Neumorphism
 * filter を SSOT 化する必要がある。 本 component を BaseLayout / DocsLayout の body 直下に
 * 1 度だけ mount する経路で全 page 共通の filter defs を提供する。 filter selector 経路は
 * apps/playground/src/styles/cdl-theme.css SSOT。
 *
 * filter 一覧 (light + dark 2 対応、 dragon-nm-*)
 *   - dragon-nm-raised-soft       ... light theme, raised (dual shadow dark + light)
 *   - dragon-nm-inset-soft        ... light theme, inset (subtle recess)
 *   - dragon-nm-raised-soft-dark  ... dark theme, raised (影を dark base に反転)
 *   - dragon-nm-inset-soft-dark   ... dark theme, inset (影を dark base に反転)
 *
 * CAR-N-8 数値変更方針 (Dribbble Neumorphism 相当まで強化) ...
 *   - stdDeviation 1.5 → 3.0 (blur を約 2 倍、 影の広がりを visible に)
 *   - offset dx/dy 2 → 4 (影の距離を拡張、 raised 感を明確化)
 *   - flood-color opacity 0.35 / 0.75 → 0.55 / 0.95 (影の濃さを明確に上げる)
 *   - filter region -20% -20% 140% 140% → -30% -30% 160% 160% (blur 拡大でクリッピング回避)
 *
 * design 数値は apps/playground/src/styles/neumorphism.css の
 *   --nm-shadow-raised-soft / --nm-shadow-inset-soft の CSS shadow を SVG filter で近似 (blur / offset / flood-color)。
 * light theme = 白い高光 + 淡青の落ち影、 dark theme = 白の弱高光 + 黒の濃い落ち影。
 *
 * a11y = SVG は `aria-hidden` + 0 サイズ + pointer-events none で完全に不可視 + 支援技術 pass-through。
 */
---

<svg width="0" height="0" style="position:absolute; pointer-events:none" aria-hidden="true">
  <defs>
    {/* ─── Light theme: raised (dual shadow — dark bottom-right + light top-left、 CAR-N-8 強化) ─── */}
    <filter id="dragon-nm-raised-soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feOffset in="blur" dx="4" dy="4" result="darkShadow" />
      <feFlood flood-color="rgba(163, 177, 198, 0.55)" result="darkColor" />
      <feComposite in="darkColor" in2="darkShadow" operator="in" result="darkShadowColored" />
      <feOffset in="blur" dx="-4" dy="-4" result="lightShadow" />
      <feFlood flood-color="rgba(255, 255, 255, 0.95)" result="lightColor" />
      <feComposite in="lightColor" in2="lightShadow" operator="in" result="lightShadowColored" />
      <feMerge>
        <feMergeNode in="darkShadowColored" />
        <feMergeNode in="lightShadowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    {/* ─── Light theme: inset (subtle recess for lane container、 CAR-N-8 強化) ─── */}
    <filter id="dragon-nm-inset-soft" x="-15%" y="-15%" width="130%" height="130%">
      <feGaussianBlur stdDeviation="1.2" />
      <feOffset dx="3" dy="3" result="offset-dark" />
      <feComposite in="SourceAlpha" in2="offset-dark" operator="out" result="composite-dark" />
      <feFlood flood-color="rgba(163, 177, 198, 0.5)" />
      <feComposite in2="composite-dark" operator="in" />
      <feComposite in="SourceGraphic" />
    </filter>

    {/* ─── Dark theme: raised (影の色を dark base に反転、 白の弱高光 + 黒の濃い落ち影、 CAR-N-8 強化) ─── */}
    <filter id="dragon-nm-raised-soft-dark" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feOffset in="blur" dx="4" dy="4" result="darkShadow" />
      <feFlood flood-color="rgba(0, 0, 0, 0.75)" result="darkColor" />
      <feComposite in="darkColor" in2="darkShadow" operator="in" result="darkShadowColored" />
      <feOffset in="blur" dx="-4" dy="-4" result="lightShadow" />
      <feFlood flood-color="rgba(255, 255, 255, 0.12)" result="lightColor" />
      <feComposite in="lightColor" in2="lightShadow" operator="in" result="lightShadowColored" />
      <feMerge>
        <feMergeNode in="darkShadowColored" />
        <feMergeNode in="lightShadowColored" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    {/* ─── Dark theme: inset (CAR-N-8 強化) ─── */}
    <filter id="dragon-nm-inset-soft-dark" x="-15%" y="-15%" width="130%" height="130%">
      <feGaussianBlur stdDeviation="1.2" />
      <feOffset dx="3" dy="3" result="offset-dark" />
      <feComposite in="SourceAlpha" in2="offset-dark" operator="out" result="composite-dark" />
      <feFlood flood-color="rgba(0, 0, 0, 0.7)" />
      <feComposite in2="composite-dark" operator="in" />
      <feComposite in="SourceGraphic" />
    </filter>
  </defs>
</svg>
