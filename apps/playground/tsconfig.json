{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "references": [
    { "path": "../../packages/dragon" }
  ],
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.mjs",
    "tests/**/*",
    "playwright.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": ["dist"]
}
