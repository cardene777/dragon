{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // dragon の型は源から引く。 package.json の `types` は束ねた `dist/index.d.ts` を
      // 指すが、 それは build 後にしか存在しない。 clean checkout で先に型検査すると
      // 解決できず `any` に落ちる (`skipLibCheck: true` が誤りを隠すので気付けない)。
      "@cardenelabs/dragon": ["../../packages/dragon/src/index.ts"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "tests", "playwright.config.ts"]
}
