{
  "name": "dragon-playground-spa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4323",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build && node scripts/copy-404.mjs",
    "preview": "vite preview --port 4323",
    "typecheck": "tsc --noEmit",
    "test:editor": "bash scripts/test-editor-dashboard.sh",
    "test:editor:l1": "vitest run src/lib/overlay-dsl.test.ts",
    "test:editor:l2": "vitest run src/lib/overlay-reducer.test.ts",
    "test:editor:l3": "playwright test tests/editor-flagship.spec.ts",
    "test:editor:l4": "playwright test tests/editor-visual.spec.ts",
    "test:editor:l4:update": "playwright test tests/editor-visual.spec.ts --update-snapshots",
    "deploy": "pnpm build:pages && gh-pages -d dist -b gh-pages -m 'chore(deploy): GitHub Pages'"
  },
  "dependencies": {
    "@cardenelabs/cdl": "link:../../../cdl/packages/cdl",
    "@cardenelabs/dragon": "workspace:*",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@uiw/react-codemirror": "^4.25.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
