{
  "name": "dragon-monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/dragon.git"
  },
  "scripts": {
    "dev": "pnpm --filter dragon-playground-spa run dev",
    "build": "pnpm run build:packages && pnpm --filter dragon-playground-spa run build",
    "build:pages": "pnpm run build:packages && pnpm --filter dragon-playground-spa run build:pages",
    "deploy:pages": "pnpm --filter dragon-playground-spa run deploy:pages",
    "build:packages": "pnpm --filter @cardenelabs/dragon run build",
    "preview": "pnpm --filter dragon-playground-spa run preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b && tsc -p tsconfig.config-files.json --noEmit",
    "test": "vitest run",
    "verify:deps": "node packages/dragon/scripts/verify-dep-integrity.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:sweep": "vitest run visual-validate-sweep",
    "test:playwright": "pnpm --filter dragon-playground-spa exec playwright test",
    "test:kind": "pnpm --filter dragon-playground-spa exec playwright test kind-geometry-check.spec",
    "test:kind:proof": "pnpm --filter dragon-playground-spa exec playwright test kind-geometry-check.proof",
    "check:cdl": "pnpm run test:playwright",
    "check:dragon": "pnpm run test:sweep",
    "check:kind": "pnpm run test:kind && pnpm run test:kind:proof",
    "check:all": "pnpm run typecheck && pnpm run check:cdl && pnpm run check:dragon && pnpm run check:kind",
    "lint:notation": "pnpm run build:packages && node packages/dragon/scripts/dragon-lint.mjs apps/playground-spa/src/topics/catalog/presets.cdl.ts apps/playground-spa/src/topics/catalog/text-dsl.cdl.ts apps/playground-spa/src/topics/catalog/patterns.cdl.ts apps/playground-spa/src/topics/catalog/styles.cdl.ts apps/playground-spa/src/topics/catalog/animation.cdl.ts apps/playground-spa/src/topics/catalog/charts.cdl.ts apps/playground-spa/src/topics/catalog/primitives.cdl.ts apps/playground-spa/src/topics/catalog/primitives-extra.cdl.ts apps/playground-spa/src/topics/catalog/cookbook.cdl.ts apps/playground-spa/src/topics/catalog/ethereum.cdl.ts apps/playground-spa/src/topics/catalog/parts.cdl.ts apps/playground-spa/src/topics/catalog/parts-in-box.cdl.ts apps/playground-spa/src/topics/catalog/parts-motion.cdl.ts apps/playground-spa/src/topics/catalog/interactive.cdl.ts",
    "lint:notation:proof": "pnpm run build:packages && node packages/dragon/scripts/lint-proof-fixture.mjs",
    "fix:notation": "pnpm run build:packages && node packages/dragon/scripts/dragon-lint.mjs --fix apps/playground-spa/src/topics/catalog/presets.cdl.ts",
    "verify": "pnpm run typecheck && pnpm run test",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.29.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.0",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.11",
    "zod": "^3.25.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "dompurify": "3.4.13",
      "qs": "6.15.2",
      "esbuild": "0.28.1",
      "@codemirror/state": "6.7.4",
      "@codemirror/view": "6.43.11"
    }
  }
}
