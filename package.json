{
  "name": "dragon-monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/dragon.git"
  },
  "scripts": {
    "dev": "pnpm --filter dragon-playground-spa dev",
    "build": "pnpm build:packages && pnpm --filter dragon-playground-spa build",
    "build:pages": "pnpm build:packages && pnpm --filter dragon-playground-spa build:pages",
    "deploy": "pnpm --filter dragon-playground-spa deploy",
    "build:packages": "pnpm --filter @cardenelabs/dragon build",
    "preview": "pnpm --filter dragon-playground-spa preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:sweep": "vitest run visual-validate-sweep",
    "test:playwright": "pnpm --filter dragon-playground-spa exec playwright test",
    "test:audit": "pnpm --filter dragon-playground-spa exec playwright test audit-3vp",
    "test:kind": "pnpm --filter dragon-playground-spa exec playwright test kind-geometry-check.spec",
    "test:kind:proof": "pnpm --filter dragon-playground-spa exec playwright test kind-geometry-check.proof",
    "check:cdl": "pnpm test:playwright",
    "check:dragon": "pnpm test:sweep",
    "check:kind": "pnpm test:kind && pnpm test:kind:proof",
    "check:all": "pnpm typecheck && pnpm check:cdl && pnpm check:dragon && pnpm check:kind",
    "lint:notation": "pnpm build:packages && node packages/dragon/scripts/dragon-lint.mjs apps/playground-spa/src/topics/catalog/presets.cdl.ts apps/playground-spa/src/topics/catalog/text-dsl.cdl.ts",
    "lint:notation:proof": "pnpm build:packages && node packages/dragon/scripts/lint-proof-fixture.mjs",
    "fix:notation": "pnpm build:packages && node packages/dragon/scripts/dragon-lint.mjs --fix apps/playground-spa/src/topics/catalog/presets.cdl.ts",
    "verify": "pnpm typecheck && pnpm test",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.9",
    "eslint": "^9.29.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.0",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.9",
    "zod": "^3.25.0"
  }
}
